---
// Shared icon set for the site — deliberately symbolic/generic (heart,
// leaf, shield, scale, document, megaphone, quote), never a depiction of
// a tobacco/nicotine product, per the PECA advertising-risk guard that
// governs all visual content on this site.
interface Props {
  name: 'heart' | 'leaf' | 'shield' | 'scale' | 'document' | 'megaphone' | 'quote' | 'chart';
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const paths: Record<string, string> = {
  heart: 'M12 21s-7-4.4-9.5-9C1 8.5 2.6 5 6 5c2 0 3.4 1.2 4 2.4C10.6 6.2 12 5 14 5c3.4 0 5 3.5 3.5 7-2.5 4.6-9.5 9-9.5 9z',
  leaf: 'M12 2c-1 3-5 4-5 9a5 5 0 0 0 10 0c0-5-4-6-5-9z',
  shield: 'M12 3l7 3v5c0 4.5-2.9 8.2-7 9-4.1-.8-7-4.5-7-9V6l7-3zM9 12l2 2 4-4',
  scale: 'M12 3v18M5 7l-3 6a3 3 0 0 0 6 0l-3-6zm14 0l-3 6a3 3 0 0 0 6 0l-3-6zM4 7h16M8 3h8',
  document: 'M6 2h9l5 5v15H6V2zM15 2v5h5M9 12h6M9 16h6',
  megaphone: 'M3 11v2a2 2 0 0 0 2 2h1l2 6h2l-1-6h2l8 4V5l-8 4H6a2 2 0 0 0-2 2z',
  quote: 'M7 8c-2 0-3.5 1.5-3.5 3.5S5 15 7 15c0 2-1.5 3.5-3.5 3.5v1.5c3 0 5.5-2.5 5.5-5.5V8H7zm10 0c-2 0-3.5 1.5-3.5 3.5s1.5 3.5 3.5 3.5c0 2-1.5 3.5-3.5 3.5v1.5c3 0 5.5-2.5 5.5-5.5V8h-2z',
  chart: 'M4 20V10m6 10V4m6 16v-7m6 7V8',
};
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
