---
import type { MonthBlock } from '../lib/news-digest';

interface Props {
  mblock: MonthBlock;
}
const { mblock } = Astro.props;

const topicLabel: Record<string, string> = {
  policy: 'Policy',
  litigation: 'Litigation',
  science: 'Science',
  industry: 'Commentary',
  other: 'Commentary',
};

const dayFmt = (d: Date) => d.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
const shortFmt = (d: Date) => d.toLocaleDateString('en-IN', { month: 'short', day: 'numeric' });
const monthFmt = (key: string) => new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-IN', { year: 'numeric', month: 'long' });
---
<section class={`top-block ${mblock.monthlySummary ? '' : 'top-block-open'}`}>
  {mblock.monthlySummary ? (
    <details class="month-toggle">
      <summary>
        <div class="summary-head">
          <h2>{monthFmt(mblock.month)}</h2>
          <span class="count-tag">{mblock.itemCount} {mblock.itemCount === 1 ? 'story' : 'stories'} this month</span>
        </div>
        <p class="digest-text monthly">{mblock.monthlySummary}</p>
      </summary>
      <div class="nested-block">
        {mblock.weeks.map((wblock) => {
          const dayCount = wblock.days.length;
          const itemCount = wblock.days.reduce((n, d) => n + d.items.length, 0);
          return wblock.weeklySummary ? (
            <details class="week-toggle">
              <summary>
                <div class="summary-head">
                  <h3>Week of {shortFmt(new Date(`${wblock.weekStart}T00:00:00Z`))} – {wblock.weekEnd ? shortFmt(wblock.weekEnd) : ''}</h3>
                  <span class="count-tag">{itemCount} {itemCount === 1 ? 'story' : 'stories'} · {dayCount} {dayCount === 1 ? 'day' : 'days'}</span>
                </div>
                <p class="digest-text weekly">{wblock.weeklySummary}</p>
              </summary>
              <div class="nested-block">
                {wblock.days.map((day) => (
                  <div class="day-group">
                    <div class="day-heading">
                      <h4>{dayFmt(day.date)}</h4>
                      <span class="count-tag">{day.items.length} {day.items.length === 1 ? 'story' : 'stories'}</span>
                    </div>
                    {day.digestText && <p class="digest-text">{day.digestText}</p>}
                    <details class="articles-toggle">
                      <summary>Show {day.items.length} {day.items.length === 1 ? 'article' : 'articles'}</summary>
                      <div class="news-grid">
                        {day.items.map((item) => (
                          <article class={`news-card topic-${item.data.topic}`}>
                            <div class="card-top">
                              <span class="topic-badge">{topicLabel[item.data.topic]}</span>
                            </div>
                            <h5><a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.title}</a></h5>
                            <p class="source">{item.data.sourceName}</p>
                            <p class="gist">{item.data.summary}</p>
                            <a class="read-link" href={item.data.sourceUrl} target="_blank" rel="noopener">Read the original →</a>
                          </article>
                        ))}
                      </div>
                    </details>
                  </div>
                ))}
              </div>
            </details>
          ) : (
            <div class="week-open">
              {wblock.days.map((day) => (
                <div class="day-group">
                  <div class="day-heading">
                    <h4>{dayFmt(day.date)}</h4>
                    <span class="count-tag">{day.items.length} {day.items.length === 1 ? 'story' : 'stories'}</span>
                  </div>
                  {day.digestText && <p class="digest-text">{day.digestText}</p>}
                  <details class="articles-toggle">
                    <summary>Show {day.items.length} {day.items.length === 1 ? 'article' : 'articles'}</summary>
                    <div class="news-grid">
                      {day.items.map((item) => (
                        <article class={`news-card topic-${item.data.topic}`}>
                          <div class="card-top">
                            <span class="topic-badge">{topicLabel[item.data.topic]}</span>
                          </div>
                          <h5><a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.title}</a></h5>
                          <p class="source">{item.data.sourceName}</p>
                          <p class="gist">{item.data.summary}</p>
                          <a class="read-link" href={item.data.sourceUrl} target="_blank" rel="noopener">Read the original →</a>
                        </article>
                      ))}
                    </div>
                  </details>
                </div>
              ))}
            </div>
          );
        })}
      </div>
    </details>
  ) : (
    <div class="top-block-open">
      {mblock.weeks.map((wblock) => {
        const dayCount = wblock.days.length;
        const itemCount = wblock.days.reduce((n, d) => n + d.items.length, 0);
        return wblock.weeklySummary ? (
          <details class="week-toggle">
            <summary>
              <div class="summary-head">
                <h3>Week of {shortFmt(new Date(`${wblock.weekStart}T00:00:00Z`))} – {wblock.weekEnd ? shortFmt(wblock.weekEnd) : ''}</h3>
                <span class="count-tag">{itemCount} {itemCount === 1 ? 'story' : 'stories'} · {dayCount} {dayCount === 1 ? 'day' : 'days'}</span>
              </div>
              <p class="digest-text weekly">{wblock.weeklySummary}</p>
            </summary>
            <div class="nested-block">
              {wblock.days.map((day) => (
                <div class="day-group">
                  <div class="day-heading">
                    <h4>{dayFmt(day.date)}</h4>
                    <span class="count-tag">{day.items.length} {day.items.length === 1 ? 'story' : 'stories'}</span>
                  </div>
                  {day.digestText && <p class="digest-text">{day.digestText}</p>}
                  <details class="articles-toggle">
                    <summary>Show {day.items.length} {day.items.length === 1 ? 'article' : 'articles'}</summary>
                    <div class="news-grid">
                      {day.items.map((item) => (
                        <article class={`news-card topic-${item.data.topic}`}>
                          <div class="card-top">
                            <span class="topic-badge">{topicLabel[item.data.topic]}</span>
                          </div>
                          <h5><a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.title}</a></h5>
                          <p class="source">{item.data.sourceName}</p>
                          <p class="gist">{item.data.summary}</p>
                          <a class="read-link" href={item.data.sourceUrl} target="_blank" rel="noopener">Read the original →</a>
                        </article>
                      ))}
                    </div>
                  </details>
                </div>
              ))}
            </div>
          </details>
        ) : (
          <div class="week-open">
            {wblock.days.map((day) => (
              <div class="day-group">
                <div class="day-heading">
                  <h4>{dayFmt(day.date)}</h4>
                  <span class="count-tag">{day.items.length} {day.items.length === 1 ? 'story' : 'stories'}</span>
                </div>
                {day.digestText && <p class="digest-text">{day.digestText}</p>}
                <details class="articles-toggle">
                  <summary>Show {day.items.length} {day.items.length === 1 ? 'article' : 'articles'}</summary>
                  <div class="news-grid">
                    {day.items.map((item) => (
                      <article class={`news-card topic-${item.data.topic}`}>
                        <div class="card-top">
                          <span class="topic-badge">{topicLabel[item.data.topic]}</span>
                        </div>
                        <h5><a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.title}</a></h5>
                        <p class="source">{item.data.sourceName}</p>
                        <p class="gist">{item.data.summary}</p>
                        <a class="read-link" href={item.data.sourceUrl} target="_blank" rel="noopener">Read the original →</a>
                      </article>
                    ))}
                  </div>
                </details>
              </div>
            ))}
          </div>
        );
      })}
    </div>
  )}
</section>

<style>
  .top-block { margin-bottom: 2rem; }
  .top-block:last-child { margin-bottom: 0; }
  .top-block-open { display: flex; flex-direction: column; gap: 2rem; }

  .month-toggle, .week-toggle {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  .month-toggle summary, .week-toggle summary {
    cursor: pointer;
    list-style: none;
    padding: 1.25rem 1.5rem;
    background: var(--paper-alt);
  }
  .month-toggle summary::-webkit-details-marker,
  .week-toggle summary::-webkit-details-marker { display: none; }
  .month-toggle summary::after,
  .week-toggle summary::after {
    content: "Show breakdown ▾";
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-dark);
  }
  .month-toggle[open] summary::after,
  .week-toggle[open] summary::after { content: "Hide breakdown ▴"; }

  .summary-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .summary-head h2 { margin: 0; font-size: 1.35rem; color: var(--accent-dark); }
  .summary-head h3 { margin: 0; font-size: 1.15rem; color: var(--accent-dark); }
  .count-tag { font-size: 0.78rem; color: var(--muted); font-weight: 600; white-space: nowrap; }

  .digest-text.monthly, .digest-text.weekly { margin: 0.6rem 0 0; font-weight: 500; background: none; border: none; padding: 0; }

  .nested-block { padding: 0.25rem 1.5rem 1.5rem; border-top: 1px solid var(--border); }
  .nested-block > .week-toggle,
  .nested-block > .week-open { margin-top: 1.25rem; }
  .nested-block .month-toggle, .nested-block .week-toggle { background: var(--paper-alt); }
  .nested-block .week-toggle summary { background: #fff; }

  .week-open { display: block; }

  .day-group { margin-top: 1.25rem; }
  .day-group:first-child { margin-top: 0; }
  .day-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .day-heading h4 { margin: 0; font-size: 1.05rem; color: var(--accent-dark); }
  .digest-text {
    background: var(--paper-alt);
    border-left: 3px solid var(--accent);
    padding: 0.9rem 1.25rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 1rem;
    border-radius: 0 6px 6px 0;
  }
  .nested-block .digest-text:not(.weekly):not(.monthly) { background: #fff; }

  .articles-toggle summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-dark);
    padding: 0.3rem 0;
  }
  .articles-toggle summary::-webkit-details-marker { display: none; }
  .articles-toggle summary::before { content: "▸ "; }
  .articles-toggle[open] summary::before { content: "▾ "; }
  .articles-toggle .news-grid { margin-top: 1rem; }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: 1.5rem;
  }
  .news-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.4rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 3px rgba(20,25,20,0.05);
  }
  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .topic-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
    color: #fff;
  }
  .topic-policy .topic-badge { background: var(--accent); }
  .topic-litigation .topic-badge { background: var(--rust); }
  .topic-science .topic-badge { background: var(--accent-dark); }
  .topic-industry .topic-badge,
  .topic-other .topic-badge { background: var(--muted); }

  .news-card h5 { margin: 0 0 0.3rem; font-size: 1.03rem; line-height: 1.35; }
  .news-card h5 a { color: var(--ink); text-decoration: none; }
  .news-card h5 a:hover { color: var(--accent); }
  .source { margin: 0 0 0.75rem; font-size: 0.82rem; color: var(--muted); font-weight: 600; }
  .gist { font-size: 0.88rem; color: var(--ink); line-height: 1.55; margin: 0 0 1rem; flex-grow: 1; }
  .read-link { font-size: 0.85rem; font-weight: 600; text-decoration: none; margin-top: auto; }
</style>
