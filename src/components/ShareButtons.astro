---
// Share buttons — docs/tasks/07-mobilisation.md item 5. Plain share URLs
// only, no third-party scripts/SDKs (no Facebook/X widget embeds, no
// AddThis-style tracker). WhatsApp/X/LinkedIn each just open that
// platform's own documented share-intent URL in a new tab; "Copy link"
// uses the Clipboard API with a manual-select fallback.
import SocialIcon from './SocialIcon.astro';

interface Props {
  /** Absolute URL to share. Defaults to the current page's canonical URL. */
  url?: string;
  /** Text to share alongside the link (WhatsApp/X only — LinkedIn and the
   * copy-link button use the URL alone). */
  title: string;
}
const { url, title } = Astro.props;
const shareUrl = url ?? new URL(Astro.url.pathname, Astro.site).toString();
const waHref = `https://wa.me/?text=${encodeURIComponent(`${title} ${shareUrl}`)}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareUrl)}`;
const liHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
---
<div class="share-buttons">
  <span class="share-label">Share</span>
  <a class="share-btn" href={waHref} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3z" />
      <path d="M8.3 9.8c.4 2.6 2.4 4.6 5 5" />
    </svg>
  </a>
  <a class="share-btn" href={xHref} target="_blank" rel="noopener" aria-label="Share on X">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 4l16 16M20 4L4 20" />
    </svg>
  </a>
  <a class="share-btn" href={liHref} target="_blank" rel="noopener" aria-label="Share on LinkedIn">
    <SocialIcon name="linkedin" />
  </a>
  <button type="button" class="share-btn share-copy" data-copy-url={shareUrl} aria-label="Copy link">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 12a4 4 0 0 0 5.7 0l2.6-2.6a4 4 0 0 0-5.7-5.7L10 5.3" />
      <path d="M15 12a4 4 0 0 0-5.7 0l-2.6 2.6a4 4 0 0 0 5.7 5.7L14 18.7" />
    </svg>
  </button>
  <span class="share-copied" data-copy-feedback hidden>Copied!</span>

  <style>
    .share-buttons { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .share-label { font-size: 0.82rem; font-weight: 600; color: var(--muted); margin-right: 0.15rem; }
    .share-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.1rem;
      height: 2.1rem;
      border-radius: 50%;
      background: var(--paper-alt);
      color: var(--accent-dark);
      border: none;
      cursor: pointer;
      transition: background-color 0.15s ease, transform 0.15s ease;
    }
    .share-btn:hover { background: var(--accent); color: #fff; transform: translateY(-1px); }
    .share-btn svg { width: 1.05rem; height: 1.05rem; }
    .share-btn :global(svg) { width: 1.05rem; height: 1.05rem; }
    .share-copied {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent-dark);
      transition: opacity 0.2s ease;
    }
  </style>
</div>

<script>
  function bindShareCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((btn) => {
      if (btn.dataset.copyBound === '1') return;
      btn.dataset.copyBound = '1';
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-copy-url') || '';
        const feedback = btn.parentElement?.querySelector<HTMLElement>('[data-copy-feedback]');
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(url);
          } else {
            const tmp = document.createElement('textarea');
            tmp.value = url;
            tmp.style.position = 'fixed';
            tmp.style.left = '-9999px';
            document.body.appendChild(tmp);
            tmp.select();
            document.execCommand('copy');
            document.body.removeChild(tmp);
          }
          if (feedback) {
            feedback.hidden = false;
            setTimeout(() => { feedback.hidden = true; }, 2000);
          }
        } catch {
          // Clipboard access denied/unsupported — nothing destructive to
          // fall back to beyond leaving the link selectable in the address
          // bar already, so just fail silently.
        }
      });
    });
  }
  bindShareCopyButtons();
</script>
