---
import SocialIcon from '../components/SocialIcon.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description = "Tobacco harm reduction advocacy and evidence for India.", wide = false } = Astro.props;

// Which nav group (if any) the current page belongs to, so the whole
// dropdown stays visibly "on" no matter which of its sub-links you're
// actually reading — the tab reads as one unit, not a set of unrelated
// destinations you've wandered away from.
// Normalize away a trailing slash — Astro bakes a trailing-slash pathname
// into some static routes but not others, which broke exact-match checks
// below for e.g. /india/rti-replies vs /india/rti-replies/.
const rawPath = Astro.url.pathname;
const path = rawPath.length > 1 ? rawPath.replace(/\/$/, '') : rawPath;
function activeGroup(p: string): 'start' | 'evidence' | 'advocacy' | 'updates' | null {
  if (p === '/quit' || p === '/policy') return 'start';
  if (p.startsWith('/litigation') || p.startsWith('/science') || p === '/india' || p === '/india/law' || p === '/india/rti-replies') return 'evidence';
  if (p.startsWith('/campaigns') || p === '/india/submissions' || p.startsWith('/press')) return 'advocacy';
  if (p.startsWith('/news') || p.startsWith('/media')) return 'updates';
  return null;
}
const group = activeGroup(path);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · AVI — Association of Vapers India</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --ink: #1a211d;
      --paper: #faf6ec;
      --paper-alt: #f2ead9;
      --accent: #1f6f5c;
      --accent-dark: #123c31;
      --accent-light: #2f8a72;
      --gold: #a97327;
      --gold-dark: #7d5419;
      --gold-light: #d8a94a;
      --rust: #b3552e;
      --rust-dark: #7d3a1f;
      --ink-black: #12130f;
      --muted: #5c6660;
      --border: #e2dcc7;
      --max-w: 42rem;
      --max-w-wide: 72rem;
      --font-serif: 'Fraunces', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    html { overflow-x: hidden; }
    body {
      margin: 0;
      overflow-x: hidden;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-sans);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4 {
      font-family: var(--font-serif);
      line-height: 1.2;
      font-weight: 500;
      letter-spacing: -0.01em;
    }
    a { color: var(--accent); }
    a:hover { color: var(--accent-dark); }

    /* Escapes the constrained <main> width for full-bleed sections. */
    .breakout {
      width: 100vw;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
    }
    .breakout > .breakout-inner {
      max-width: var(--max-w-wide);
      margin: 0 auto;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    header.site {
      border-bottom: 1px solid var(--border);
      padding: 1.1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    header.site .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--font-serif);
      font-weight: 600;
      font-size: 1.05rem;
      line-height: 1.15;
      text-decoration: none;
      color: var(--ink);
      letter-spacing: -0.01em;
      max-width: 12rem;
    }
    header.site .brand img { height: 38px; width: auto; flex-shrink: 0; }
    @media (min-width: 640px) {
      header.site .brand { font-size: 1.2rem; max-width: none; }
    }
    nav.site a {
      color: var(--muted);
      text-decoration: none;
      margin-left: 1.25rem;
      font-size: 0.92rem;
      font-weight: 500;
    }
    nav.site a:hover { color: var(--ink); }
    nav.site > a.active {
      color: var(--ink);
      font-weight: 700;
      border-bottom: 2px solid var(--gold);
    }

    .nav-dropdown { position: relative; display: inline-block; }
    .nav-dropdown summary {
      color: var(--muted);
      margin-left: 1.25rem;
      font-size: 0.92rem;
      font-weight: 500;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }
    .nav-dropdown summary::-webkit-details-marker { display: none; }
    .nav-dropdown summary::after { content: ' ▾'; font-size: 0.7em; }
    .nav-dropdown summary:hover { color: var(--ink); }
    .nav-dropdown[open] summary { color: var(--ink); }
    /* The whole dropdown reads as "on" while you're anywhere among its
       sub-links, not just while it happens to be open — the tab is one
       unit, so it should look like one whether you arrived via India,
       Litigation or Science. */
    .nav-dropdown.active summary {
      color: var(--ink);
      font-weight: 700;
      border-bottom: 2px solid var(--gold);
    }
    .dropdown-menu a.active {
      background: var(--paper-alt);
      color: var(--ink);
      font-weight: 600;
      border-left: 3px solid var(--gold);
      padding-left: calc(0.6rem - 3px);
    }
    .dropdown-menu {
      position: absolute;
      top: calc(100% + 0.75rem);
      left: 1.25rem;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 6px;
      box-shadow: 0 6px 16px rgba(20,25,20,0.12);
      padding: 0.5rem;
      min-width: 13rem;
      display: flex;
      flex-direction: column;
      z-index: 30;
    }
    .dropdown-menu a {
      margin-left: 0;
      padding: 0.5rem 0.6rem;
      border-radius: 4px;
      white-space: nowrap;
    }
    .dropdown-menu a:hover { background: var(--paper-alt); color: var(--ink); }

    main {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }
    main.wide { max-width: none; padding: 0 0 4rem; }
    main.wide > :not(.breakout) {
      max-width: var(--max-w);
      margin-left: auto;
      margin-right: auto;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .btn {
      display: inline-block;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      padding: 0.7rem 1.4rem;
      border-radius: 3px;
      border: 1px solid transparent;
    }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-primary:hover { background: var(--accent-dark); color: #fff; }
    .btn-gold { background: var(--gold); color: #fff; }
    .btn-gold:hover { background: var(--gold-dark); color: #fff; }
    .btn-outline { background: transparent; color: var(--ink); border-color: var(--border); }
    .btn-outline:hover { border-color: var(--ink); color: var(--ink); }

    footer.site {
      border-top: 1px solid var(--border);
      padding: 2.5rem 1.5rem 2rem;
      color: var(--muted);
      font-size: 0.88rem;
      text-align: center;
    }
    .footer-top {
      max-width: var(--max-w-wide, 72rem);
      margin: 0 auto 2rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 2.5rem;
      text-align: left;
    }
    .footer-brand { max-width: 18rem; flex-shrink: 0; }
    .footer-tagline { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
    .footer-links {
      display: grid;
      grid-template-columns: repeat(4, minmax(9rem, 1fr));
      gap: 2rem;
      flex: 1;
      justify-content: flex-end;
    }
    .footer-col { display: flex; flex-direction: column; gap: 0.55rem; min-width: 0; }
    .footer-col h3 {
      margin: 0 0 0.15rem;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--gold-dark);
    }
    .footer-col a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.86rem;
    }
    .footer-col a:hover { color: var(--ink); text-decoration: underline; }
    @media (max-width: 640px) {
      .footer-top { flex-direction: column; gap: 2rem; }
      .footer-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    footer.site img.mark { height: 56px; opacity: 0.85; margin-bottom: 1rem; }
    footer.site .social {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.9rem;
      margin-bottom: 1.25rem;
    }
    footer.site .social a {
      color: #fff;
      background: var(--accent-dark);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 50%;
      transition: background-color 0.15s ease, transform 0.15s ease;
    }
    footer.site .social a:hover {
      background: var(--gold);
      transform: translateY(-2px);
    }
    footer.site .social svg { width: 1.35rem; height: 1.35rem; }
  </style>
</head>
<body>
  <header class="site">
    <a class="brand" href="/">
      <img src="/images/avi-logo.png" alt="Association of Vapers India" />
      <span>Association of Vapers India</span>
    </a>
    <nav class="site">
      <a href="/about" class:list={{ active: path === '/about' }}>About</a>
      <details class="nav-dropdown" class:list={{ active: group === 'start' }}>
        <summary>Get Started</summary>
        <div class="dropdown-menu">
          <a href="/quit" class:list={{ active: path === '/quit' }}>If You Smoke</a>
          <a href="/policy" class:list={{ active: path === '/policy' }}>For Policymakers</a>
        </div>
      </details>
      <details class="nav-dropdown" class:list={{ active: group === 'evidence' }}>
        <summary>The Evidence</summary>
        <div class="dropdown-menu">
          <a href="/science" class:list={{ active: path.startsWith('/science') }}>Science</a>
          <a href="/india" class:list={{ active: path === '/india' || path === '/india/law' }}>India</a>
          <a href="/india/rti-replies" class:list={{ active: path === '/india/rti-replies' }}>RTI Replies</a>
          <a href="/litigation" class:list={{ active: path.startsWith('/litigation') }}>Litigation</a>
        </div>
      </details>
      <details class="nav-dropdown" class:list={{ active: group === 'advocacy' }}>
        <summary>Our Advocacy</summary>
        <div class="dropdown-menu">
          <a href="/campaigns" class:list={{ active: path.startsWith('/campaigns') }}>Campaigns</a>
          <a href="/india/submissions" class:list={{ active: path === '/india/submissions' }}>Submissions to Policymakers</a>
          <a href="/press" class:list={{ active: path.startsWith('/press') }}>Press</a>
        </div>
      </details>
      <details class="nav-dropdown" class:list={{ active: group === 'updates' }}>
        <summary>Updates</summary>
        <div class="dropdown-menu">
          <a href="/news" class:list={{ active: path.startsWith('/news') }}>News</a>
          <a href="/media" class:list={{ active: path.startsWith('/media') }}>Media</a>
        </div>
      </details>
      <a href="/testimonials" class:list={{ active: path === '/testimonials' }}>Testimonials</a>
      <a href="/contribute" class:list={{ active: path === '/contribute' }}>Contribute</a>
    </nav>
  </header>
  <script>
    // Native <details> doesn't close on outside click or when a sibling
    // opens — both expected behaviours for a nav dropdown menu.
    const navDropdowns = document.querySelectorAll('nav.site .nav-dropdown');
    navDropdowns.forEach((d) => {
      d.addEventListener('toggle', () => {
        if (d.open) {
          navDropdowns.forEach((other) => { if (other !== d) other.open = false; });
        }
      });
    });
    document.addEventListener('click', (e) => {
      navDropdowns.forEach((d) => {
        if (d.open && !d.contains(e.target)) d.open = false;
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') navDropdowns.forEach((d) => { d.open = false; });
    });
  </script>
  <main class={wide ? 'wide' : ''}>
    <slot />
  </main>
  <footer class="site">
    <div class="footer-top">
      <div class="footer-brand">
        <img class="mark" src="/images/avi-logo.png" alt="Association of Vapers India — Est. 2016" />
        <p class="footer-tagline">Tobacco harm reduction advocacy for India, since 2016.</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <div class="footer-col">
          <h3>Get Started</h3>
          <a href="/quit">If You Smoke</a>
          <a href="/policy">For Policymakers</a>
        </div>
        <div class="footer-col">
          <h3>The Evidence</h3>
          <a href="/science">Science</a>
          <a href="/india">India</a>
          <a href="/india/rti-replies">RTI Replies</a>
          <a href="/litigation">Litigation</a>
        </div>
        <div class="footer-col">
          <h3>Our Advocacy</h3>
          <a href="/campaigns">Campaigns</a>
          <a href="/india/submissions">Submissions to Policymakers</a>
          <a href="/press">Press</a>
        </div>
        <div class="footer-col">
          <h3>More</h3>
          <a href="/news">News</a>
          <a href="/media">Media</a>
          <a href="/testimonials">Testimonials</a>
          <a href="/about">About</a>
          <a href="/contribute">Contribute</a>
        </div>
      </nav>
    </div>
    <div class="social">
      <a href="https://x.com/vapeindia" target="_blank" rel="noopener" aria-label="AVI on X" title="X"><SocialIcon name="x" /></a>
      <a href="https://facebook.com/avindia" target="_blank" rel="noopener" aria-label="AVI on Facebook" title="Facebook"><SocialIcon name="facebook" /></a>
      <a href="https://instagram.com/avi_vapeindia" target="_blank" rel="noopener" aria-label="AVI on Instagram" title="Instagram"><SocialIcon name="instagram" /></a>
      <a href="https://www.youtube.com/@vapeindia" target="_blank" rel="noopener" aria-label="AVI on YouTube" title="YouTube"><SocialIcon name="youtube" /></a>
      <a href="https://www.linkedin.com/showcase/vapeindia" target="_blank" rel="noopener" aria-label="AVI on LinkedIn" title="LinkedIn"><SocialIcon name="linkedin" /></a>
    </div>
    <p>© {new Date().getFullYear()} Association of Vapers India · contact@vapeindia.org</p>
  </footer>
</body>
</html>
