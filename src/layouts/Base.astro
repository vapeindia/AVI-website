---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Tobacco harm reduction advocacy and evidence for India." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · AVI — Association of Vapers India</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    :root {
      --ink: #14181b;
      --paper: #fdfcf9;
      --accent: #1f6f5c;
      --muted: #5b6266;
      --border: #e4e1d8;
      --max-w: 42rem;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, serif;
      line-height: 1.6;
    }
    a { color: var(--accent); }
    header.site {
      border-bottom: 1px solid var(--border);
      padding: 1.25rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    header.site .brand { font-weight: 700; text-decoration: none; color: var(--ink); font-size: 1.1rem; }
    nav.site a {
      color: var(--muted);
      text-decoration: none;
      margin-left: 1.25rem;
      font-size: 0.95rem;
    }
    nav.site a:hover { color: var(--ink); }
    main {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }
    footer.site {
      border-top: 1px solid var(--border);
      padding: 2rem 1.5rem;
      color: var(--muted);
      font-size: 0.9rem;
      text-align: center;
    }
    footer.site .social a { margin: 0 0.5rem; }
  </style>
</head>
<body>
  <header class="site">
    <a class="brand" href="/">AVI</a>
    <nav class="site">
      <a href="/about">About</a>
      <a href="/science">Science</a>
      <a href="/india">India</a>
      <a href="/litigation">Litigation</a>
      <a href="/news">News</a>
      <a href="/blog">Blog</a>
      <a href="/press">Press</a>
      <a href="/testimonials">Testimonials</a>
      <a href="/contribute">Contribute</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site">
    <div class="social">
      <a href="https://x.com/vapeindia">X</a>·
      <a href="https://facebook.com/avindia">Facebook</a>·
      <a href="https://instagram.com/avi_vapeindia">Instagram</a>·
      <a href="https://youtube.com/vapeindia">YouTube</a>·
      <a href="https://linkedin.com">LinkedIn</a>
    </div>
    <p>© {new Date().getFullYear()} Association of Vapers India · contact@vapeindia.org</p>
  </footer>
</body>
</html>
