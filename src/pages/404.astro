---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base
  title="Page not found"
  description="This page doesn't exist on vapeindia.org — search the site or jump to a main section."
  noindex={true}
>
  <section class="breakout notfound-hero">
    <div class="breakout-inner">
      <p class="eyebrow">404</p>
      <h1>That page doesn't exist</h1>
      <p class="notfound-sub">
        The link that brought you here is broken, or the page moved. Try a
        search, jump to one of the sections below, or let us know what you
        were looking for.
      </p>
      <div class="search-box">
        <Icon name="search" />
        <input
          type="search"
          id="search-input"
          placeholder="Try “Karnataka”, “nicotine pouches”, “FDA”…"
          autocomplete="off"
        />
      </div>
    </div>
  </section>

  <div class="notfound-body">
    <p id="search-status" role="status">Start typing to search.</p>
    <div id="search-results" class="results-list"></div>

    <div class="section-links">
      <p class="section-links-label">Or go straight to a section:</p>
      <nav class="section-grid" aria-label="Main sections">
        <a href="/">Home</a>
        <a href="/india/law/">Is vaping banned in India?</a>
        <a href="/quit/">If you smoke</a>
        <a href="/policy/">For policymakers</a>
        <a href="/science/">Evidence library</a>
        <a href="/litigation/">Litigation</a>
        <a href="/press/">Press</a>
        <a href="/news/">Daily news</a>
        <a href="/about/">About AVI</a>
        <a href="/faq/">FAQ</a>
        <a href="/report-harassment/">Report police harassment</a>
        <a href="/contribute/">Contribute</a>
      </nav>
    </div>

    <p class="report-line">
      Followed a link to get here from somewhere else — a search result, a
      press mention, a bookmark? <a href="mailto:contact@vapeindia.org?subject=Broken%20link%20on%20vapeindia.org">Tell us at contact@vapeindia.org</a> so we can fix it.
    </p>
  </div>

  <script>
    interface SearchItem {
      title: string;
      url: string;
      type: string;
      date: string;
      snippet: string;
    }

    const input = document.getElementById('search-input') as HTMLInputElement;
    const status = document.getElementById('search-status')!;
    const results = document.getElementById('search-results')!;

    let items: SearchItem[] = [];
    let loaded = false;

    async function loadIndex() {
      try {
        const res = await fetch('/search-index.json');
        items = await res.json();
      } catch {
        items = [];
      }
      loaded = true;
    }

    function escapeHtml(s: string) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    }

    function render(query: string) {
      if (!loaded) {
        status.textContent = 'Loading search index…';
        results.innerHTML = '';
        return;
      }
      const q = query.trim().toLowerCase();
      if (!q) {
        status.textContent = 'Start typing to search.';
        results.innerHTML = '';
        return;
      }
      const terms = q.split(/\s+/).filter(Boolean);
      const matches = items.filter((item) => {
        const haystack = `${item.title} ${item.snippet} ${item.type}`.toLowerCase();
        return terms.every((t) => haystack.includes(t));
      });
      matches.sort((a, b) => {
        if (!a.date && !b.date) return 0;
        if (!a.date) return 1;
        if (!b.date) return -1;
        return b.date.localeCompare(a.date);
      });

      if (matches.length === 0) {
        status.textContent = `No results for "${query}".`;
        results.innerHTML = '';
        return;
      }
      const shown = matches.slice(0, 20);
      status.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'}${matches.length > shown.length ? ` (showing first ${shown.length})` : ''} for "${query}".`;
      results.innerHTML = shown.map((item) => {
        const external = /^https?:\/\//.test(item.url);
        return `<a class="result-card" href="${escapeHtml(item.url)}"${external ? ' target="_blank" rel="noopener"' : ''}>
          <span class="result-type">${escapeHtml(item.type)}</span>
          <h2>${escapeHtml(item.title)}</h2>
        </a>`;
      }).join('');
    }

    let debounceTimer: ReturnType<typeof setTimeout>;
    input?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => render(input.value), 120);
    });

    loadIndex().then(() => render(input?.value ?? ''));
    input?.focus();
  </script>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--paper);
      margin: 0 0 0.75rem;
    }
    .notfound-hero {
      background: var(--green-deep);
      color: #f4f1e6;
      padding: 3.5rem 0 3rem;
    }
    .notfound-hero h1 { color: #fff; margin: 0 0 0.9rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .notfound-sub { color: #cdd6cf; max-width: 42rem; font-size: 1.02rem; margin: 0 0 2rem; }

    .search-box {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #fff;
      border-radius: 8px;
      padding: 0.85rem 1.1rem;
      max-width: 34rem;
    }
    .search-box :global(svg) { width: 1.3rem; height: 1.3rem; color: var(--muted); flex-shrink: 0; }
    .search-box input {
      border: none;
      outline: none;
      font: inherit;
      font-size: 1.02rem;
      width: 100%;
      color: var(--ink);
      background: transparent;
    }

    .notfound-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
    #search-status { color: var(--muted); font-size: 0.92rem; margin: 0 0 1.5rem; }

    .results-list { display: grid; gap: 0.75rem; margin-bottom: 2.5rem; }
    .result-card {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.85rem 1.2rem;
      text-decoration: none;
      color: inherit;
      box-shadow: 0 1px 3px rgba(20,25,20,0.05);
    }
    .result-card:hover { border-color: var(--green-deep); }
    .result-type {
      flex-shrink: 0;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.15rem 0.5rem;
      border-radius: 99px;
      color: #fff;
      background: var(--green);
    }
    .result-card h2 { margin: 0; font-size: 0.95rem; line-height: 1.35; color: var(--ink); }

    .section-links { padding-top: 1.5rem; border-top: 1px solid var(--line); }
    .section-links-label { font-weight: 600; font-size: 0.9rem; margin: 0 0 1rem; }
    .section-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(13rem, 100%), 1fr));
      gap: 0.6rem;
    }
    .section-grid a {
      display: block;
      background: var(--paper-2);
      border-radius: 6px;
      padding: 0.7rem 1rem;
      text-decoration: none;
      color: var(--green-deep);
      font-weight: 600;
      font-size: 0.9rem;
    }
    .section-grid a:hover { background: var(--paper); color: var(--ink); }

    .report-line { margin-top: 2rem; font-size: 0.88rem; color: var(--muted); }
  </style>
</Base>
