---
// Ten years of AVI, 2016-2026 — docs/tasks/08-homepage.md item 5.
// "Don't invent milestones; list gaps for me" — every row here comes
// straight from a dated field already in an existing content collection
// (litigation.filedDate, submissions.date, campaigns.dateStart, press.date).
// Nothing on this page is hand-typed copy; it's compiled from the same
// files src/pages/litigation, /submissions, /campaigns and /press already
// render. An unreviewed press draft (reviewed: false) is excluded, same
// gate as everywhere else on the site.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const START_YEAR = 2016;
const END_YEAR = 2026;

interface Row {
  date: Date;
  title: string;
  href: string;
  kind: 'litigation' | 'submission' | 'campaign' | 'press';
  kindLabel: string;
}

const litigation = await getCollection('litigation');
const submissions = await getCollection('submissions');
const campaigns = await getCollection('campaigns');
const press = await getCollection('press', ({ data }) => data.reviewed);

function pressKindLabel(type: string): string {
  if (type === 'press-release' || type === 'quote') return 'AVI statement';
  if (type === 'op-ed') return 'Op-ed';
  if (type === 'interview') return 'Interview';
  return 'Media coverage';
}

const rows: Row[] = [
  ...litigation
    .filter((i) => i.data.filedDate)
    .map((i) => ({
      date: i.data.filedDate as Date,
      title: i.data.title,
      href: `/litigation/${i.id}/`,
      kind: 'litigation' as const,
      kindLabel: 'Litigation',
    })),
  ...submissions.map((i) => ({
    date: i.data.date,
    title: i.data.title,
    href: `/submissions/${i.id}/`,
    kind: 'submission' as const,
    kindLabel: 'Submission',
  })),
  ...campaigns.map((i) => ({
    date: i.data.dateStart,
    title: i.data.title,
    href: `/campaigns/#${i.id}`,
    kind: 'campaign' as const,
    kindLabel: 'Campaign',
  })),
  ...press.map((i) => ({
    date: i.data.date,
    title: i.data.title,
    href: `/press/${i.id}/`,
    kind: 'press' as const,
    kindLabel: pressKindLabel(i.data.type),
  })),
].sort((a, b) => a.date.valueOf() - b.date.valueOf());

const years = Array.from({ length: END_YEAR - START_YEAR + 1 }, (_, i) => START_YEAR + i);
const byYear = new Map<number, Row[]>();
for (const row of rows) {
  const y = row.date.getUTCFullYear();
  if (y < START_YEAR || y > END_YEAR) continue;
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(row);
}

const VISIBLE_PER_YEAR = 5;

function monthLabel(d: Date): string {
  // A handful of archive entries only have a year on record (no reliable
  // month/day), stored as Jan 1 of that year — showing "Jan" for those
  // would invent precision the source doesn't have, so show the year only.
  if (d.getUTCMonth() === 0 && d.getUTCDate() === 1) return String(d.getUTCFullYear());
  return d.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' });
}
---
<Base title="Ten Years of AVI: 2016–2026 Timeline" description="AVI's decade, year by year — every dated litigation filing, policy submission, campaign and statement in one chronological record." wide={true}>
  <section class="breakout tl-hero">
    <div class="breakout-inner">
      <p class="eyebrow">AVI's public record, 2016–2026</p>
      <h1>Ten years of AVI</h1>
      <p class="tl-sub">
        Every entry below has a real date attached to it in AVI's own site
        data — a court filing, a submission to a policymaker, a campaign, or
        a press statement or press mention. Compiled directly from the{' '}
        <a href="/litigation/">litigation</a>, <a href="/submissions/">submissions</a>,{' '}
        <a href="/campaigns/">campaigns</a> and <a href="/press/">press</a>{' '}
        records elsewhere on this site — nothing here is a new claim.
      </p>
    </div>
  </section>

  <div class="tl-years">
    {years.map((year) => {
      const items = (byYear.get(year) || []).slice().sort((a, b) => a.date.valueOf() - b.date.valueOf());
      const visible = items.slice(0, VISIBLE_PER_YEAR);
      const rest = items.slice(VISIBLE_PER_YEAR);
      return (
        <section class="tl-year">
          <h2>{year}</h2>
          {items.length === 0 ? (
            <p class="tl-empty">No dated public-record entry for {year} yet.</p>
          ) : (
            <>
              <ul class="tl-list">
                {visible.map((row) => (
                  <li>
                    <span class={`tl-badge tl-badge-${row.kind}`}>{row.kindLabel}</span>
                    <a href={row.href}>{row.title}</a>
                    <time datetime={row.date.toISOString()}>{monthLabel(row.date)}</time>
                  </li>
                ))}
              </ul>
              {rest.length > 0 && (
                <details class="tl-more">
                  <summary>Show {rest.length} more from {year}</summary>
                  <ul class="tl-list">
                    {rest.map((row) => (
                      <li>
                        <span class={`tl-badge tl-badge-${row.kind}`}>{row.kindLabel}</span>
                        <a href={row.href}>{row.title}</a>
                        <time datetime={row.date.toISOString()}>{monthLabel(row.date)}</time>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </>
          )}
        </section>
      );
    })}
  </div>

  <div class="tl-related">
    <a href="/about/" class="related-card">
      <h3>About AVI →</h3>
      <p>Who AVI is, how it's governed, and its record of litigation and advocacy.</p>
    </a>
    <a href="/litigation/" class="related-card">
      <h3>Litigation →</h3>
      <p>The full detail behind every court case listed on this timeline.</p>
    </a>
  </div>

  <style>
    .tl-hero { background: var(--paper); padding: 2rem 0 1.5rem; }
    .tl-hero h1 { margin: 0.3rem 0 0.75rem; font-size: clamp(1.9rem, 3.5vw, 2.6rem); }
    .tl-sub { max-width: 42rem; color: var(--muted); font-size: 1rem; line-height: 1.6; margin: 0; }
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-dark);
      margin: 0;
    }

    .tl-years { max-width: var(--max-w); margin: 0 auto; padding: 1rem 1.5rem 2rem; }
    .tl-year { padding: 1.5rem 0; border-top: 1px solid var(--border); }
    .tl-year:first-child { border-top: none; }
    .tl-year h2 { margin: 0 0 0.9rem; font-size: 1.5rem; color: var(--accent-dark); }
    .tl-empty { color: var(--muted); font-size: 0.9rem; font-style: italic; margin: 0; }

    .tl-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
    .tl-list li {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.6rem;
      padding: 0.6rem 0.9rem;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 6px;
    }
    .tl-list a {
      flex: 1 1 14rem;
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      color: var(--ink);
    }
    .tl-list a:hover { color: var(--accent); }
    .tl-list time { font-size: 0.78rem; color: var(--muted); white-space: nowrap; }

    .tl-badge {
      flex-shrink: 0;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      white-space: nowrap;
    }
    .tl-badge-litigation { background: rgba(179,85,46,0.15); color: var(--rust-dark); }
    .tl-badge-submission { background: rgba(31,111,92,0.15); color: var(--accent-dark); }
    .tl-badge-campaign { background: rgba(58,138,108,0.18); color: var(--gold-dark); }
    .tl-badge-press { background: var(--paper-alt); color: var(--muted); }

    .tl-more { margin-top: 0.6rem; }
    .tl-more summary {
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent-dark);
      padding: 0.3rem 0;
    }
    .tl-more .tl-list { margin-top: 0.6rem; }

    .tl-related {
      max-width: var(--max-w);
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      padding: 1.5rem 1.5rem 3rem;
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-alt);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--accent-dark); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
