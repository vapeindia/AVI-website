---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import DecorativeRings from '../../components/DecorativeRings.astro';
import { getCollection, render } from 'astro:content';

const all = (await getCollection('campaigns'))
  .sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf());

const withBody = await Promise.all(all.map(async (item) => ({ item, Content: (await render(item)).Content })));

const typeLabel: Record<string, string> = {
  protest: 'Protest',
  seminar: 'Seminar',
  delegation: 'Delegation',
  'press-conference': 'Press conference',
  'digital-mobilisation': 'Digital mobilisation',
  'research-drive': 'Research drive',
};

function fmtRange(start: Date, end?: Date) {
  const opts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
  if (!end || end.valueOf() === start.valueOf()) return start.toLocaleDateString('en-IN', opts);
  const sameYear = start.getFullYear() === end.getFullYear();
  const startStr = start.toLocaleDateString('en-IN', sameYear ? { month: 'short', day: 'numeric' } : opts);
  return `${startStr} – ${end.toLocaleDateString('en-IN', opts)}`;
}
---
<Base title="Campaigns" description="World Vape Day, the six-city protest against the ENDS ban, #WarOnTar and other on-the-ground advocacy AVI has organised over the years." wide={true}>
  <section class="breakout camp-hero">
    <DecorativeRings class="camp-rings" />
    <div class="breakout-inner">
      <p class="eyebrow">A decade of organising</p>
      <h1>Beyond the courtroom — AVI's public campaigns</h1>
      <p class="camp-sub">
        <a href="/litigation">Litigation</a> and <a href="/submissions">policy letters</a> are
        one half of AVI's work; the other
        is getting in front of the public and the press directly — protests,
        seminars, delegations to government, and campaigns that turned
        vapers' own health data and lived experience into evidence. This is
        that record, city by city and year by year.
      </p>
    </div>
  </section>

  <section class="camp-showcase">
    <div class="camp-showcase-inner">
      <div class="section-head">
        <Icon name="megaphone" />
        <h2>On the ground</h2>
        <p>Protests, press conferences and delegations, city by city — the public-facing half of this record.</p>
      </div>
      <div class="showcase-grid">
        <figure class="showcase-lead">
          <img src="/images/campaigns/six-city-protest.jpg" alt="Vapers holding placards reading 'Vaping is 95% safer than smoking' and listing Delhi, Kolkata, Mumbai, Hyderabad, Bengaluru and Chennai, at a coordinated multi-city protest against the ENDS ban" loading="lazy" />
          <figcaption>The coordinated six-city protest against the ENDS ban — Delhi, Kolkata, Mumbai, Hyderabad, Bengaluru and Chennai, one day, one voice</figcaption>
        </figure>
        <figure>
          <img src="/images/campaigns/chandigarh-presser.jpg" alt="AVI press conference on tobacco harm reduction, Chandigarh" loading="lazy" />
          <figcaption>Press conference on tobacco harm reduction, Chandigarh</figcaption>
        </figure>
        <figure>
          <img src="/images/campaigns/chandigarh-presser-2.jpg" alt="AVI representatives fielding questions from reporters at the Chandigarh press conference" loading="lazy" />
          <figcaption>Fielding questions from reporters, Chandigarh</figcaption>
        </figure>
        <figure>
          <img src="/images/press-club-bangalore.jpg" alt="AVI presenting research and case studies on e-cigarettes/ENDS at a press conference, Press Club of Bangalore" loading="lazy" />
          <figcaption>Presenting research at the Press Club of Bangalore</figcaption>
        </figure>
        <figure>
          <img src="/images/campaigns/press-briefing-avi-banner.jpg" alt="AVI representatives briefing reporters at a press conference under an Association of Vapers India banner" loading="lazy" />
          <figcaption>Briefing reporters under the AVI banner</figcaption>
        </figure>
        <figure>
          <img src="/images/campaigns/delhi-policy-dialogue.jpg" alt="Samrat Chowdhery being interviewed by a television crew at an AVI Policy Dialogue on E-Cigarettes, New Delhi" loading="lazy" style="object-position: 30% 15%" />
          <figcaption>Media interview at AVI's Policy Dialogue on E-Cigarettes, New Delhi</figcaption>
        </figure>
        <figure>
          <img src="/images/campaigns/policy-roundtable.jpg" alt="AVI representatives at a policy roundtable discussion" loading="lazy" />
          <figcaption>At a policy roundtable discussion, New Delhi</figcaption>
        </figure>
        <figure>
          <img src="/images/delegation-mos-health.jpg" alt="AVI delegation meeting with the Union Minister of State for Health" loading="lazy" />
          <figcaption>An AVI delegation meeting the Union Minister of State for Health, Anupriya Patel</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="camp-body">
    <div class="section-head grid-head">
      <Icon name="document" />
      <h2>The full record</h2>
      <p>Every campaign AVI has organised, newest first — protests, seminars, delegations and data drives.</p>
    </div>
    <div class="camp-grid">
      {withBody.map(({ item, Content }) => (
        <article id={item.id} class={`camp-card type-${item.data.type}`}>
          <div class="card-top">
            <Icon name="megaphone" />
            <span class="type-badge">{typeLabel[item.data.type]}</span>
          </div>
          <h2>{item.data.title}</h2>
          <p class="meta">
            {fmtRange(item.data.dateStart, item.data.dateEnd)}
            {item.data.cities.length > 0 && <> · {item.data.cities.join(', ')}</>}
          </p>
          <p class="summary">{item.data.summary}</p>

          {item.data.photos.length > 0 && (
            <div class="photo-strip">
              {item.data.photos.map((p) => (
                <figure>
                  <img src={p.src} alt={p.alt} loading="lazy" style={p.focus ? `object-position: ${p.focus}` : undefined} />
                  {p.caption && <figcaption>{p.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}

          <details>
            <summary>Read the full story</summary>
            <div class="full-text"><Content /></div>
          </details>
        </article>
      ))}
    </div>
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-light);
      margin: 0 0 0.75rem;
    }
    .camp-hero {
      background: linear-gradient(rgba(18,19,15,0.82), rgba(18,19,15,0.93)), url('/images/backgrounds/open-field.jpg');
      background-size: cover;
      background-position: center;
      color: #f4f1e6;
      padding: 4rem 0 3.5rem;
      position: relative;
      overflow: hidden;
    }
    .camp-hero :global(.camp-rings) {
      position: absolute;
      top: 50%;
      right: -10%;
      transform: translateY(-50%);
      width: 28rem;
      height: 28rem;
      max-width: 50vw;
      max-height: 50vw;
      color: var(--gold-light);
      opacity: 0.25;
    }
    .camp-hero h1 { color: #fff; margin: 0 0 1.1rem; font-size: clamp(1.9rem, 3.8vw, 2.7rem); max-width: 44rem; position: relative; }
    .camp-sub { color: #cdd6cf; max-width: 42rem; font-size: 1.03rem; margin: 0; position: relative; }
    .camp-sub a { color: var(--gold-light); text-decoration: underline; text-decoration-color: rgba(216,169,74,0.4); }
    .camp-sub a:hover { color: #fff; }

    .camp-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 3rem 1.5rem 4rem; }
    .camp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr)); gap: 1.75rem; }
    .camp-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.6rem 1.7rem 1.75rem;
      box-shadow: 0 1px 3px rgba(20,25,20,0.05);
      border-top: 4px solid var(--rust);
      scroll-margin-top: 1.5rem;
    }
    .camp-card:target {
      outline: 2px solid var(--gold);
      outline-offset: 2px;
    }
    .type-protest { border-top-color: var(--rust); }
    .type-seminar { border-top-color: var(--accent); }
    .type-delegation { border-top-color: var(--gold); }
    .type-press-conference { border-top-color: var(--accent-light); }
    .type-digital-mobilisation { border-top-color: var(--gold-dark); }
    .type-research-drive { border-top-color: var(--accent-dark); }

    .card-top { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
    .card-top :global(svg) { width: 1.4rem; height: 1.4rem; color: var(--rust); }
    .type-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.55rem;
      border-radius: 99px;
      color: #fff;
      background: var(--muted);
    }
    .camp-card h2 { margin: 0 0 0.3rem; font-size: 1.18rem; line-height: 1.35; }
    .meta { margin: 0 0 0.9rem; font-size: 0.82rem; color: var(--muted); font-weight: 600; }
    .summary { font-size: 0.92rem; color: var(--ink); line-height: 1.55; margin: 0 0 1rem; }

    .photo-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .photo-strip figure { margin: 0; }
    .photo-strip img { width: 100%; height: 8rem; object-fit: cover; border-radius: 6px; display: block; }
    .photo-strip figcaption { margin-top: 0.4rem; font-size: 0.72rem; color: var(--muted); line-height: 1.4; }

    details summary {
      cursor: pointer;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--accent-dark);
      list-style: none;
    }
    details summary::-webkit-details-marker { display: none; }
    details summary::before { content: '+ '; }
    details[open] summary::before { content: '– '; }
    .full-text {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      font-size: 0.9rem;
      line-height: 1.7;
      color: var(--ink);
    }
    .full-text :global(p) { margin: 0 0 0.9rem; }
    .full-text :global(p:last-child) { margin-bottom: 0; }

    /* On-the-ground photo showcase */
    .camp-showcase { background: var(--paper-alt); padding: 3.5rem 0; }
    .camp-showcase-inner { max-width: var(--max-w-wide); margin: 0 auto; padding: 0 1.5rem; }
    .section-head { margin-bottom: 1.75rem; }
    .section-head :global(svg) { width: 1.6rem; height: 1.6rem; color: var(--rust); margin-bottom: 0.5rem; }
    .section-head h2 { margin: 0 0 0.35rem; font-size: 1.5rem; }
    .section-head p { margin: 0; color: var(--muted); font-size: 0.92rem; max-width: 40rem; }
    .grid-head { margin-bottom: 1.75rem; }

    .showcase-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 11rem;
      gap: 1rem;
    }
    .showcase-grid figure { margin: 0; position: relative; border-radius: 8px; overflow: hidden; }
    .showcase-grid img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .showcase-grid figcaption {
      position: absolute;
      inset: auto 0 0 0;
      padding: 1.5rem 0.85rem 0.6rem;
      background: linear-gradient(transparent, rgba(18,19,15,0.82));
      color: #f4f1e6;
      font-size: 0.76rem;
      line-height: 1.4;
    }
    .showcase-lead { grid-column: span 2; grid-row: span 2; }
    .showcase-lead figcaption { font-size: 0.85rem; padding: 2rem 1.1rem 0.85rem; }
    @media (max-width: 900px) {
      .showcase-grid { grid-template-columns: repeat(2, 1fr); }
      .showcase-lead { grid-column: span 2; grid-row: span 1; aspect-ratio: 16/9; height: auto; }
    }
    @media (max-width: 560px) {
      .showcase-grid { grid-template-columns: 1fr; }
      .showcase-lead { grid-column: span 1; }
    }
  </style>
</Base>
