---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import DecorativeRings from '../../components/DecorativeRings.astro';
import { getCollection, render } from 'astro:content';

const all = (await getCollection('campaigns'))
  .sort((a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf());

const withBody = await Promise.all(all.map(async (item) => ({ item, Content: (await render(item)).Content })));

// The six-city protest is AVI's flagship campaign — pulled out of the
// date-sorted grid to feature at the top with its full set of per-city
// photos, rather than competing for attention as one card among seven.
const FEATURED_ID = '2019-09-28-six-city-vape-ban-protest';
const featuredEntry = withBody.find(({ item }) => item.id === FEATURED_ID);
const featuredItem = featuredEntry?.item;
const FeaturedContent = featuredEntry?.Content;
const rest = withBody.filter(({ item }) => item.id !== FEATURED_ID);

// Ready-to-post graphics from past campaigns, offered for public reuse on
// personal social media. Curated from the Drive archive: AVI-branded,
// text/stat-only (no photographed hardware, no third-party logos, no
// named individuals) so they're safe to share without further vetting.
const materials = [
  { src: '/images/campaigns/materials/poster-vaping-safer.jpg', title: 'Vaping is safer than smoking' },
  { src: '/images/campaigns/materials/poster-no-joking-with-smoking.jpg', title: "There's no joking with smoking" },
  { src: '/images/campaigns/materials/poster-burn-calories.jpg', title: 'Why burn your lungs when you can burn calories?' },
  { src: '/images/campaigns/materials/poster-kill-bad-habit.jpg', title: 'Kill your bad habit, not yourself' },
  { src: '/images/campaigns/materials/poster-reject-smoking.jpg', title: 'Reject smoking today, live tomorrow' },
];

const typeLabel: Record<string, string> = {
  protest: 'Protest',
  seminar: 'Seminar',
  delegation: 'Delegation',
  'press-conference': 'Press conference',
  'digital-mobilisation': 'Digital mobilisation',
  'research-drive': 'Research drive',
};

function fmtRange(start: Date, end?: Date) {
  const opts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
  if (!end || end.valueOf() === start.valueOf()) return start.toLocaleDateString('en-IN', opts);
  const sameYear = start.getFullYear() === end.getFullYear();
  const startStr = start.toLocaleDateString('en-IN', sameYear ? { month: 'short', day: 'numeric' } : opts);
  return `${startStr} – ${end.toLocaleDateString('en-IN', opts)}`;
}
---
<Base title="Campaigns" description="World Vape Day, the six-city protest against the ENDS ban, #WarOnTar and other on-the-ground advocacy AVI has organised over the years." wide={true}>
  <section class="breakout camp-hero">
    <DecorativeRings class="camp-rings" />
    <div class="breakout-inner">
      <p class="eyebrow">A decade of organising</p>
      <h1>Beyond the courtroom — AVI's public campaigns</h1>
      <p class="camp-sub">
        <a href="/litigation">Litigation</a> and <a href="/submissions">policy letters</a> are
        one half of AVI's work; the other
        is getting in front of the public and the press directly — protests,
        seminars, delegations to government, and campaigns that turned
        vapers' own health data and lived experience into evidence. This is
        that record, city by city and year by year.
      </p>
    </div>
  </section>

  {featuredItem && FeaturedContent && (
    <section class="breakout camp-featured">
      <div class="breakout-inner">
        <p class="eyebrow">2019</p>
        <h2>{featuredItem.data.title}</h2>
        <p class="feat-summary">{featuredItem.data.summary}</p>
        <div class="feat-photo-grid">
          {featuredItem.data.photos.map((p) => (
            <figure>
              <img src={p.src} alt={p.alt} loading="lazy" style={p.focus ? `object-position: ${p.focus}` : undefined} />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
        <details class="feat-details">
          <summary>Read the full story</summary>
          <div class="full-text"><FeaturedContent /></div>
        </details>
      </div>
    </section>
  )}

  <div class="camp-body">
    <div class="camp-grid">
      {rest.map(({ item, Content }) => (
        <article id={item.id} class={`camp-card type-${item.data.type}`}>
          <div class="card-top">
            <Icon name="megaphone" />
            <span class="type-badge">{typeLabel[item.data.type]}</span>
          </div>
          <h2>{item.data.title}</h2>
          <p class="meta">
            {fmtRange(item.data.dateStart, item.data.dateEnd)}
            {item.data.cities.length > 0 && <> · {item.data.cities.join(', ')}</>}
          </p>
          <p class="summary">{item.data.summary}</p>

          {item.data.photos.length > 0 && (
            <div class="photo-strip">
              {item.data.photos.map((p) => (
                <figure>
                  <img src={p.src} alt={p.alt} loading="lazy" style={p.focus ? `object-position: ${p.focus}` : undefined} />
                  {p.caption && <figcaption>{p.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}

          <details>
            <summary>Read the full story</summary>
            <div class="full-text"><Content /></div>
          </details>
        </article>
      ))}
    </div>

    <section class="c-section materials-section">
      <div class="section-head">
        <Icon name="megaphone" />
        <h2>Campaign materials</h2>
      </div>
      <p class="lead">
        Ready-to-post graphics from AVI's campaigns — save any of these and
        share them on your own social media. No permission needed.
      </p>
      <div class="materials-grid">
        {materials.map((m) => (
          <a class="material-card" href={m.src} download title={`Download: ${m.title}`}>
            <img src={m.src} alt={m.title} loading="lazy" width="1080" height="1080" />
            <span class="material-download"><Icon name="download" /> Download</span>
          </a>
        ))}
      </div>
      <div class="materials-submit">
        <h3>Made your own poster?</h3>
        <p>
          Send it to <a href="mailto:contact@vapeindia.org">contact@vapeindia.org</a> and
          we may add it here for others to use too. A few guidelines:
        </p>
        <ul>
          <li>Square (1:1), at least 1080×1080px, PNG or JPG</li>
          <li>Claims should be evidence-based — link a source if it's a statistic</li>
          <li>No photos of vapes, pouches or other devices — text/graphics only, to stay clear of PECA's advertising restrictions</li>
          <li>No targeting individuals by name or photo</li>
          <li>Credit AVI (logo or "vapeindia.org") somewhere on the design</li>
        </ul>
      </div>
    </section>

    <section class="c-section involve-section" id="get-involved">
      <div class="section-head">
        <Icon name="heart" />
        <h2>Get involved, beyond funds or a testimonial</h2>
      </div>
      <p class="lead">
        Campaigns like these run on more than money and stories — AVI also
        needs legal, medical, media/PR and admin expertise, people willing
        to organise or show up locally, and just good ideas. If you can
        offer any of that, tell us what and where.
      </p>
      <div class="involve-form-wrap">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSf7ybLU3cotHxbYHiVRx7XNgCAc7ffZXjdbKIRaZaJb5LVtiQ/viewform?embedded=true"
          title="AVI membership and advocacy support form"
          loading="lazy"
        >Loading…</iframe>
      </div>
      <p class="involve-fallback">
        Form not loading? <a href="https://bit.ly/ConnectAVI" target="_blank" rel="noopener">Open it in a new tab →</a>
      </p>
      <p class="involve-related">
        Prefer to support with funds instead? See <a href="/contribute">Contribute</a>. Already switched to a safer alternative and want to share your experience? <a href="/testimonials">Share your story</a>.
      </p>
    </section>
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-light);
      margin: 0 0 0.75rem;
    }
    .camp-hero {
      background: linear-gradient(rgba(18,19,15,0.82), rgba(18,19,15,0.93)), url('/images/backgrounds/open-field.jpg');
      background-size: cover;
      background-position: center;
      color: #f4f1e6;
      padding: 4rem 0 3.5rem;
      position: relative;
      overflow: hidden;
    }
    .camp-hero :global(.camp-rings) {
      position: absolute;
      top: 50%;
      right: -10%;
      transform: translateY(-50%);
      width: 28rem;
      height: 28rem;
      max-width: 50vw;
      max-height: 50vw;
      color: var(--gold-light);
      opacity: 0.25;
    }
    .camp-hero h1 { color: #fff; margin: 0 0 1.1rem; font-size: clamp(1.9rem, 3.8vw, 2.7rem); max-width: 44rem; position: relative; }
    .camp-sub { color: #cdd6cf; max-width: 42rem; font-size: 1.03rem; margin: 0; position: relative; }
    .camp-sub a { color: var(--gold-light); text-decoration: underline; text-decoration-color: rgba(216,169,74,0.4); }
    .camp-sub a:hover { color: #fff; }

    /* Featured: the six-city protest, pulled out of the grid */
    .camp-featured { background: var(--paper-alt); padding: 2.5rem 0; }
    .camp-featured .eyebrow { color: var(--gold-dark); }
    .camp-featured h2 { margin: 0 0 0.6rem; font-size: clamp(1.4rem, 3vw, 1.9rem); }
    .feat-summary { color: var(--muted); max-width: 46rem; margin: 0 0 1.5rem; font-size: 1rem; line-height: 1.55; }
    .feat-photo-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1rem; margin-bottom: 1.25rem; }
    .feat-photo-grid figure { margin: 0; }
    .feat-photo-grid img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      display: block;
      border-radius: 8px;
      box-shadow: 0 1px 4px rgba(20,25,20,0.08);
    }
    .feat-photo-grid figcaption {
      margin-top: 0.5rem;
      text-align: center;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--muted);
    }
    .feat-details .full-text { max-width: 46rem; }
    @media (max-width: 900px) {
      .feat-photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 480px) {
      .feat-photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    .camp-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 3rem 1.5rem 4rem; }
    .camp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr)); gap: 1.75rem; }
    .camp-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.6rem 1.7rem 1.75rem;
      box-shadow: 0 1px 3px rgba(20,25,20,0.05);
      border-top: 4px solid var(--rust);
      scroll-margin-top: 1.5rem;
    }
    .camp-card:target {
      outline: 2px solid var(--gold);
      outline-offset: 2px;
    }
    .type-protest { border-top-color: var(--rust); }
    .type-seminar { border-top-color: var(--accent); }
    .type-delegation { border-top-color: var(--gold); }
    .type-press-conference { border-top-color: var(--accent-light); }
    .type-digital-mobilisation { border-top-color: var(--gold-dark); }
    .type-research-drive { border-top-color: var(--accent-dark); }

    .card-top { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
    .card-top :global(svg) { width: 1.4rem; height: 1.4rem; color: var(--rust); }
    .type-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.55rem;
      border-radius: 99px;
      color: #fff;
      background: var(--muted);
    }
    .camp-card h2 { margin: 0 0 0.3rem; font-size: 1.18rem; line-height: 1.35; }
    .meta { margin: 0 0 0.9rem; font-size: 0.82rem; color: var(--muted); font-weight: 600; }
    .summary { font-size: 0.92rem; color: var(--ink); line-height: 1.55; margin: 0 0 1rem; }

    .photo-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .photo-strip figure { margin: 0; }
    .photo-strip img { width: 100%; height: 8rem; object-fit: cover; border-radius: 6px; display: block; }
    .photo-strip figcaption { margin-top: 0.4rem; font-size: 0.72rem; color: var(--muted); line-height: 1.4; }

    details summary {
      cursor: pointer;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--accent-dark);
      list-style: none;
    }
    details summary::-webkit-details-marker { display: none; }
    details summary::before { content: '+ '; }
    details[open] summary::before { content: '– '; }
    .full-text {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      font-size: 0.9rem;
      line-height: 1.7;
      color: var(--ink);
    }
    .full-text :global(p) { margin: 0 0 0.9rem; }
    .full-text :global(p:last-child) { margin-bottom: 0; }

    .c-section { margin: 0 0 3.5rem; }
    .section-head { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.1rem; }
    .section-head :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--accent); flex-shrink: 0; }
    .section-head h2 { margin: 0; font-size: 1.35rem; }
    .lead { font-size: 0.95rem; max-width: 46rem; color: var(--ink); line-height: 1.65; margin: 0 0 1.5rem; }

    .materials-section { padding-top: 2.5rem; border-top: 1px solid var(--border); }
    .materials-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(11rem, 100%), 1fr)); gap: 1.25rem; }
    .material-card {
      position: relative;
      display: block;
      border-radius: 8px;
      overflow: hidden;
      line-height: 0;
      box-shadow: 0 1px 3px rgba(20,25,20,0.08);
    }
    .material-card img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; transition: transform 0.2s ease; }
    .material-card:hover img { transform: scale(1.04); }
    .material-download {
      position: absolute; inset-inline: 0; bottom: 0;
      display: flex; align-items: center; justify-content: center; gap: 0.4rem;
      padding: 0.5rem; font-size: 0.8rem; font-weight: 600; color: #fff;
      background: linear-gradient(rgba(18,19,15,0), rgba(18,19,15,0.75));
      line-height: 1.2;
    }
    .material-download :global(svg) { width: 0.95rem; height: 0.95rem; }

    .materials-submit {
      margin-top: 1.75rem;
      max-width: 46rem;
      background: var(--paper-alt);
      border: 1px solid var(--border);
      border-left: 4px solid var(--gold);
      border-radius: 6px;
      padding: 1.1rem 1.4rem;
    }
    .materials-submit h3 { margin: 0 0 0.5rem; font-size: 0.98rem; }
    .materials-submit p { margin: 0 0 0.75rem; font-size: 0.88rem; color: var(--muted); line-height: 1.55; }
    .materials-submit ul { margin: 0; padding-left: 1.25rem; font-size: 0.85rem; color: var(--muted); line-height: 1.6; }
    .materials-submit li { margin-bottom: 0.35rem; }
    .materials-submit li:last-child { margin-bottom: 0; }

    .involve-section { padding-top: 1rem; border-top: 1px solid var(--border); }
    .involve-form-wrap {
      max-width: 46rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
    }
    .involve-form-wrap iframe { width: 100%; height: 2500px; border: 0; display: block; }
    .involve-fallback { font-size: 0.85rem; color: var(--muted); margin: 0.75rem 0 0; }
    .involve-related { font-size: 0.9rem; margin: 1.5rem 0 0; }
  </style>
</Base>
