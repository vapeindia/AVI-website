---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

const UPI_ID = 'yespay.bizsbiz129416@yesbankltd';
const UPI_PAYEE = 'Harm Reduction Policy and Research';

// docs/tasks/07-mobilisation.md item 2, with Samrat's own correction: a
// upi://pay deep link can't actually be tested on a phone from this
// environment, so the button ships switched off by default rather than
// live/untested. Flip to true only after Samrat has confirmed
// the link opens correctly in Google Pay, PhonePe and Paytm on both
// Android and iPhone — see the PR description's "Needs Samrat" section for
// the exact test steps and what to do if an app rejects it. The "Copy UPI
// ID" button and the QR code are unaffected by this flag — both ship live
// either way, per the correction.
const UPI_DEEPLINK_ENABLED = false;
const upiPayLink = `upi://pay?pa=${encodeURIComponent(UPI_ID)}&pn=${encodeURIComponent(UPI_PAYEE)}&cu=INR&tn=${encodeURIComponent('AVI contribution')}`;
---
<Base title="Contribute" description="Support AVI's tobacco harm reduction and vaping advocacy work in India — litigation, evidence review and policy work funded by individual contributions." wide={true}>
  <section class="breakout contrib-hero">
    <div class="breakout-inner">
      <p class="eyebrow">Fund independent advocacy</p>
      <h1>Contribute</h1>
      <p class="contrib-sub">
        AVI's advocacy — litigation, evidence review, and public correction
        of misinformation — is funded by individual contributions, not by
        industry. Contributions are received and accounted for through{' '}
        <strong>Harm Reduction Policy &amp; Research Pvt. Ltd. (HRPR)</strong>,
        an MCA-registered company, recorded as company income, audited
        annually and taxed accordingly.
      </p>
      <p class="contrib-note">
        <strong>Contributions are not tax-deductible.</strong> HRPR does not
        hold 80G status, so no tax receipt can be issued against your
        contribution.
      </p>
    </div>
  </section>

  <div class="contrib-body">
    <section class="c-section">
      <div class="section-head">
        <Icon name="shield" />
        <h2>Who can contribute</h2>
      </div>
      <p class="lead">
        We can currently accept contributions only from <strong>Indian
        residents, and Indian citizens living abroad remitting from their
        own funds</strong>. Foreign nationals and foreign-registered entities
        cannot contribute directly to this fund — Indian law (FCRA, 2010)
        restricts unregistered organisations from accepting contributions of
        foreign origin, and HRPR does not hold FCRA registration.
      </p>
      <p class="lead">
        If you represent an institution abroad interested in supporting
        specific research or policy work, please write to{' '}
        <a href="mailto:contact@vapeindia.org">contact@vapeindia.org</a> —
        this can be structured as commissioned project work, which is
        handled separately.
      </p>
    </section>

    <section class="c-section">
      <div class="section-head">
        <Icon name="heart" />
        <h2>How to contribute</h2>
      </div>
      <div class="how-grid">
        <div class="how-card">
          <h3>UPI</h3>
          <img
            src="/contribute-qr.jpg"
            alt="UPI QR code for Harm Reduction Policy And Research Private Limited, payable via yespay.bizsbiz129416@yesbankltd"
            width="220"
            height="239"
          />
          <p class="upi-id">UPI ID: <strong>{UPI_ID}</strong></p>
          <div class="upi-actions">
            {UPI_DEEPLINK_ENABLED ? (
              <a class="btn btn-primary upi-pay-btn" href={upiPayLink}>Pay with a UPI app →</a>
            ) : (
              <button type="button" class="btn btn-outline upi-pay-btn" disabled aria-disabled="true" title="Being tested before launch — use the QR code or UPI ID for now">
                Pay with a UPI app (coming soon)
              </button>
            )}
            <button type="button" class="btn btn-outline upi-copy-btn" data-copy-upi={UPI_ID}>Copy UPI ID</button>
          </div>
          <p class="upi-copy-feedback" data-upi-copy-feedback hidden>Copied!</p>
        </div>
        <div class="how-card">
          <h3>Bank transfer</h3>
          <table class="bank-table">
            <tbody>
              <tr><th scope="row">Account name</th><td>Harm Reduction Policy And Research Pvt Ltd</td></tr>
              <tr><th scope="row">Account number</th><td>034661900003311</td></tr>
              <tr><th scope="row">IFSC</th><td>YESB0000346</td></tr>
              <tr><th scope="row">Bank</th><td>Yes Bank</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="c-section">
      <div class="section-head">
        <Icon name="chart" />
        <h2>Where the money goes</h2>
      </div>
      <p class="lead">
        AVI runs lean by design — there's no large operating budget or paid
        administrative layer standing between a contribution and the work it
        goes toward. This is the work it funds directly:
      </p>
      <div class="funds-related">
        <a href="/litigation/" class="related-card">
          <h3>Litigation →</h3>
          <p>Court cases AVI has organised and directed against India's ENDS bans since 2017.</p>
        </a>
        <a href="/submissions/" class="related-card">
          <h3>Submissions to policymakers →</h3>
          <p>Direct, evidence-based cases for regulation over prohibition, sent to policymakers.</p>
        </a>
      </div>
      <p class="testimonials-link">
        <a href="/testimonials/">Read stories from people this work has already helped →</a>
      </p>
      <p class="testimonials-link">
        <a href="/campaigns/#get-involved">Not able to contribute funds? See other ways to help →</a>
      </p>
    </section>

    <!--
      Not live yet (docs/tasks/07-mobilisation.md item 2) — needs real
      figures from Samrat before this renders: specific suggested
      contribution amounts tied to real costs (e.g. "₹X covers one month of
      <something concrete>"), and a breakdown of where contributions went
      last year. Full list of exactly what's needed is in the PR
      description's Needs Samrat section. Markup below is ready to drop in
      once those figures exist — fill the two arrays and move this section
      (uncommented) above the related-links block a few lines up.

      const SUGGESTED_AMOUNTS = [
        { amount: 0, label: '' }, // e.g. { amount: 500, label: 'covers ...' }
      ];
      const MONEY_WENT_LAST_YEAR = [
        { label: '', share: 0 }, // e.g. { label: 'Litigation', share: 40 }
      ];

      <section class="c-section">
        <div class="section-head">
          <Icon name="chart" />
          <h2>Suggested amounts</h2>
        </div>
        <div class="suggested-amounts">
          {SUGGESTED_AMOUNTS.map((a) => (
            <div class="amount-card">
              <strong>₹{a.amount.toLocaleString('en-IN')}</strong>
              <span>{a.label}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="c-section">
        <div class="section-head">
          <Icon name="chart" />
          <h2>Where the money went last year</h2>
        </div>
        <div class="money-went">
          {MONEY_WENT_LAST_YEAR.map((m) => (
            <div class="money-row">
              <span class="money-label">{m.label}</span>
              <span class="money-bar"><span class="money-bar-fill" style={`width:${m.share}%`}></span></span>
              <span class="money-share">{m.share}%</span>
            </div>
          ))}
        </div>
      </section>
    -->
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-light);
      margin: 0 0 0.75rem;
    }
    .contrib-hero {
      background: linear-gradient(rgba(18,19,15,0.85), rgba(18,19,15,0.93)), url('/images/backgrounds/open-field.jpg');
      background-size: cover;
      background-position: center;
      color: #f4f1e6;
      padding: 3.5rem 0 3rem;
    }
    .contrib-hero h1 { color: #fff; margin: 0 0 1.1rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .contrib-sub { color: #cdd6cf; max-width: 46rem; font-size: 1.03rem; margin: 0 0 1rem; }
    .contrib-note { color: #f4e0c8; max-width: 46rem; font-size: 0.92rem; margin: 0; }

    .contrib-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 3rem 1.5rem 4rem; }
    .c-section { margin-bottom: 3.5rem; }
    .c-section:last-child { margin-bottom: 0; }
    .section-head { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.25rem; }
    .section-head :global(svg) { width: 1.6rem; height: 1.6rem; color: var(--accent); flex-shrink: 0; }
    .section-head h2 { margin: 0; font-size: 1.4rem; }
    .lead { font-size: 0.95rem; max-width: 46rem; color: var(--ink); line-height: 1.65; margin: 0 0 1rem; }

    .how-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr)); gap: 1.5rem; max-width: 42rem; }
    .how-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem;
    }
    .how-card h3 { margin: 0 0 1rem; font-size: 1.05rem; }
    .how-card img { display: block; border-radius: 4px; margin-bottom: 0.85rem; max-width: 100%; height: auto; }
    .upi-id { font-size: 0.88rem; margin: 0 0 0.9rem; word-break: break-all; }
    .upi-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .upi-actions .btn { cursor: pointer; font: inherit; font-weight: 600; font-size: 0.86rem; }
    .upi-pay-btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .upi-copy-feedback { margin: 0.6rem 0 0; font-size: 0.82rem; font-weight: 600; color: var(--accent-dark); }
    .bank-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .bank-table th, .bank-table td { text-align: left; padding: 0.5rem 0.25rem; border-bottom: 1px solid var(--border); }
    .bank-table th { font-weight: 600; color: var(--muted); white-space: nowrap; padding-right: 1rem; }

    .funds-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      margin: 1.5rem 0 1.25rem;
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-alt);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--accent-dark); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
    .testimonials-link { font-weight: 600; font-size: 0.95rem; margin: 0; }
  </style>

  <script>
    // "Copy UPI ID" — ships live regardless of the upi://pay deep link's
    // own enabled/disabled state (see the correction noted in the
    // frontmatter above).
    const copyBtn = document.querySelector<HTMLButtonElement>('.upi-copy-btn');
    const feedback = document.querySelector<HTMLElement>('[data-upi-copy-feedback]');
    copyBtn?.addEventListener('click', async () => {
      const upiId = copyBtn.getAttribute('data-copy-upi') || '';
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(upiId);
        } else {
          const tmp = document.createElement('textarea');
          tmp.value = upiId;
          tmp.style.position = 'fixed';
          tmp.style.left = '-9999px';
          document.body.appendChild(tmp);
          tmp.select();
          document.execCommand('copy');
          document.body.removeChild(tmp);
        }
        if (feedback) {
          feedback.hidden = false;
          setTimeout(() => { feedback.hidden = true; }, 2000);
        }
      } catch {
        // Clipboard access denied/unsupported — the UPI ID is already
        // visible as plain selectable text right above the button, so
        // there's nothing destructive to fall back to.
      }
    });
  </script>
</Base>
