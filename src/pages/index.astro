---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DecorativeRings from '../components/DecorativeRings.astro';
import PullQuote from '../components/PullQuote.astro';
import { getCollection } from 'astro:content';

const latestNews = (await getCollection('news', ({ data }) => data.reviewed))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const latestResearch = (await getCollection('research', ({ data }) => data.reviewed))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const testimonialCount = (await getCollection('testimonials', ({ data }) => data.reviewed)).length;
const litigationCount = (await getCollection('litigation')).length;
const pressCount = (await getCollection('press')).length;
const yearsActive = new Date().getFullYear() - 2016;
---
<Base title="Home" wide={true}>
  <section class="breakout hero">
    <DecorativeRings class="hero-rings" />
    <div class="breakout-inner hero-inner">
      <p class="eyebrow">Tobacco harm reduction for India</p>
      <h1>Still smoking? There's a<br class="br-desktop" /> safer path forward.</h1>
      <p class="hero-sub">
        If nicotine gums and patches haven't worked for you, or you're not
        ready to quit nicotine entirely, there are lower-risk ways to keep
        using it. We've spent a decade reviewing the evidence and fighting
        in court for your right to know about them.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-gold" href="/science">See the evidence →</a>
        <a class="btn btn-outline" href="/india/law">What the law says →</a>
      </div>
      <div class="hero-stats">
        <div><strong>{litigationCount}</strong><span>court cases</span></div>
        <div><strong>{pressCount}+</strong><span>press features</span></div>
        <div><strong>{yearsActive}+</strong><span>years active</span></div>
      </div>
    </div>
  </section>

  <section class="breakout paths">
    <div class="breakout-inner">
      <h2 class="paths-heading">Three groups, one goal</h2>
      <div class="path-grid">
        <div class="path-card path-green">
          <Icon name="heart" />
          <h3>If you smoke</h3>
          <p>NRTs don't work for everyone. See the evidence on lower-risk ways to keep using nicotine.</p>
          <a href="/science">Explore your options →</a>
        </div>
        <div class="path-card path-gold">
          <Icon name="leaf" />
          <h3>Smokeless tobacco users</h3>
          <p>We also work on harm reduction for India's 200 million smokeless tobacco users.</p>
          <a href="/science">Read the research →</a>
        </div>
        <div class="path-card path-rust">
          <Icon name="shield" />
          <h3>Policymakers &amp; researchers</h3>
          <p>Our advocacy is built on published evidence, litigation, and a decade-long public record.</p>
          <a href="/india/law">See the legal position →</a>
        </div>
      </div>
    </div>
  </section>

  <PullQuote
    quote="People smoke for nicotine, but they die from the tar."
    attribution="Professor Michael Russell, 1976"
  />

  <section class="breakout stats-band">
    <div class="breakout-inner global-stat">
      <div class="big-stat">
        <strong>200M+</strong>
        <span>
          People worldwide now use safer nicotine products — vapes, heated
          tobacco, snus and nicotine pouches — a fifth to a quarter of all
          smokers globally, per
          <a href="https://gsthr.org/resources/thr-reports/the-global-state-of-tobacco-harm-reduction-2026-a-situation-report/" target="_blank" rel="noopener">GSTHR's 2026 Global State of Tobacco Harm Reduction report</a>.
        </span>
      </div>
    </div>
  </section>

  <section class="feed-section">
    <div class="feed-grid">
      <div>
        <div class="feed-head"><h2>Latest news</h2><a href="/news">All news →</a></div>
        <ul class="feed-list feed-news">
          {latestNews.map((item) => (
            <li>
              <a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.title}</a>
              <span>{item.data.sourceName}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="feed-head"><h2>Evidence library</h2><a href="/science">Full library →</a></div>
        <ul class="feed-list feed-research">
          {latestResearch.map((item) => (
            <li>
              <a href={`/science/${item.id}`}>{item.data.title}</a>
              <span>{item.data.journal}, {item.data.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="legal-note">
      Electronic cigarettes are banned in India under the Prohibition of
      Electronic Cigarettes Act, 2019 (PECA). <a href="/india/law">Read what this means for you →</a>
    </p>
  </section>

  <section class="breakout donate-pitch">
    <div class="breakout-inner donate-inner">
      <p class="eyebrow eyebrow-light">For those it's already helped</p>
      <h2>Quit smoking because you found a safer alternative?</h2>
      <p>
        AVI exists because harm reduction worked for people like you, and we
        want it available to the millions still smoking. This work — litigation,
        evidence review, correcting misinformation — is funded entirely by
        individual contributions, not industry.{' '}
        {testimonialCount > 0
          ? <a href="/testimonials">Read {testimonialCount}+ stories from people it's helped →</a>
          : <a href="/testimonials">Read stories from people it's helped →</a>}
      </p>
      <a class="btn btn-gold" href="/contribute">Support this work →</a>
    </div>
  </section>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-dark);
      margin: 0 0 0.75rem;
    }
    .eyebrow-light { color: var(--gold-light); }

    /* Hero */
    .hero {
      background: var(--ink-black);
      color: #f4f1e6;
      padding: 4.5rem 0 4rem;
      position: relative;
      overflow: hidden;
    }
    .hero :global(.hero-rings) {
      position: absolute;
      top: 50%;
      right: -8%;
      transform: translateY(-50%);
      width: 34rem;
      height: 34rem;
      max-width: 60vw;
      max-height: 60vw;
      color: var(--accent-light);
      opacity: 0.35;
    }
    .hero :global(.hero-rings circle:nth-child(2)) { color: var(--gold-light); opacity: 0.8; }
    .hero-inner { max-width: 46rem; position: relative; }
    .hero .eyebrow { color: var(--gold-light); }
    .hero h1 {
      color: #fff;
      font-size: clamp(2rem, 4.2vw, 3rem);
      margin: 0 0 1.25rem;
    }
    .hero-sub {
      font-size: 1.1rem;
      color: #cdd6cf;
      max-width: 38rem;
      margin: 0 0 2rem;
    }
    .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
    .hero .btn-outline { border-color: #46524a; color: #f4f1e6; }
    .hero .btn-outline:hover { border-color: #f4f1e6; color: #fff; }
    .hero-stats {
      display: flex;
      gap: 2.5rem;
      flex-wrap: wrap;
      padding-top: 1.75rem;
      border-top: 1px solid #333c34;
    }
    .hero-stats strong {
      display: block;
      font-family: var(--font-serif);
      font-size: 1.8rem;
      color: var(--gold-light);
      line-height: 1;
    }
    .hero-stats span { font-size: 0.82rem; color: #9fada2; }

    /* Three paths */
    .paths { background: var(--paper); padding: 4rem 0 3.5rem; }
    .paths-heading { text-align: center; margin: 0 0 2.5rem; font-size: 1.7rem; }
    .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
    .path-card {
      background: #fff;
      border-radius: 6px;
      padding: 1.75rem 1.5rem;
      border-top: 4px solid;
      box-shadow: 0 1px 3px rgba(20,25,20,0.06);
    }
    .path-card :global(svg) { width: 2rem; height: 2rem; margin-bottom: 1rem; }
    .path-card h3 { margin: 0 0 0.5rem; font-size: 1.15rem; }
    .path-card p { color: var(--muted); font-size: 0.92rem; margin: 0 0 1rem; }
    .path-card a { font-weight: 600; font-size: 0.9rem; text-decoration: none; }
    .path-green { border-color: var(--accent); }
    .path-green :global(svg) { color: var(--accent); }
    .path-green a { color: var(--accent-dark); }
    .path-gold { border-color: var(--gold); }
    .path-gold :global(svg) { color: var(--gold); }
    .path-gold a { color: var(--gold-dark); }
    .path-rust { border-color: var(--rust); }
    .path-rust :global(svg) { color: var(--rust); }
    .path-rust a { color: var(--rust-dark); }
    @media (max-width: 780px) {
      .path-grid { grid-template-columns: 1fr; }
    }

    /* Stats band */
    .stats-band { background: var(--accent-dark); color: #fff; padding: 3.5rem 0; }
    .global-stat { display: flex; justify-content: center; }
    .global-stat .big-stat { max-width: 34rem; text-align: center; }
    .big-stat strong {
      display: block;
      font-family: var(--font-serif);
      font-size: 3.75rem;
      color: var(--gold-light);
      line-height: 1;
      margin-bottom: 0.75rem;
    }
    .big-stat span { font-size: 0.98rem; color: #cfe0d8; line-height: 1.6; }
    .big-stat span a { color: var(--gold-light); }

    /* Feed section */
    .feed-section { max-width: var(--max-w-wide); margin: 3.5rem auto 0; padding: 0 1.5rem; }
    .feed-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-bottom: 2rem; }
    .feed-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem; }
    .feed-head h2 { margin: 0; font-size: 1.3rem; }
    .feed-head a { font-size: 0.85rem; font-weight: 600; text-decoration: none; }
    .feed-list { list-style: none; margin: 0; padding: 0; }
    .feed-list li {
      padding: 0.85rem 0 0.85rem 1rem;
      border-left: 3px solid var(--border);
      margin-bottom: 0.5rem;
    }
    .feed-news li { border-left-color: var(--gold); }
    .feed-research li { border-left-color: var(--accent); }
    .feed-list a { display: block; font-weight: 600; text-decoration: none; color: var(--ink); margin-bottom: 0.2rem; }
    .feed-list a:hover { color: var(--accent); }
    .feed-list span { font-size: 0.82rem; color: var(--muted); }
    .legal-note { font-size: 0.92rem; color: var(--muted); border-top: 1px solid var(--border); padding-top: 1.5rem; }
    @media (max-width: 780px) {
      .feed-grid { grid-template-columns: 1fr; }
    }

    /* Donate */
    .donate-pitch { background: var(--rust); color: #fff; padding: 3.75rem 0; margin-top: 3.5rem; }
    .donate-inner { max-width: 40rem; }
    .donate-pitch h2 { color: #fff; margin: 0 0 1rem; font-size: 1.9rem; }
    .donate-pitch p { color: #fbe6db; }
    .donate-pitch a:not(.btn) { color: #fff; text-decoration-color: rgba(255,255,255,0.5); }
  </style>
</Base>
