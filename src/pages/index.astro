---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getCollection } from 'astro:content';
import { getHarassmentStats } from '../lib/harassment-stats';
import logo from '../assets/images/avi-logo.png';
import heroPhoto from '../assets/images/bangalore-protest-hero.jpg';
import { PECA_BANNED, PECA_NOT_BANNED } from '../data/peca';

const hStats = await getHarassmentStats();

// "In the news" (item 4) — three approved items, title + publisher name
// only, no AI-paraphrased summary shown alongside.
const latestNews = (await getCollection('news', ({ data }) => data.reviewed))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const videoData = (await getCollection('videos'))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .map((v) => ({
    videoId: v.data.videoId,
    title: v.data.title,
    summary: v.data.summary,
    thumb: v.data.thumbnailUrl,
    url: `https://www.youtube.com/watch?v=${v.data.videoId}`,
  }));
// docs/tasks/08-homepage.md item 6: the newest upload (June 2024) is a
// dated one-off, not a steady drumbeat — don't just show "whatever's
// newest" (that would keep surfacing dated event recaps as new videos get
// pulled in weekly) or display a publish date here. Pin the strongest
// evergreen explainer instead: a plain, undated "is nicotine addictive"
// answer that stays accurate regardless of when a visitor finds it. If
// this video is ever removed from the channel, falls back to whatever's
// newest rather than breaking.
const FEATURED_VIDEO_ID = 'dqHWiP5rGtE'; // "Is Nicotine Addictive?"
const featuredIndex = videoData.findIndex((v) => v.videoId === FEATURED_VIDEO_ID);
const orderedVideos = featuredIndex > 0
  ? [videoData[featuredIndex], ...videoData.slice(0, featuredIndex), ...videoData.slice(featuredIndex + 1)]
  : videoData;
const latestVideo = orderedVideos[0];

const testimonialCount = (await getCollection('testimonials', ({ data }) => data.reviewed)).length;

// AVI's own voice only (press-release/quote), excluding anything still
// reviewed: false — see content.config.ts and src/pages/press/index.astro.
// Newest three, for the homepage "Latest from AVI" strip.
const latestStatements = (await getCollection('press', ({ data }) =>
  data.reviewed && (data.type === 'press-release' || data.type === 'quote')
))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
function displayStatementDate(d: Date): string {
  if (d.getUTCMonth() === 0 && d.getUTCDate() === 1) return String(d.getUTCFullYear());
  return d.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Item 7's WhatsApp button on the "Know your rights" card — a plain
// wa.me share-intent link, same convention as ShareButtons.astro.
const kyrShareUrl = `${new URL('/india/law/', Astro.site).toString()}#know-your-rights`;
const kyrWaText = "Know your rights: possession of an e-cigarette is not banned under India's PECA law.";
const kyrWaHref = `https://wa.me/?text=${encodeURIComponent(`${kyrWaText} ${kyrShareUrl}`)}`;
---
<Base title="Association of Vapers India (AVI) · Tobacco harm reduction advocacy" rawTitle={true} description="India's leading consumer advocacy group for tobacco harm reduction: evidence, litigation and policy work for safer nicotine alternatives." wide={true}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="AVI statements" href="/press/statements.rss.xml" />
  <section class="breakout hero-v2">
    <div class="breakout-inner hero-v2-inner">
      <div class="hero-copy">
        <p class="hero-org-line">Association of Vapers India</p>
        <h1>Still smoking? There's a <em>safer path forward.</em></h1>
        <p class="hero-sub">
          If nicotine gums and patches haven't worked for you, or you're not
          ready to quit nicotine entirely, there are lower-risk ways of
          consuming it. We've spent a decade reviewing the evidence and
          fighting in court for your right to know about them.
        </p>
        <div class="hero-bottom">
          <div class="hero-stats-group">
            <p class="hero-stats-label">Worldwide</p>
            <div class="hero-stats">
              <div><strong>1.2B</strong><span>tobacco users worldwide</span></div>
              <div><strong>7M+</strong><span>deaths/year</span></div>
              <div><strong>200M+</strong><span>use safer nicotine products</span></div>
            </div>
            <p class="hero-stats-source">
              Sources: <a href="https://gsthr.org/resources/thr-reports/the-global-state-of-tobacco-harm-reduction-2026-a-situation-report/" target="_blank" rel="noopener">GSTHR, 2026</a> · <a href="https://www.who.int/news-room/fact-sheets/detail/tobacco" target="_blank" rel="noopener">WHO, 2026</a>
            </p>
          </div>
          <div class="hero-stats-group">
            <p class="hero-stats-label">In India</p>
            <div class="hero-stats hero-stats-india">
              <div><strong>100M</strong><span>smokers</span></div>
              <div><strong>200M</strong><span>smokeless tobacco users</span></div>
            </div>
            <p class="hero-stats-source">
              Source: <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10263025/" target="_blank" rel="noopener">GATS-2, 2016-17</a> — same figures as <a href="/india/">/india/</a>
            </p>
          </div>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <figure>
          <Image src={heroPhoto} width={1000} height={750} alt="Vapers protesting the e-cigarette ban in Bengaluru, at AVI's nationwide six-city protest, 28 September 2019" loading="eager" />
          <figcaption class="photo-tag">India Vape Ban Protest — six cities, 2019</figcaption>
        </figure>
        <p class="hero-photo-caption">A consumer movement: former smokers who organised, litigated and kept showing up. <a href="/campaigns/#2019-09-28-six-city-vape-ban-protest">More from that day →</a></p>
      </div>
    </div>
  </section>

  <section class="breakout paths">
    <div class="breakout-inner">
      <div class="path-grid">
        <div class="path-card path-green">
          <Icon name="heart" />
          <h3>If you smoke, or use toxic SLT</h3>
          <p>See the evidence on lower-risk ways to keep using nicotine, and how people have quit combustible tobacco successfully with them.</p>
          <a class="btn path-btn" href="/quit/">I want to quit smoking →</a>
        </div>
        <div class="path-card path-gold">
          <Icon name="scale" />
          <h3>Policymakers</h3>
          <p>The global policy case for tobacco harm reduction — what's working elsewhere, what isn't, and what it means for India.</p>
          <a class="btn path-btn" href="/policy/">Policy data →</a>
        </div>
        <div class="path-card path-rust">
          <Icon name="megaphone" />
          <h3>Media</h3>
          <p>AVI has been quoted, interviewed and bylined on tobacco harm reduction in India for over a decade. We're always available for comment.</p>
          <a class="btn path-btn" href="/press/">Press resources →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="kyr-wrap">
    <div class="kyr-card" id="kyr-card">
      <div class="kyr-head">
        <Image src={logo} width={56} height={56} alt="" class="kyr-logo" />
        <span class="kyr-brand">Association of Vapers India</span>
      </div>
      <p class="kyr-eyebrow">Know your rights under PECA, 2019</p>
      <p class="kyr-headline">Personal possession is <strong>NOT banned.</strong></p>
      <div class="kyr-split">
        <div class="kyr-col kyr-banned">
          <span class="kyr-col-label">Banned</span>
          <ul>
            {PECA_BANNED.map((item) => <li>{item.label} <small>(s.{item.section})</small></li>)}
          </ul>
        </div>
        <div class="kyr-col kyr-notbanned">
          <span class="kyr-col-label">Not banned</span>
          <ul>
            {PECA_NOT_BANNED.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <p class="kyr-foot">No provision in PECA makes personal use or possession an offence. Penalties apply only to the commercial acts above. · <strong>vapeindia.org/india/law</strong></p>
    </div>
    <div class="kyr-actions">
      <a class="btn btn-primary" href="/india/law/#know-your-rights">Read the full legal breakdown →</a>
      <a class="btn btn-secondary" href="/report-harassment/">Report an incident →</a>
    </div>
    {/* docs/tasks/08-homepage.md item 7 — a WhatsApp share button for this
        card specifically (this is the content people actually screenshot
        and forward), plus the email signup so a visitor who came for the
        legal answer has an easy next step besides leaving. Plain wa.me
        share-intent URL, same convention as ShareButtons.astro — no
        third-party script. */}
    <div class="kyr-extra">
      <a class="kyr-whatsapp" href={kyrWaHref} target="_blank" rel="noopener" aria-label="Share this on WhatsApp">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.7-1.2A9 9 0 1 0 12 3z" />
          <path d="M8.3 9.8c.4 2.6 2.4 4.6 5 5" />
        </svg>
        Share on WhatsApp
      </a>
    </div>
  </section>

  <section class="breakout rights-cta">
    <div class="breakout-inner rights-cta-inner">
      <div class="rights-cta-copy">
        <p class="eyebrow eyebrow-light"><Icon name="scale" /> Know your rights</p>
        <h2>Stopped by police over your vape? Use and possession are not banned.</h2>
        <p>PECA bans the sale of e-cigarettes, not carrying or using one. If an officer tells you otherwise, this page has the receipts — and a place to report what happened.</p>
        <div class="rights-cta-links">
          <a class="btn btn-primary" href="/india/law/#know-your-rights">Know your rights →</a>
          <a class="btn btn-secondary" href="/report-harassment/">Report an incident →</a>
        </div>
      </div>
      {hStats.visible ? (
        <a class="rights-cta-stat" href="/report-harassment/">
          <strong>{hStats.total}</strong>
          <span>harassment report{hStats.total === 1 ? '' : 's'} logged</span>
          <em>Tracker live since October 2026</em>
        </a>
      ) : (
        <a class="rights-cta-stat" href="/campaigns/#2020-2023-airport-confiscation-reports">
          <strong>60</strong>
          <span>airport confiscations AVI documented, 2020–23</span>
          <em>New tracker launched October 2026 — report yours →</em>
        </a>
      )}
    </div>
  </section>

  <section class="breakout what-we-do">
    <div class="breakout-inner">
      <p class="eyebrow eyebrow-light">What AVI does</p>
      <h2>A decade of evidence, litigation and advocacy</h2>
      <p class="wwd-summary">
        AVI reviews the international evidence on safer nicotine alternatives,
        fights bans and restrictions in court, petitions policymakers
        directly, and puts the case for harm reduction in front of the
        press — all funded by individual contributions, not industry.
      </p>
      <nav class="wwd-tabs" aria-label="AVI's work">
        <a href="/science/">Evidence →</a>
        <a href="/litigation/">Litigation →</a>
        <a href="/press/">Press →</a>
        <a href="/submissions/">Submissions →</a>
        <a href="/campaigns/">Campaigns →</a>
      </nav>
    </div>
  </section>

  {/* docs/tasks/08-homepage.md item 5: a short teaser strip linking to the
      full chronological record at /about/timeline/, built from the site's
      own dated litigation/submissions/campaigns/press entries. */}
  <section class="breakout timeline-strip">
    <div class="breakout-inner timeline-strip-inner">
      <div>
        <Icon name="clock" />
        <h2>Ten years of AVI, 2016–2026</h2>
        <p>Every court filing, submission, campaign and statement AVI's public record carries a date for, in one place.</p>
      </div>
      <a class="btn btn-secondary" href="/about/timeline/">See the full timeline →</a>
    </div>
  </section>

  {/* docs/tasks/08-homepage.md item 4: the external aggregated "Latest
      news"/"Evidence library" tabbed block (the old .feed-section, two
      third-party feeds switched between with no AVI voice in either) is
      replaced outright by AVI's own "Latest from AVI" statements, promoted
      to this position. A short "In the news" list keeps the three most
      recent approved third-party items visible underneath it — title and
      publisher name only, same as the old feed list rendered, just not
      behind a tab anymore. */}
  {(latestStatements.length > 0 || latestNews.length > 0) && (
    <section class="breakout latest-avi">
      <div class="breakout-inner">
        {latestStatements.length > 0 && (
          <>
            <div class="latest-avi-head">
              <div>
                <p class="eyebrow">In AVI's own words</p>
                <h2>Latest from AVI</h2>
              </div>
              <a class="latest-avi-all" href="/press/">All statements →</a>
            </div>
            <div class="latest-avi-grid">
              {latestStatements.map((item) => (
                <a class="latest-avi-card" href={`/press/${item.id}/`}>
                  <time datetime={item.data.date.toISOString()}>{displayStatementDate(item.data.date)}</time>
                  <h3>{item.data.title}</h3>
                  <span class="latest-avi-link">Read the statement →</span>
                </a>
              ))}
            </div>
          </>
        )}
        {latestNews.length > 0 && (
          <div class="in-the-news">
            <div class="itn-head">
              <p class="itn-label">In the news</p>
              <a class="itn-all" href="/news/">All news →</a>
            </div>
            <ul class="itn-list">
              {latestNews.map((item) => (
                <li>
                  <a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.title}</a>
                  <span>{item.data.sourceName}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {latestVideo && (
    <section class="watch-strip" id="watch-strip">
      <p class="eyebrow watch-eyebrow">From our YouTube channel</p>
      <div class="watch-inner">
        <a class="watch-thumb" id="watch-link" href={latestVideo.url} target="_blank" rel="noopener">
          <img id="watch-img" src={latestVideo.thumb} alt={latestVideo.title} loading="lazy" width="480" height="360" />
          <span class="play-badge" aria-hidden="true">▶</span>
        </a>
        <div class="watch-copy">
          <h2 id="watch-title">{latestVideo.title}</h2>
          <p id="watch-summary">{latestVideo.summary}</p>
          <div class="watch-links">
            <a class="btn btn-secondary" id="watch-cta" href={latestVideo.url} target="_blank" rel="noopener">Watch on YouTube →</a>
            <a href="/media/">More videos →</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <script type="application/json" id="watch-video-data" set:html={JSON.stringify(orderedVideos).replace(/</g, '\\u003c')} />
  <script>
    const videos = JSON.parse(document.getElementById('watch-video-data')?.textContent || '[]');
    const strip = document.getElementById('watch-strip');
    const img = document.getElementById('watch-img');
    const titleEl = document.getElementById('watch-title');
    const summaryEl = document.getElementById('watch-summary');
    const link = document.getElementById('watch-link');
    const cta = document.getElementById('watch-cta');

    if (strip && videos.length > 1) {
      const ROTATE_MS = 9000;
      const FADE_MS = 250;
      let currentIndex = 0; // matches the server-rendered featured video
      let paused = false;
      let timer;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function pickNext() {
        let next;
        do { next = Math.floor(Math.random() * videos.length); } while (next === currentIndex);
        return next;
      }

      function render(index) {
        const v = videos[index];
        img.style.opacity = '0';
        link.style.opacity = '0';
        setTimeout(() => {
          img.src = v.thumb;
          img.alt = v.title;
          titleEl.textContent = v.title;
          summaryEl.textContent = v.summary;
          link.href = v.url;
          cta.href = v.url;
          img.style.opacity = '1';
          link.style.opacity = '1';
        }, FADE_MS);
      }

      function rotate() {
        if (paused) return;
        currentIndex = pickNext();
        render(currentIndex);
      }

      function startTimer() {
        clearInterval(timer);
        timer = setInterval(rotate, ROTATE_MS);
      }

      if (!reduceMotion) {
        startTimer();
        strip.addEventListener('mouseenter', () => { paused = true; });
        strip.addEventListener('mouseleave', () => { paused = false; });
        strip.addEventListener('focusin', () => { paused = true; });
        strip.addEventListener('focusout', () => { paused = false; });
      }
    }
  </script>

  <section class="breakout donate-pitch">
    <div class="breakout-inner donate-inner">
      <p class="eyebrow eyebrow-light">For those it's already helped</p>
      <h2>Quit smoking because you found a safer alternative?</h2>
      <p>
        AVI exists because harm reduction worked for people like you, and we
        want it available to the millions still smoking. This work — litigation,
        evidence review, correcting misinformation — is funded entirely by
        individual contributions, not industry.{' '}
        {testimonialCount >= 10
          ? <a href="/testimonials/">Read {testimonialCount}+ stories from people it's helped →</a>
          : <a href="/testimonials/">Read their stories →</a>}
      </p>
      <a class="btn btn-primary" href="/contribute/">Support this work →</a>
    </div>
  </section>

  <section class="breakout stay-connected">
    <div class="breakout-inner stay-connected-inner">
      <div class="stay-connected-share">
        <p class="sc-share-label">Know someone who should see this?</p>
        <ShareButtons title="Association of Vapers India — tobacco harm reduction advocacy for India" />
      </div>
    </div>
  </section>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--green-deep);
      margin: 0 0 0.75rem;
    }
    .eyebrow-light { color: var(--paper); }

    /* Hero */
    .hero-v2 { background: var(--paper); padding: 2.25rem 0 1.75rem; }
    .hero-copy .eyebrow { display: flex; align-items: center; gap: 0.5rem; }
    .hero-copy .eyebrow :global(svg) { width: 1.05rem; height: 1.05rem; flex-shrink: 0; }
    .hero-v2-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: stretch;
    }
    .hero-copy { display: flex; flex-direction: column; min-width: 0; }
    .hero-bottom { margin-top: auto; }
    .hero-org-line {
      margin: 0 0 0.5rem;
      font-size: 0.95rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--green-deep);
    }
    .hero-v2 h1 {
      color: var(--ink);
      font-size: clamp(2.1rem, 3.8vw, 3rem);
      margin: 0 0 1.25rem;
    }
    .hero-v2 h1 em { font-style: italic; color: var(--rust); }
    .hero-v2 .hero-sub {
      font-size: 1.05rem;
      color: var(--muted);
      max-width: 34rem;
      margin: 0 0 1.65rem;
    }
    .hero-v2 .hero-ctas { display: flex; gap: 0.6rem; flex-wrap: nowrap; margin-bottom: 1.5rem; }
    .hero-v2 .hero-ctas .btn { flex: 1 1 auto; text-align: center; white-space: nowrap; }
    /* India's figures (item 3) sit beside the global ones, each group with
       its own label and source line, rather than merged into one
       undifferentiated row of five numbers. */
    .hero-stats-group { padding-top: 1.1rem; border-top: 1px solid var(--line); }
    .hero-stats-group + .hero-stats-group { padding-top: 0.9rem; border-top: none; }
    .hero-stats-label {
      margin: 0 0 0.5rem;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }
    .hero-v2 .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .hero-v2 .hero-stats.hero-stats-india { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 20rem; }
    .hero-v2 .hero-stats strong {
      display: block;
      font-family: var(--font-serif);
      font-size: 1.7rem;
      color: var(--green-deep);
      line-height: 1;
      white-space: nowrap;
    }
    .hero-v2 .hero-stats span { display: block; font-size: 0.8rem; line-height: 1.25; color: var(--muted); margin-top: 0.15rem; }
    @media (max-width: 480px) {
      .hero-v2 .hero-ctas { margin-bottom: 1.25rem; }
      .hero-v2 .hero-ctas .btn { font-size: 0.8rem; padding: 0.5rem 0.75rem; }
      .hero-stats-group { padding-top: 0.85rem; }
      .hero-v2 .hero-stats { gap: 0.4rem; }
      .hero-v2 .hero-stats strong { font-size: 1.3rem; }
      .hero-v2 .hero-stats span { font-size: 0.7rem; line-height: 1.15; margin-top: 0.1rem; }
      .hero-v2 .hero-stats-source { margin-top: 0.5rem; }
    }
    .hero-v2 .hero-stats-source { margin: 0.85rem 0 0; font-size: 0.75rem; color: var(--muted); }
    .hero-photo-wrap figure {
      margin: 0;
      border-radius: 14px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 12px 30px rgba(20,25,20,0.14);
    }
    .hero-photo-wrap img { width: 100%; display: block; aspect-ratio: 4/3; object-fit: cover; }
    /* Above the breakpoint where the hero is two columns: let the photo grow
       (and crop, via object-fit: cover) to match whichever column is
       naturally taller, instead of only being able to match via the
       .hero-bottom margin-top:auto trick below — that only pulls the left
       column's stats/Sources down to meet a taller photo; it can't do
       anything when the TEXT is the taller side, which is exactly what
       varies by viewport width as the paragraph reflows. Making the photo
       side stretchable too covers both directions. */
    @media (min-width: 901px) {
      .hero-photo-wrap { display: flex; flex-direction: column; }
      .hero-photo-wrap figure { flex: 1 1 auto; min-height: 0; }
      .hero-photo-wrap img { height: 100%; aspect-ratio: auto; }
    }
    /* Caption sits below the photo, not laid over it. */
    .hero-photo-wrap .photo-tag {
      display: block;
      color: var(--muted);
      font-size: 0.8rem;
      padding: 0.5rem 0 0;
      margin: 0;
    }
    .hero-photo-caption { margin: 0.85rem 0 0; font-size: 0.88rem; color: var(--muted); font-style: italic; }
    .hero-photo-caption a { display: block; margin-top: 0.3rem; font-style: normal; font-size: 0.82rem; }
    /* At the two-column width, the photo column tops out around 515px —
       too narrow for the caption sentence at its default size, so it wraps
       to 2 lines. Shrink it (same ratio between caption/link) just for that
       range so it reliably fits on one line, with the link a clean second
       line below it. */
    @media (min-width: 900px) {
      .hero-photo-caption { font-size: 0.78rem; }
      .hero-photo-caption a { font-size: 0.73rem; }
    }
    @media (max-width: 900px) {
      .hero-v2-inner { grid-template-columns: 1fr; }
    }

    /* Three paths */
    .paths { background: var(--paper); padding: 2rem 0 1.75rem; }
    .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .path-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.4rem 1.3rem;
    }
    .path-card :global(svg) { width: 1.75rem; height: 1.75rem; margin-bottom: 0.75rem; }
    .path-card h3 { margin: 0 0 0.5rem; font-size: 1.15rem; }
