---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const latestNews = (await getCollection('news', ({ data }) => data.reviewed))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const latestResearch = (await getCollection('research', ({ data }) => data.reviewed))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const videoData = (await getCollection('videos'))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .map((v) => ({
    title: v.data.title,
    summary: v.data.summary,
    thumb: v.data.thumbnailUrl,
    url: `https://www.youtube.com/watch?v=${v.data.videoId}`,
  }));
const latestVideo = videoData[0];

const testimonialCount = (await getCollection('testimonials', ({ data }) => data.reviewed)).length;
const litigationCount = (await getCollection('litigation')).length;
const pressCount = (await getCollection('press')).length;
const researchCount = (await getCollection('research', ({ data }) => data.reviewed)).length;
const submissionsCount = (await getCollection('submissions')).length;
const yearsActive = new Date().getFullYear() - 2016;
---
<Base title="Home" wide={true}>
  <section class="breakout hero-v2">
    <div class="breakout-inner hero-v2-inner">
      <div class="hero-copy">
        <h1>Still smoking? There's a <em>safer path forward.</em></h1>
        <p class="hero-sub">
          If nicotine gums and patches haven't worked for you, or you're not
          ready to quit nicotine entirely, there are lower-risk ways of
          consuming it. We've spent a decade reviewing the evidence and
          fighting in court for your right to know about them.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/science">See the evidence →</a>
          <a class="btn btn-outline" href="/india/law">What the law says →</a>
        </div>
        <div class="hero-bottom">
          <div class="hero-stats">
            <div><strong>1.2B</strong><span>tobacco users worldwide</span></div>
            <div><strong>7M+</strong><span>deaths/year</span></div>
            <div><strong>200M+</strong><span>switched to safer alternatives</span></div>
          </div>
          <p class="hero-stats-source">
            Sources: <a href="https://gsthr.org/resources/thr-reports/the-global-state-of-tobacco-harm-reduction-2026-a-situation-report/" target="_blank" rel="noopener">GSTHR, 2026</a> · <a href="https://www.who.int/news-room/fact-sheets/detail/tobacco" target="_blank" rel="noopener">WHO, 2026</a>
          </p>
        </div>
      </div>
      <div class="hero-photo-wrap">
        <figure>
          <img src="/images/campaigns/bengaluru-protest-toi.jpg" alt="A vaper holding a 'Vaping Ends Smoking' placard at AVI's nationwide protest against the e-cigarette ban, Bengaluru, 28 September 2019" />
          <figcaption class="photo-tag">India Vape Ban Protest — six cities, 28 September 2019</figcaption>
        </figure>
        <p class="hero-photo-caption">A consumer movement: former smokers who organised, litigated and kept showing up. <a href="https://timesofindia.indiatimes.com/india/vapers-hold-nationwide-protest-against-ban-on-e-cigarettes/articleshow/71351824.cms" target="_blank" rel="noopener">Photo: Times of India →</a></p>
      </div>
    </div>
  </section>

  <section class="breakout paths">
    <div class="breakout-inner">
      <div class="path-grid">
        <div class="path-card path-green">
          <Icon name="heart" />
          <h3>If you smoke, or use gutka, khaini or other toxic SLT</h3>
          <p>See the evidence on lower-risk ways to keep using nicotine, and how people have quit combustible tobacco successfully with them.</p>
          <a href="/quit">How to quit with safer alternatives →</a>
        </div>
        <div class="path-card path-gold">
          <Icon name="scale" />
          <h3>Policymakers</h3>
          <p>The global policy case for tobacco harm reduction — what's working elsewhere, what isn't, and what it means for India.</p>
          <a href="/policy">See the policy case →</a>
        </div>
        <div class="path-card path-rust">
          <Icon name="megaphone" />
          <h3>Media</h3>
          <p>AVI has been quoted, interviewed and bylined on tobacco harm reduction in India for over a decade. We're always available for comment.</p>
          <a href="/press">Press coverage &amp; contact →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="breakout what-we-do">
    <div class="breakout-inner">
      <p class="eyebrow eyebrow-light">What AVI does</p>
      <h2>A decade of evidence, litigation and advocacy</h2>
      <p class="wwd-summary">
        AVI reviews the international evidence on safer nicotine products,
        fights bans and restrictions in court, petitions policymakers
        directly, and puts the case for harm reduction in front of the
        press — all funded by individual contributions, not industry.
      </p>
      <div class="wwd-stats">
        <div><strong>{litigationCount}</strong><span>court cases fought since 2017</span></div>
        <div><strong>{pressCount}+</strong><span>press features</span></div>
        <div><strong>{researchCount}</strong><span>studies in our evidence library</span></div>
        <div><strong>{submissionsCount}</strong><span>submissions to policymakers</span></div>
        <div><strong>{yearsActive}+</strong><span>years of advocacy</span></div>
      </div>
      <nav class="wwd-tabs" aria-label="AVI's work">
        <a href="/science">Evidence →</a>
        <a href="/litigation">Litigation →</a>
        <a href="/press">Press →</a>
        <a href="/submissions">Submissions →</a>
        <a href="/campaigns">Campaigns →</a>
      </nav>
    </div>
  </section>

  <section class="feed-section">
    <div class="feed-tabbar">
      <div class="feed-tabs" role="tablist" aria-label="Latest updates">
        <button type="button" class="feed-tab active" role="tab" aria-selected="true" aria-controls="feed-panel-news" id="feed-tab-news" data-target="news">Latest news</button>
        <button type="button" class="feed-tab" role="tab" aria-selected="false" aria-controls="feed-panel-research" id="feed-tab-research" data-target="research">Evidence library</button>
      </div>
      <a class="feed-all" id="feed-all-link" href="/news">All news →</a>
    </div>
    <div class="feed-panels">
      <ul class="feed-list feed-news" id="feed-panel-news" role="tabpanel" aria-labelledby="feed-tab-news">
        {latestNews.map((item) => (
          <li>
            <a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.title}</a>
            <span>{item.data.sourceName}</span>
          </li>
        ))}
      </ul>
      <ul class="feed-list feed-research" id="feed-panel-research" role="tabpanel" aria-labelledby="feed-tab-research" hidden>
        {latestResearch.map((item) => (
          <li>
            <a href={`/science/${item.id}`}>{item.data.title}</a>
            <span>{item.data.journal}, {item.data.year}</span>
          </li>
        ))}
      </ul>
    </div>
    <p class="legal-note">
      Electronic cigarettes are banned in India under the Prohibition of
      Electronic Cigarettes Act, 2019 (PECA). <a href="/india/law">Read what this means for you →</a>
    </p>
  </section>

  <script>
    const feedTabs = document.querySelectorAll('.feed-tab');
    const feedAllLink = document.getElementById('feed-all-link');
    const feedTargets: Record<string, { panel: string; href: string; label: string }> = {
      news: { panel: 'feed-panel-news', href: '/news', label: 'All news →' },
      research: { panel: 'feed-panel-research', href: '/science', label: 'Full library →' },
    };
    feedTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.target;
        if (!target) return;
        feedTabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('active', active);
          t.setAttribute('aria-selected', String(active));
        });
        Object.entries(feedTargets).forEach(([key, { panel }]) => {
          document.getElementById(panel)?.toggleAttribute('hidden', key !== target);
        });
        const info = feedTargets[target];
        if (info && feedAllLink) {
          feedAllLink.setAttribute('href', info.href);
          feedAllLink.textContent = info.label;
        }
      });
    });
  </script>

  {latestVideo && (
    <section class="watch-strip" id="watch-strip">
      <p class="eyebrow watch-eyebrow">From our YouTube channel</p>
      <div class="watch-inner">
        <a class="watch-thumb" id="watch-link" href={latestVideo.url} target="_blank" rel="noopener">
          <img id="watch-img" src={latestVideo.thumb} alt={latestVideo.title} loading="lazy" />
          <span class="play-badge" aria-hidden="true">▶</span>
        </a>
        <div class="watch-copy">
          <h2 id="watch-title">{latestVideo.title}</h2>
          <p id="watch-summary">{latestVideo.summary}</p>
          <div class="watch-links">
            <a class="btn btn-outline" id="watch-cta" href={latestVideo.url} target="_blank" rel="noopener">Watch on YouTube →</a>
            <a href="/media">More videos →</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <script type="application/json" id="watch-video-data" set:html={JSON.stringify(videoData).replace(/</g, '\\u003c')} />
  <script>
    const videos = JSON.parse(document.getElementById('watch-video-data')?.textContent || '[]');
    const strip = document.getElementById('watch-strip');
    const img = document.getElementById('watch-img');
    const titleEl = document.getElementById('watch-title');
    const summaryEl = document.getElementById('watch-summary');
    const link = document.getElementById('watch-link');
    const cta = document.getElementById('watch-cta');

    if (strip && videos.length > 1) {
      const ROTATE_MS = 9000;
      const FADE_MS = 250;
      let currentIndex = 0; // matches the server-rendered latest video
      let paused = false;
      let timer;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function pickNext() {
        let next;
        do { next = Math.floor(Math.random() * videos.length); } while (next === currentIndex);
        return next;
      }

      function render(index) {
        const v = videos[index];
        img.style.opacity = '0';
        link.style.opacity = '0';
        setTimeout(() => {
          img.src = v.thumb;
          img.alt = v.title;
          titleEl.textContent = v.title;
          summaryEl.textContent = v.summary;
          link.href = v.url;
          cta.href = v.url;
          img.style.opacity = '1';
          link.style.opacity = '1';
        }, FADE_MS);
      }

      function rotate() {
        if (paused) return;
        currentIndex = pickNext();
        render(currentIndex);
      }

      function startTimer() {
        clearInterval(timer);
        timer = setInterval(rotate, ROTATE_MS);
      }

      if (!reduceMotion) {
        startTimer();
        strip.addEventListener('mouseenter', () => { paused = true; });
        strip.addEventListener('mouseleave', () => { paused = false; });
        strip.addEventListener('focusin', () => { paused = true; });
        strip.addEventListener('focusout', () => { paused = false; });
      }
    }
  </script>

  <section class="breakout donate-pitch">
    <div class="breakout-inner donate-inner">
      <p class="eyebrow eyebrow-light">For those it's already helped</p>
      <h2>Quit smoking because you found a safer alternative?</h2>
      <p>
        AVI exists because harm reduction worked for people like you, and we
        want it available to the millions still smoking. This work — litigation,
        evidence review, correcting misinformation — is funded entirely by
        individual contributions, not industry.{' '}
        {testimonialCount > 0
          ? <a href="/testimonials">Read {testimonialCount}+ stories from people it's helped →</a>
          : <a href="/testimonials">Read stories from people it's helped →</a>}
      </p>
      <a class="btn btn-gold" href="/contribute">Support this work →</a>
    </div>
  </section>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-dark);
      margin: 0 0 0.75rem;
    }
    .eyebrow-light { color: var(--gold-light); }

    /* Hero */
    .hero-v2 { background: var(--paper); padding: 2.25rem 0 1.75rem; }
    .hero-v2-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: stretch;
    }
    .hero-copy { display: flex; flex-direction: column; min-width: 0; }
    .hero-bottom { margin-top: auto; }
    .hero-v2 h1 {
      color: var(--ink-black);
      font-size: clamp(2.1rem, 3.8vw, 3rem);
      margin: 0 0 1.25rem;
    }
    .hero-v2 h1 em { font-style: italic; color: var(--rust); }
    .hero-v2 .hero-sub {
      font-size: 1.05rem;
      color: var(--muted);
      max-width: 34rem;
      margin: 0 0 1.65rem;
    }
    .hero-v2 .hero-ctas { display: flex; gap: 0.6rem; flex-wrap: nowrap; margin-bottom: 1.5rem; }
    .hero-v2 .hero-ctas .btn { flex: 1 1 auto; text-align: center; white-space: nowrap; }
    .hero-v2 .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
      padding-top: 1.4rem;
      border-top: 1px solid var(--border);
    }
    .hero-v2 .hero-stats strong {
      display: block;
      font-family: var(--font-serif);
      font-size: 1.7rem;
      color: var(--gold-dark);
      line-height: 1;
      white-space: nowrap;
    }
    .hero-v2 .hero-stats span { display: block; font-size: 0.8rem; line-height: 1.25; color: var(--muted); margin-top: 0.15rem; }
    @media (max-width: 480px) {
      .hero-v2 .hero-ctas { margin-bottom: 1.25rem; }
      .hero-v2 .hero-ctas .btn { font-size: 0.8rem; padding: 0.5rem 0.75rem; }
      .hero-v2 .hero-stats { gap: 0.4rem; padding-top: 1rem; }
      .hero-v2 .hero-stats strong { font-size: 1.3rem; }
      .hero-v2 .hero-stats span { font-size: 0.7rem; line-height: 1.15; margin-top: 0.1rem; }
      .hero-v2 .hero-stats-source { margin-top: 0.5rem; }
    }
    .hero-v2 .hero-stats-source { margin: 0.85rem 0 0; font-size: 0.75rem; color: var(--muted); }
    .hero-photo-wrap figure {
      margin: 0;
      border-radius: 14px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 12px 30px rgba(20,25,20,0.14);
    }
    .hero-photo-wrap img { width: 100%; display: block; aspect-ratio: 4/3; object-fit: cover; }
    /* Above the breakpoint where the hero is two columns: let the photo grow
       (and crop, via object-fit: cover) to match whichever column is
       naturally taller, instead of only being able to match via the
       .hero-bottom margin-top:auto trick below — that only pulls the left
       column's stats/Sources down to meet a taller photo; it can't do
       anything when the TEXT is the taller side, which is exactly what
       varies by viewport width as the paragraph reflows. Making the photo
       side stretchable too covers both directions. */
    @media (min-width: 901px) {
      .hero-photo-wrap { display: flex; flex-direction: column; }
      .hero-photo-wrap figure { flex: 1 1 auto; min-height: 0; }
      .hero-photo-wrap img { height: 100%; aspect-ratio: auto; }
    }
    .hero-photo-wrap .photo-tag {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      background: rgba(18,19,15,0.72);
      color: #fff;
      font-size: 0.8rem;
      padding: 0.55rem 0.9rem;
      margin: 0;
    }
    .hero-photo-caption { margin: 0.85rem 0 0; font-size: 0.88rem; color: var(--muted); font-style: italic; }
    .hero-photo-caption a { font-style: normal; font-size: 0.82rem; }
    @media (max-width: 900px) {
      .hero-v2-inner { grid-template-columns: 1fr; }
    }

    /* Three paths */
    .paths { background: var(--paper); padding: 2rem 0 1.75rem; }
    .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .path-card {
      background: #fff;
      border-radius: 6px;
      padding: 1.4rem 1.3rem;
      border-top: 4px solid;
      box-shadow: 0 1px 3px rgba(20,25,20,0.06);
    }
    .path-card :global(svg) { width: 1.75rem; height: 1.75rem; margin-bottom: 0.75rem; }
    .path-card h3 { margin: 0 0 0.5rem; font-size: 1.15rem; }
    .path-card p { color: var(--muted); font-size: 0.92rem; margin: 0 0 1rem; }
    .path-card a { font-weight: 600; font-size: 0.9rem; text-decoration: none; }
    .path-green { border-color: var(--accent); }
    .path-green :global(svg) { color: var(--accent); }
    .path-green a { color: var(--accent-dark); }
    .path-gold { border-color: var(--gold); }
    .path-gold :global(svg) { color: var(--gold); }
    .path-gold a { color: var(--gold-dark); }
    .path-rust { border-color: var(--rust); }
    .path-rust :global(svg) { color: var(--rust); }
    .path-rust a { color: var(--rust-dark); }
    @media (max-width: 780px) {
      .path-grid { grid-template-columns: 1fr; }
    }

    /* What does AVI do */
    .what-we-do {
      background: linear-gradient(rgba(18,60,49,0.92), rgba(18,60,49,0.92)), url('/images/backgrounds/mountain-sunrise.jpg');
      background-size: cover;
      background-position: center;
      color: #fff;
      padding: 2.25rem 0;
    }
    .what-we-do h2 { color: #fff; margin: 0 0 0.85rem; font-size: clamp(1.4rem, 3vw, 1.9rem); }
    .wwd-summary { color: #cfe0d8; max-width: 42rem; font-size: 1rem; line-height: 1.6; margin: 0 0 1.75rem; }
    .wwd-stats {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
      padding-bottom: 1.5rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.15);
    }
    .wwd-stats strong {
      display: block;
      font-family: var(--font-serif);
      font-size: 2rem;
      color: var(--gold-light);
      line-height: 1;
      margin-bottom: 0.35rem;
    }
    .wwd-stats span { font-size: 0.82rem; color: #cfe0d8; line-height: 1.4; }
    .wwd-tabs { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .wwd-tabs a {
      color: #fff;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.25);
      text-decoration: none;
      font-size: 0.86rem;
      font-weight: 600;
      padding: 0.5rem 1.05rem;
      border-radius: 999px;
    }
    .wwd-tabs a:hover { background: rgba(255,255,255,0.22); color: #fff; }
    @media (max-width: 780px) {
      .wwd-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
    }

    /* Feed section — tabbed so News and Evidence share one compact slot
       instead of two full-height stacked/side-by-side lists. */
    .feed-section { max-width: var(--max-w-wide); margin: 1.5rem auto 0; padding: 0 1.5rem; }
    .feed-tabbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.9rem; flex-wrap: wrap; }
    .feed-tabs { display: flex; gap: 0.5rem; }
    .feed-tab {
      font: inherit;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--muted);
      background: var(--paper-alt);
      border: none;
      border-radius: 99px;
      padding: 0.45rem 1rem;
      cursor: pointer;
    }
    .feed-tab:hover { color: var(--ink); }
    .feed-tab.active { background: var(--accent-dark); color: #fff; }
    .feed-all { font-size: 0.85rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
    .feed-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
    .feed-list[hidden] { display: none; }
    .feed-list li {
      background: #fff;
      border: 1px solid var(--border);
      border-left: 3px solid var(--border);
      border-radius: 6px;
      padding: 0.55rem 0.9rem;
    }
    .feed-news li { border-left-color: var(--gold); }
    .feed-research li { border-left-color: var(--accent); }
    .feed-list a {
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      color: var(--ink);
      margin-bottom: 0.15rem;
    }
    .feed-list a:hover { color: var(--accent); }
    .feed-list span { font-size: 0.78rem; color: var(--muted); }
    .legal-note { font-size: 0.88rem; color: var(--muted); border-top: 1px solid var(--border); padding-top: 1.1rem; margin-top: 1.25rem; margin-bottom: 0; }

    /* Watch strip */
    .watch-strip { max-width: var(--max-w-wide); margin: 1.5rem auto 0; padding: 0 1.5rem; }
    .watch-inner {
      display: grid;
      grid-template-columns: 13rem 1fr;
      gap: 1.5rem;
      align-items: center;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.15rem;
    }
    .watch-thumb { position: relative; display: block; border-radius: 6px; overflow: hidden; line-height: 0; transition: opacity 0.25s ease; }
    .watch-thumb img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; transition: opacity 0.25s ease; }
    .watch-thumb .play-badge {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 3rem; height: 3rem; border-radius: 50%;
      background: rgba(18,19,15,0.75); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
    }
    .watch-eyebrow { margin: 0 0 1rem; }
    .watch-copy h2 { margin: 0 0 0.5rem; font-size: 1.3rem; line-height: 1.35; }
    .watch-copy #watch-summary { margin: 0 0 1rem; color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
    .watch-links { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
    .watch-links a:not(.btn) { font-weight: 600; font-size: 0.9rem; }
    @media (max-width: 640px) {
      .watch-inner { grid-template-columns: 1fr; }
    }

    /* Donate */
    .donate-pitch {
      background: linear-gradient(rgba(125,58,31,0.88), rgba(179,85,46,0.92)), url('/images/campaigns/chennai-protest.jpg');
      background-size: cover;
      background-position: center;
      color: #fff;
      padding: 2rem 0;
      margin-top: 1.5rem;
    }
    .donate-inner { max-width: 40rem; }
    .donate-pitch h2 { color: #fff; margin: 0 0 1rem; font-size: 1.9rem; }
    .donate-pitch p { color: #fbe6db; }
    .donate-pitch a:not(.btn) { color: #fff; text-decoration-color: rgba(255,255,255,0.5); }
  </style>
</Base>
