---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import DecorativeRings from '../../components/DecorativeRings.astro';

// Rebuilt as a lean, ~300-word hub (legal pages rework, 2026-10-02) — was
// a longer "crisis being managed backwards" essay; that detail still
// lives on the pages this one now just points to.
const CARDS = [
  { href: '/india/law/', icon: 'scale', title: 'The law', desc: "What PECA bans, and what it doesn't." },
  { href: '/india/police/', icon: 'shield', title: 'Police & your rights', desc: 'Stopped over vaping? Know your rights.' },
  { href: '/india/flights/', icon: 'document', title: 'Flights', desc: 'Can you carry a vape on a flight?' },
  { href: '/nicotine-pouches/', icon: 'leaf', title: 'Nicotine pouches', desc: 'Legal status, safety, and what AVI wants.' },
  { href: '/india/smokeless-tobacco/', icon: 'heart', title: 'Smokeless tobacco', desc: 'The harm reduction case for 200 million SLT users.' },
  { href: '/india/rti-replies/', icon: 'quote', title: 'RTI replies', desc: "What the government admitted it doesn't know." },
  { href: '/litigation/', icon: 'megaphone', title: 'Litigation', desc: 'The court cases AVI has fought since 2017.' },
] as const;
---
<Base title="Vaping and Tobacco in India" description="Tobacco kills nearly 13.5 lakh Indians a year. The law, your rights with police and at airports, nicotine pouches, smokeless tobacco and AVI's litigation — all in one place." wide={true}>
  <section class="breakout india-hero">
    <DecorativeRings class="india-rings" />
    <div class="breakout-inner">
      <p class="eyebrow">Tobacco harm reduction in India</p>
      <h1>Vaping and tobacco in India</h1>
      <p class="hero-sub">
        Tobacco kills nearly 13.5 lakh Indians every year. Nearly 27 crore
        adults use it: about 10 crore smoke and 20 crore use gutka, khaini
        or other smokeless tobacco, and some do both. Cigarettes and bidis
        are sold everywhere. The safer alternatives are banned.
      </p>
      <p class="hero-sources">
        Sources: <a href="https://www.who.int/india/health-topics/tobacco" target="_blank" rel="noopener">WHO India</a> · <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10263025/" target="_blank" rel="noopener">GATS-2, 2016-17</a>
      </p>
    </div>
  </section>

  <section class="path-section">
    <div class="path-grid">
      {CARDS.map((c) => (
        <a class="path-card" href={c.href}>
          <Icon name={c.icon} />
          <h2>{c.title}</h2>
          <p>{c.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--paper);
      margin: 0 0 0.75rem;
    }
    .india-hero {
      background: var(--green-deep);
      padding: 3.5rem 0 3rem;
      position: relative;
      overflow: hidden;
    }
    .india-hero :global(.india-rings) {
      position: absolute;
      top: 50%;
      right: -10%;
      transform: translateY(-50%);
      width: 30rem;
      height: 30rem;
      max-width: 55vw;
      max-height: 55vw;
      color: var(--paper);
      opacity: 0.3;
    }
    .india-hero h1 {
      color: #fff;
      font-size: clamp(1.9rem, 3.8vw, 2.7rem);
      max-width: 36rem;
      margin: 0 0 1.1rem;
      position: relative;
    }
    .hero-sub { color: var(--paper-2); max-width: 38rem; font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.85rem; position: relative; }
    .hero-sources { color: var(--paper-2); font-size: 0.82rem; margin: 0; position: relative; opacity: 0.9; }
    .hero-sources a { color: var(--paper-2); text-decoration: underline; }

    .path-section { max-width: var(--max-w-wide); margin: 0 auto; padding: 3rem 1.5rem 4rem; }
    .path-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(14.5rem, 100%), 1fr)); gap: 1.5rem; }
    .path-card {
      display: block;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.5rem 1.4rem;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }
    .path-card:hover { transform: translateY(-2px); }
    .path-card :global(svg) { width: 1.7rem; height: 1.7rem; color: var(--green); margin-bottom: 0.85rem; }
    .path-card h2 { margin: 0 0 0.4rem; font-size: 1.05rem; }
    .path-card p { color: var(--muted); font-size: 0.88rem; margin: 0; line-height: 1.5; }
  </style>
</Base>
