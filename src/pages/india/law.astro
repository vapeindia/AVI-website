---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getGitDates, formatDate } from '../../lib/git-dates';
import { PECA_ACT, PECA_BANNED, PECA_NOT_BANNED, PECA_SECTIONS, pecaBannedSentence } from '../../data/peca';

// Reworked (legal pages rework, 2026-10-02): "Know your rights" moved out
// to /india/police/, the flight-ban material to /india/flights/, and the
// embedded nicotine-pouches section cut to a two-line pointer at
// /nicotine-pouches/legal-status/ — this page was carrying all of that at
// once. 900 words max of visible prose, not counting the two collapsed
// boxes (transport argument, Act text).
//
// TRANSPORT_SUMMARY is a from-scratch 120-word condensation of
// PECA_TRANSPORT_DRAFT (src/data/peca.ts) for this page's collapsed box —
// the canonical, fuller argument stays in peca.ts rather than being
// edited down in place, per that file's own "don't paraphrase in place"
// convention for legal text.
const TRANSPORT_SUMMARY = `Section 4(i) bans "transport" of e-cigarettes without the word "for sale" attached — that qualifier only appears in Section 5, about disposing of pre-Act stock. Read alone, "transport" could mean a vaper carrying their own device.

AVI doesn't read it that way, and said so in its own submission in the Delhi flight-ban case. Every other word in the same list — produce, manufacture, import, export, sell, distribute — describes a commercial supply chain, so "transport" should be read the same way: a word is known by the company it keeps. This is AVI's litigation position in a case where judgment is reserved, not a court's ruling.`;
const transportParas = TRANSPORT_SUMMARY.split('\n\n');

const definitionParas = PECA_SECTIONS.definition.text.split('\n\n');

const lawDates = getGitDates('src/pages/india/law.astro');

const SHORT_ANSWER = "Selling vapes is banned in India. Using or owning one is not. The Prohibition of Electronic Cigarettes Act, 2019 (PECA) bans the business of e-cigarettes: making, importing, exporting, transporting, selling, distributing, storing and advertising them. No section makes personal use or possession an offence, and none sets a penalty for it.";

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Is Vaping Legal in India? Use, Possession and the 2019 Ban',
  datePublished: lawDates.published,
  dateModified: lawDates.modified,
  author: { '@type': 'Person', name: 'Samrat Chowdhery', jobTitle: 'Founder-director, Association of Vapers India' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is vaping legal in India?',
      acceptedAnswer: { '@type': 'Answer', text: SHORT_ANSWER },
    },
    {
      '@type': 'Question',
      name: 'Is it illegal to carry or possess an e-cigarette in India?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `No. PECA's bans apply only to commercial acts — ${pecaBannedSentence()}. Personal possession and carrying a device for your own use are not banned, and no provision in PECA makes either an offence.`,
      },
    },
    {
      '@type': 'Question',
      name: 'What are the penalties under PECA?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Up to one year's imprisonment or a ₹1 lakh fine (or both) for a first offence under Section 4 — rising to three years and ₹5 lakh for repeat offences. Storing stock carries up to six months or a ₹50,000 fine under Section 5. None of this attaches to personal use or possession.",
      },
    },
  ],
};
---
<Base
  title="Is Vaping Legal in India? Use, Possession and the 2019 Ban"
  rawTitle={true}
  description="Selling vapes is banned in India. Using or possessing one is not. What the 2019 Act bans, the penalties and what the government itself has said."
  image="/og/india-law.png"
  wide={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <section class="breakout law-hero">
    <div class="breakout-inner">
      <p class="eyebrow">Updated {formatDate(lawDates.modified)}</p>
      <h1>Is vaping legal in India?</h1>
      <p class="law-hero-sub">What the 2019 Act bans, and what it doesn't.</p>
    </div>
  </section>

  <div class="law-body">
    <p class="page-authority">
      By Samrat Chowdhery, founder-director, AVI · Last reviewed {formatDate(lawDates.modified)}
      <span class="authority-note">· This is AVI's understanding of the law, not formal legal advice.</span>
    </p>
    <p class="short-answer">{SHORT_ANSWER}</p>
    <div class="law-share">
      <ShareButtons title="Is vaping legal in India? Here's what the law actually says." />
    </div>

    <div class="law-prose">
      <div class="banned-split">
        <div class="banned-col banned-yes">
          <p class="split-label"><Icon name="close" /> Banned under PECA</p>
          <ul>
            {PECA_BANNED.map((item) => <li>{item.label} <a href={`#section-${item.section.match(/^\d+/)}`} class="cite">s.{item.section}</a></li>)}
          </ul>
        </div>
        <div class="banned-col banned-no">
          <p class="split-label"><Icon name="check" /> Not banned</p>
          <ul>
            {PECA_NOT_BANNED.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <h2><Icon name="scale" /> Penalties</h2>
      <p>
        A first offence against Section {PECA_SECTIONS.s4.number} — any of
        the business acts above except storage — carries up to one year's
        imprisonment or a ₹1 lakh fine, or both; a repeat offence rises to
        three years and ₹5 lakh (<a href="#section-7" class="cite">s.{PECA_SECTIONS.s7.number}</a>). Storing stock is a separate
        offence under Section {PECA_SECTIONS.s5.number}, carrying up to six
        months or a ₹50,000 fine (<a href="#section-8" class="cite">s.{PECA_SECTIONS.s8.number}</a>). No section sets a
        penalty for personal use or possession, because none bans it.
      </p>

      <h2><Icon name="document" /> Why some people say vaping is banned</h2>
      <ol class="rebuttal-timeline">
        <li><strong>A Health Ministry claim, 2023.</strong> In a court case over the flight ban, the Ministry argued that banning sale and import <em>implies</em> use is banned too. Law doesn't work that way — an offence needs its own provision and penalty, and neither exists here.</li>
        <li><strong>Parliament was told the opposite.</strong> The then Health Minister <a href="https://twitter.com/vapeindia/status/1200639227425366017?t=UZhVQ7iMF4hDjVOPfSiiZw&s=19" target="_blank" rel="noopener">assured Parliament</a> during the ENDS bill debate that use and possession would not be banned.</li>
        <li><strong>The Ministry's own earlier position.</strong> Months before PECA passed, its <a href="https://twitter.com/MoHFW_INDIA/status/1174325122993278977?t=6X-kwOEHGvSL3ndHKTj9uQ&s=19" target="_blank" rel="noopener">official Twitter account stated</a> plainly that use and possession are not banned.</li>
        <li><strong>The Home Ministry agrees.</strong> A separate <a href="https://www.mha.gov.in/sites/default/files/CSDiv_ecigerete_12122019.pdf" target="_blank" rel="noopener">circular (point C)</a> confirms personal use and possession is not a crime.</li>
        <li><strong>Legal experts concur.</strong> Independent lawyers have reached the <a href="/documents/senior-advocate-opinion-vaping-possession.mp4" target="_blank" rel="noopener">same conclusion</a> — no provision in the Act creates this offence.</li>
      </ol>

      <details class="primary-source">
        <summary>What about "transport"? — AVI's litigation position, 120 words</summary>
        {transportParas.map((para) => <p>{para}</p>)}
      </details>

      <div class="law-links">
        <a href="/india/police/" class="related-card">
          <h3>Stopped by police? →</h3>
          <p>Know your rights, and what to do if an officer claims otherwise.</p>
        </a>
        <a href="/india/flights/" class="related-card">
          <h3>Flying with a vape? →</h3>
          <p>A separate rule — airport security bans it in all baggage.</p>
        </a>
      </div>

      <h2><Icon name="leaf" /> Nicotine pouches and snus</h2>
      <p class="pouch-note">
        Pouches and snus involve no vapour, so they sit outside PECA
        entirely — but a separate two-agency regulatory freeze means
        there's no legal way to sell one either. <a href="/nicotine-pouches/legal-status/">Full breakdown →</a>
      </p>

      <details class="primary-source">
        <summary>Read the Act itself — the definition, and Sections {PECA_SECTIONS.s4.number}, {PECA_SECTIONS.s5.number}, {PECA_SECTIONS.s7.number} and {PECA_SECTIONS.s8.number}, verbatim</summary>
        <p class="source-note">
          Transcribed from {PECA_ACT.gazetteCitation} ({PECA_ACT.commonName}, Act No. {PECA_ACT.actNumber}) —
          <a href={PECA_ACT.gazettePdf} target="_blank" rel="noopener">original Gazette PDF</a> ·
          <a href={PECA_ACT.indiaCodeUrl} target="_blank" rel="noopener">India Code</a>
        </p>
        <div class="act-section" id="section-definition">
          <h4>Section {PECA_SECTIONS.definition.number} — {PECA_SECTIONS.definition.heading}</h4>
          {definitionParas.map((para) => <pre>{para}</pre>)}
        </div>
        <div class="act-section" id="section-4">
          <h4>Section {PECA_SECTIONS.s4.number} — {PECA_SECTIONS.s4.heading}</h4>
          <pre>{PECA_SECTIONS.s4.text}</pre>
        </div>
        <div class="act-section" id="section-5">
          <h4>Section {PECA_SECTIONS.s5.number} — {PECA_SECTIONS.s5.heading}</h4>
          <pre>{PECA_SECTIONS.s5.text}</pre>
        </div>
        <div class="act-section" id="section-7">
          <h4>Section {PECA_SECTIONS.s7.number} — {PECA_SECTIONS.s7.heading}</h4>
          <pre>{PECA_SECTIONS.s7.text}</pre>
        </div>
        <div class="act-section" id="section-8">
          <h4>Section {PECA_SECTIONS.s8.number} — {PECA_SECTIONS.s8.heading}</h4>
          <pre>{PECA_SECTIONS.s8.text}</pre>
        </div>
      </details>

      <h2><Icon name="quote" /> Sources</h2>
      <ul class="sources-list">
        <li><a href={PECA_ACT.indiaCodeUrl} target="_blank" rel="noopener">{PECA_ACT.commonName}, Act No. {PECA_ACT.actNumber} — India Code</a></li>
        <li><a href={PECA_ACT.gazettePdf} target="_blank" rel="noopener">{PECA_ACT.gazetteCitation} — original Gazette PDF</a></li>
        <li><a href="https://www.mha.gov.in/sites/default/files/CSDiv_ecigerete_12122019.pdf" target="_blank" rel="noopener">Union Home Ministry circular, December 2019</a></li>
        <li><a href="https://twitter.com/MoHFW_INDIA/status/1174325122993278977?t=6X-kwOEHGvSL3ndHKTj9uQ&s=19" target="_blank" rel="noopener">Health Ministry's official statement, 2019</a></li>
        <li><a href="https://twitter.com/vapeindia/status/1200639227425366017?t=UZhVQ7iMF4hDjVOPfSiiZw&s=19" target="_blank" rel="noopener">Health Minister's assurance to Parliament, 2019</a></li>
      </ul>
    </div>

    <div class="law-related">
      <a href="/nicotine-pouches/" class="related-card">
        <h3>Nicotine pouches in India →</h3>
        <p>Their own section: legal status, safety, and what AVI wants.</p>
      </a>
      <a href="/litigation/" class="related-card">
        <h3>Litigation →</h3>
        <p>The court cases AVI has fought against state-level bans and the flight ban.</p>
      </a>
    </div>
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--paper);
      margin: 0 0 0.75rem;
    }
    .law-hero {
      background: var(--green-deep);
      padding: 3.25rem 0 2.75rem;
    }
    .law-hero h1 { color: #fff; margin: 0 0 0.85rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .law-hero-sub { color: var(--paper-2); font-size: 1.05rem; max-width: 38rem; margin: 0; }

    .law-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 2.75rem 1.5rem 4rem; }
    .primary-source {
      max-width: var(--max-w);
      margin: 1.75rem 0;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      background: var(--paper-2);
    }
    .primary-source summary { cursor: pointer; font-weight: 600; color: var(--green-deep); }
    .primary-source p { font-size: 0.92rem; line-height: 1.6; }
    .source-note { font-size: 0.82rem; color: var(--muted); margin: 0.9rem 0 1.2rem; }
    .source-note a { color: var(--green-deep); }
    .act-section { margin: 1.3rem 0; }
    .act-section h4 { margin: 0 0 0.5rem; font-size: 0.95rem; }
    .act-section pre {
      white-space: pre-wrap;
      font-family: inherit;
      font-size: 0.88rem;
      line-height: 1.6;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.9rem 1.1rem;
      margin: 0;
    }
    .page-authority {
      max-width: var(--max-w);
      font-size: 0.82rem;
      color: var(--muted);
      margin: 0 0 1.1rem;
    }
    .authority-note { display: block; margin-top: 0.2rem; font-style: italic; }
    @media (min-width: 640px) { .authority-note { display: inline; margin-top: 0; } }
    .cite {
      font-size: 0.7em;
      font-weight: 600;
      color: var(--green-deep);
      text-decoration: none;
      opacity: 0.75;
    }
    .cite:hover { opacity: 1; text-decoration: underline; }

    .law-share { margin: 0 0 1.75rem; max-width: var(--max-w); }

    .law-prose { max-width: var(--max-w); }
    .law-prose h2 {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.25rem;
      margin: 2.25rem 0 1rem;
    }
    .law-prose h2:first-child { margin-top: 0; }
    .law-prose h2 :global(svg) { width: 1.3rem; height: 1.3rem; color: var(--green); flex-shrink: 0; }

    .banned-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin: 0 0 1.75rem;
    }
    .banned-col {
      border-radius: 12px;
      padding: 1.1rem 1.25rem 1.25rem;
      border: 1px solid var(--line);
      background: var(--paper-2);
    }
    .banned-col ul { margin: 0; padding-left: 1.15rem; }
    .banned-col li { font-size: 0.9rem; line-height: 1.6; }
    .split-label {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin: 0 0 0.75rem;
    }
    .split-label :global(svg) { width: 1.05rem; height: 1.05rem; }
    .banned-yes .split-label { color: var(--rust); }
    .banned-yes .split-label :global(svg) { color: var(--rust); }
    .banned-no .split-label { color: var(--green-deep); }
    .banned-no .split-label :global(svg) { color: var(--green); }
    @media (max-width: 640px) {
      .banned-split { grid-template-columns: 1fr; }
    }

    .rebuttal-timeline {
      list-style: none;
      counter-reset: rebuttal;
      margin: 0 0 1.5rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .rebuttal-timeline li {
      counter-increment: rebuttal;
      position: relative;
      background: var(--paper-2);
      border-radius: 12px;
      padding: 0.9rem 1.1rem 0.9rem 3rem;
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .rebuttal-timeline li::before {
      content: counter(rebuttal);
      position: absolute;
      left: 0.9rem;
      top: 0.9rem;
      width: 1.4rem;
      height: 1.4rem;
      border-radius: 50%;
      background: var(--green);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .rebuttal-timeline strong { display: block; margin-bottom: 0.2rem; }

    .law-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
      gap: 1.1rem;
      margin: 1.75rem 0;
    }
    .pouch-note { font-size: 0.95rem; line-height: 1.6; }

    .sources-list { margin: 0 0 1.5rem; padding-left: 1.2rem; font-size: 0.9rem; line-height: 1.7; }

    .law-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      margin-top: 2.5rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--line);
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-2);
      border-radius: 12px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--green-deep); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
