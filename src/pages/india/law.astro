---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PullQuote from '../../components/PullQuote.astro';
import { getHarassmentStats } from '../../lib/harassment-stats';

const hStats = await getHarassmentStats();

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is vaping legal in India?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Yes. India's Prohibition of Electronic Cigarettes Act, 2019 (PECA) bans the production, sale, import, distribution and advertisement of e-cigarettes, but does not ban personal use. Vaping itself is not a criminal offence under PECA.",
      },
    },
    {
      '@type': 'Question',
      name: 'Is it illegal to carry or possess an e-cigarette in India?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "No. PECA's bans apply only to commercial acts — production, sale, import, distribution and advertisement. Personal possession and carrying a device for your own use are not banned, and no provision in PECA makes either an offence.",
      },
    },
    {
      '@type': 'Question',
      name: 'Are nicotine pouches or snus legal in India?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nicotine pouches and snus are not named in any specific ban, but have no lawful sale pathway in India for a different reason: FSSAI has not approved nicotine as a food additive, and imports are treated as case-by-case discretionary refusals.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can police fine someone for vaping or carrying a vape in India?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "There is no legal basis for a fine over personal vaping or possession. PECA's penalties — up to one year imprisonment and a ₹1 lakh fine — attach only to commercial acts like sale, production or import, not personal use.",
      },
    },
  ],
};
---
<Base title="Current law in India" description="Is vaping legal in India? What PECA actually bans (sale, production, import, advertisement) and doesn't ban (personal use and possession) — the law on e-cigarettes and nicotine pouches, as of today." wide={true}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <section class="breakout law-hero">
    <div class="breakout-inner">
      <p class="eyebrow">As of today</p>
      <h1>The law in India, as it stands</h1>
    </div>
  </section>

  <div class="law-body">
    <div class="status-grid">
      <div class="status-card status-banned">
        <Icon name="shield" />
        <h3>E-cigarettes &amp; ENDS</h3>
        <p class="status-tag">Sale banned — use is not</p>
        <p>PECA, 2019 bans production, sale, import and advertisement outright. Personal use and possession are <a href="#know-your-rights">not banned</a> — PECA has no provision that makes either an offence.</p>
      </div>
      <div class="status-card status-blocked">
        <Icon name="leaf" />
        <h3>Nicotine pouches &amp; snus</h3>
        <p class="status-tag">No lawful pathway</p>
        <p>Not named in any ban, but blocked by two separate mechanisms — no FSSAI approval to sell, and import treated as case-by-case discretionary refusal.</p>
      </div>
      <div class="status-card status-legal">
        <Icon name="heart" />
        <h3>NRT (gums, patches)</h3>
        <p class="status-tag">Legal &amp; regulated</p>
        <p>Regulated as medicines under the Drugs and Cosmetics Act, 1940, and actively supported by government as a cessation aid.</p>
      </div>
    </div>

    <div class="law-prose">
      <h2><Icon name="shield" /> E-cigarettes and ENDS</h2>
      <p>
        E-cigarettes and all Electronic Nicotine Delivery Systems (ENDS —
        vapes, heat-not-burn devices, e-hookah) are covered by the <a href="https://www.indiacode.nic.in/handle/123456789/13078" target="_blank" rel="noopener">Prohibition of Electronic Cigarettes Act, 2019 (PECA)</a>, passed by Parliament on 5 December 2019. In short: PECA bans the <em>business</em> of e-cigarettes, not the act of using one.
      </p>

      <div class="banned-split">
        <div class="banned-col banned-yes">
          <p class="split-label"><Icon name="close" /> Banned under PECA</p>
          <ul>
            <li>Production &amp; manufacture</li>
            <li>Import &amp; export</li>
            <li>Sale &amp; distribution</li>
            <li>Storage &amp; transport for sale</li>
            <li>Advertisement</li>
          </ul>
        </div>
        <div class="banned-col banned-no">
          <p class="split-label"><Icon name="check" /> Not banned</p>
          <ul>
            <li>Vaping — personal use</li>
            <li>Personal possession</li>
            <li>Carrying a device for your own use</li>
          </ul>
        </div>
      </div>
      <p class="split-note">
        No provision anywhere in PECA makes personal use or possession an
        offence. First-offence penalties — up to a year's imprisonment and a
        ₹1 lakh fine — attach only to the commercial acts on the left. See <a href="#know-your-rights">Know your rights</a> below if you've been
        told otherwise.
      </p>

      <h3>Where the "it's banned" claim comes from — and why it's wrong</h3>
      <p>
        In late 2023 the Union Health Ministry told a court, in a case
        brought by AVI members against the flight ban, that because sale and
        import are banned, this <em>implies</em> use is banned too. Here's
        why that doesn't hold up:
      </p>
      <ol class="rebuttal-timeline">
        <li><strong>That's not how law works.</strong> An act only becomes an offence when a specific provision creates it and a specific penalty attaches to it. Neither exists for personal use or possession anywhere in PECA.</li>
        <li><strong>Parliament was told the opposite.</strong> The then Health Minister, Dr Harsh Vardhan, <a href="https://twitter.com/vapeindia/status/1200639227425366017?t=UZhVQ7iMF4hDjVOPfSiiZw&s=19" target="_blank" rel="noopener">assured Parliament</a> during the ENDS bill debate that use and possession would not be banned, since that would violate personal liberties.</li>
        <li><strong>The Ministry's own earlier position.</strong> Months before PECA passed, its <a href="https://twitter.com/MoHFW_INDIA/status/1174325122993278977?t=6X-kwOEHGvSL3ndHKTj9uQ&s=19" target="_blank" rel="noopener">official Twitter account stated</a> plainly that use and possession are not banned.</li>
        <li><strong>The Home Ministry agrees.</strong> A separate <a href="https://www.mha.gov.in/sites/default/files/CSDiv_ecigerete_12122019.pdf" target="_blank" rel="noopener">circular (point C)</a> confirms personal use and possession is not a crime.</li>
        <li><strong>Legal experts concur.</strong> Independent lawyers have reached the <a href="https://www.instagram.com/reel/DZ7MCllo4KJ/?igsh=MXc2aHZmMW53Zm5lMg==" target="_blank" rel="noopener">same conclusion</a>.</li>
      </ol>
      <p>
        See <a href="/litigation">AVI's litigation page</a> for the ongoing flight-ban case, and our <a href="https://x.com/vapeindia/status/1848254084572172776?s=20" target="_blank" rel="noopener">full commentary</a> on this issue.
      </p>

    </div>
  </div>

  <section class="breakout rights-section" id="know-your-rights">
    <div class="breakout-inner">
      <div class="rights-content">
        <p class="rights-eyebrow"><Icon name="scale" /> Know your rights</p>
        <h2>Harassed by police? Use and possession are not banned.</h2>
        <p class="rights-lede">
          Police stopping vapers on the street, claiming e-cigarettes are
          "completely illegal," and demanding cash "fines" is a real,
          recurring problem — built on a misreading of what PECA actually
          says. This section is a citable reference for exactly that moment.
        </p>

        <div class="share-row">
          <button type="button" class="btn-share" id="share-rights-btn">
            <Icon name="megaphone" /> <span id="share-rights-label">Copy link to show police</span>
          </button>
          <p class="share-hint">Bookmark it, or send the link to a friend — it opens straight to this section.</p>
        </div>

        <h3>The evidence, in one place</h3>
        <div class="evidence-grid">
          <a class="evidence-card" href="https://twitter.com/MoHFW_INDIA/status/1174325122993278977?t=6X-kwOEHGvSL3ndHKTj9uQ&s=19" target="_blank" rel="noopener">
            <Icon name="quote" />
            <span class="ev-label">Health Ministry's own tweet</span>
            <span class="ev-sub">2019 — use &amp; possession not banned</span>
          </a>
          <a class="evidence-card" href="https://www.mha.gov.in/sites/default/files/CSDiv_ecigerete_12122019.pdf" target="_blank" rel="noopener">
            <Icon name="document" />
            <span class="ev-label">Home Ministry circular</span>
            <span class="ev-sub">Point C — personal use is not an offence</span>
          </a>
          <a class="evidence-card" href="https://twitter.com/vapeindia/status/1200639227425366017?t=UZhVQ7iMF4hDjVOPfSiiZw&s=19" target="_blank" rel="noopener">
            <Icon name="megaphone" />
            <span class="ev-label">Health Minister, in Parliament</span>
            <span class="ev-sub">Video — assured use won't be banned</span>
          </a>
          <a class="evidence-card" href="https://www.instagram.com/reel/DZ7MCllo4KJ/?igsh=MXc2aHZmMW53Zm5lMg==" target="_blank" rel="noopener">
            <Icon name="scale" />
            <span class="ev-label">A senior advocate's opinion</span>
            <span class="ev-sub">Why possession isn't an offence</span>
          </a>
          <a class="evidence-card" href="https://x.com/vapeindia/status/1848254084572172776?s=20" target="_blank" rel="noopener">
            <Icon name="quote" />
            <span class="ev-label">AVI's full commentary</span>
            <span class="ev-sub">The Ministry's contradictory record</span>
          </a>
        </div>

        <p>
          This isn't theoretical: officers exploiting the confusion for
          extortion is a documented pattern. Two Bangalore constables were <a href="https://timesofindia.indiatimes.com/city/bengaluru/2-constables-dismissed-over-extortion/articleshow/98846356.cms" target="_blank" rel="noopener">dismissed for extorting a vaper</a>, and in Mumbai a <a href="https://www.freepressjournal.in/amp/mumbai/mumbai-police-arrest-fake-cop-for-demanding-50000-from-woman-smoking-e-cigarette-in-auto-2-others-held" target="_blank" rel="noopener">fake police officer was arrested</a> for demanding ₹50,000 from a woman vaping in an auto — a con that only works because "it's banned" sounds plausible.
        </p>

        <div class="report-counter">
          <Icon name="chart" />
          <p>
            <strong>{hStats.total}</strong> harassment report{hStats.total === 1 ? '' : 's'} logged so far{hStats.totalAmount > 0 ? ` — ₹${hStats.totalAmount.toLocaleString('en-IN')} demanded or paid in total` : ''}. <a href="/report-harassment">{hStats.total > 0 ? 'See the full breakdown, or report your own' : 'Be the first to report an incident'} →</a>
          </p>
        </div>

        <h3>If you're stopped by police over vaping</h3>
        <ol class="tips-list">
          <li>Stay calm and polite — make your case with information, not an argument on the street.</li>
          <li>Ask for the officer's name, badge/service number and station. A genuine officer gives this without hesitation.</li>
          <li>Ask exactly which law and section you've violated. There isn't one for personal use or possession.</li>
          <li>Never hand over cash "to settle it." Indian law has no on-the-spot cash fine here — that's a bribe or a scam, not a penalty.</li>
          <li>If they push to confiscate your device or detain you, ask to go to the station and for a written seizure memo.</li>
          <li>Pull up the <a href="https://www.mha.gov.in/sites/default/files/CSDiv_ecigerete_12122019.pdf" target="_blank" rel="noopener">Home Ministry circular</a> on your phone — point C says it plainly.</li>
          <li>Record audio or video if you can safely do so. Just asking "do you mind if I record this?" often de-escalates it on its own.</li>
          <li>Note the time, location, vehicle number and any badge numbers you can see.</li>
          <li>Afterwards, report it — to your state's police complaints authority or DGP portal, and the Anti-Corruption Bureau if money changed hands.</li>
          <li><a href="/report-harassment">Report what happened</a> — two minutes, anonymous by default, and it feeds the count above and AVI's advocacy and litigation.</li>
        </ol>

        <p class="rights-note">
          This is AVI's understanding of the law, not formal legal advice —
          consult a lawyer for an active legal matter. But the facts above —
          what PECA's text says, and what both ministries have themselves
          stated — are public record, not opinion.
        </p>
      </div>
    </div>
  </section>

  <script>
    const shareBtn = document.getElementById('share-rights-btn');
    const shareLabel = document.getElementById('share-rights-label');
    if (shareBtn && shareLabel) {
      const defaultLabel = shareLabel.textContent;
      shareBtn.addEventListener('click', async () => {
        const url = window.location.origin + '/india/law/#know-your-rights';
        if (navigator.share) {
          try {
            await navigator.share({ title: 'Know your rights — vaping is not banned in India', url });
            return;
          } catch (err) {
            // user cancelled or share failed — fall through to copy
          }
        }
        try {
          await navigator.clipboard.writeText(url);
          shareLabel.textContent = 'Link copied!';
        } catch (err) {
          shareLabel.textContent = url;
        }
        setTimeout(() => { shareLabel.textContent = defaultLabel; }, 2500);
      });
    }
  </script>

  <div class="law-body">
    <div class="law-prose">
      <h2><Icon name="leaf" /> Nicotine pouches and snus</h2>
      <p>
        Pouches and snus involve no vapour or heating element, so they fall
        outside PECA entirely — but they're still not lawfully available,
        blocked by two separate mechanisms instead of one clean ban:
      </p>
      <ul>
        <li><strong>No domestic sale pathway.</strong> Since they're taken orally, FSSAI regulates them — and hasn't approved nicotine for use in food.</li>
        <li><strong>Import is discretionary, not banned outright.</strong> They're "restricted" goods requiring a licence that DGFT, in consultation with the health ministry, routinely refuses.</li>
      </ul>
      <p class="split-note">
        No single Act names nicotine pouches directly — COTPA doesn't cover
        them, PECA only covers vapour devices, and their status under the
        Drugs and Cosmetics Act is unsettled. <a href="https://vajiramandravi.com/current-affairs/nicotine-pouches-in-india-legal-status-regulation-and-health-concerns/" target="_blank" rel="noopener">Some commentators argue</a> a direct customs notification could close this gap — nothing has yet.
      </p>

      <PullQuote
        quote="Using [nicotine pouches] instead of cigarettes puts you at a lower risk of mouth cancer, heart disease, lung cancer, stroke, emphysema, and chronic bronchitis."
        attribution="US FDA, modified-risk marketing order, June 2026"
      />

      <div class="pouch-compare">
        <div class="pouch-col pouch-fda">
          <p class="split-label">FDA-reviewed, June 2026</p>
          <p>The claim above is the first reduced-risk marketing claim FDA has ever authorised for a nicotine pouch, after its own scientific review. <a href="https://www.fda.gov/tobacco-products/ctp-newsroom/fda-authorizes-20-zyn-nicotine-pouches-be-marketed-specific-modified-risk-claim" target="_blank" rel="noopener">Read the FDA order →</a></p>
        </div>
        <div class="pouch-col pouch-slt">
          <p class="split-label">Meanwhile in India</p>
          <p><strong>350,000+</strong> deaths a year from loose smokeless tobacco — gutka, khaini — sold openly at every paan shop, per a <a href="https://pubmed.ncbi.nlm.nih.gov/25526253/" target="_blank" rel="noopener">peer-reviewed mortality study</a>, while a lower-risk pouch stays off the market entirely.</p>
        </div>
      </div>
      <p class="split-note">
        The evidence is not ambiguous: pouches carry a small fraction of the
        risk of smoking or chewing tobacco — that's what "lower-risk"
        certified by an independent regulator after formal scientific review
        actually means. Keeping a genuinely lower-risk alternative off the
        market while gutka and khaini stay legal on every street corner
        isn't caution — it's the opposite of harm reduction.
      </p>
      <p class="callout-note">
        This page describes AVI's understanding of the regulatory position
        and the published evidence — not formal legal or medical advice, and
        not an offer to sell, supply or facilitate access to anything.
      </p>

      <h2><Icon name="heart" /> NRT, for contrast</h2>
      <p>
        Gums and patches are legal, regulated as medicines, and government-
        backed as cessation aids. AVI isn't arguing NRT should be restricted —
        reduced-risk alternatives are just held to a stricter standard despite
        comparable or better quit outcomes; see the <a href="/science">evidence library</a>.
      </p>

      <h2><Icon name="document" /> What this means practically</h2>
      <p>
        This site doesn't sell, advertise or facilitate access to nicotine
        of any kind — AVI's advocacy is aimed at changing the law
        through evidence and litigation, not circumventing it. See <a href="/litigation">litigation</a> for the
        cases AVI has fought against state-level bans and the flight ban PECA
        doesn't touch.
      </p>
    </div>

    <div class="law-related">
      <a href="/report-harassment" class="related-card">
        <h3>Report harassment →</h3>
        <p>Stopped or shaken down over vaping? Log it — it feeds the count above and AVI's advocacy.</p>
      </a>
      <a href="/litigation" class="related-card">
        <h3>Litigation →</h3>
        <p>The court cases AVI has fought against state-level bans and the flight ban.</p>
      </a>
    </div>
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-light);
      margin: 0 0 0.75rem;
    }
    .law-hero {
      background: linear-gradient(rgba(18,19,15,0.85), rgba(18,19,15,0.93)), url('/images/backgrounds/open-sky.jpg');
      background-size: cover;
      background-position: center 60%;
      padding: 3.25rem 0 2.75rem;
    }
    .law-hero h1 { color: #fff; margin: 0; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }

    .law-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 2.75rem 1.5rem 4rem; }

    .status-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 3rem;
    }
    .status-card {
      background: #fff;
      border-radius: 8px;
      padding: 1.5rem 1.5rem 1.6rem;
      border-top: 4px solid;
      box-shadow: 0 1px 3px rgba(20,25,20,0.06);
    }
    .status-card :global(svg) { width: 1.8rem; height: 1.8rem; margin-bottom: 0.85rem; }
    .status-card h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
    .status-card p { margin: 0; font-size: 0.88rem; color: var(--muted); line-height: 1.5; }
    .status-tag {
      font-weight: 700 !important;
      font-size: 0.78rem !important;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-bottom: 0.6rem !important;
    }
    .status-banned { border-color: var(--rust); }
    .status-banned :global(svg) { color: var(--rust); }
    .status-banned .status-tag { color: var(--rust-dark); }
    .status-blocked { border-color: var(--gold); }
    .status-blocked :global(svg) { color: var(--gold); }
    .status-blocked .status-tag { color: var(--gold-dark); }
    .status-legal { border-color: var(--accent); }
    .status-legal :global(svg) { color: var(--accent); }
    .status-legal .status-tag { color: var(--accent-dark); }
    @media (max-width: 780px) {
      .status-grid { grid-template-columns: 1fr; }
    }

    .law-prose { max-width: var(--max-w); }
    .law-prose h2 {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.25rem;
      margin: 2.5rem 0 1rem;
    }
    .law-prose h2:first-child { margin-top: 0; }
    .law-prose h2 :global(svg) { width: 1.3rem; height: 1.3rem; color: var(--accent); flex-shrink: 0; }
    .law-prose h3 { font-size: 1.05rem; margin: 2rem 0 0.85rem; }
    .callout-note {
      background: var(--paper-alt);
      border-left: 3px solid var(--gold);
      padding: 1rem 1.25rem;
      font-size: 0.9rem;
      font-style: italic;
      color: var(--muted);
    }

    /* Banned vs. not-banned split — the two long e-cig paragraphs used to
       live as prose; this makes the one-line-answer scannable at a glance. */
    .banned-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin: 1.5rem 0;
    }
    .banned-col {
      border-radius: 8px;
      padding: 1.1rem 1.25rem 1.25rem;
      border: 1px solid var(--border);
    }
    .banned-col ul { margin: 0; padding-left: 1.15rem; }
    .banned-col li { font-size: 0.9rem; line-height: 1.6; }
    .banned-yes { background: #fbf1ec; border-color: #ecd3c4; }
    .banned-no { background: #eef6f1; border-color: #cfe4d7; }
    .split-label {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin: 0 0 0.75rem;
    }
    .split-label :global(svg) { width: 1.05rem; height: 1.05rem; }
    .banned-yes .split-label { color: var(--rust-dark); }
    .banned-yes .split-label :global(svg) { color: var(--rust); }
    .banned-no .split-label { color: var(--accent-dark); }
    .banned-no .split-label :global(svg) { color: var(--accent); }
    .split-note {
      background: var(--paper-alt);
      border-left: 3px solid var(--accent);
      padding: 0.9rem 1.1rem;
      font-size: 0.9rem;
      color: var(--muted);
      margin: 0 0 1.75rem;
    }
    @media (max-width: 640px) {
      .banned-split { grid-template-columns: 1fr; }
    }

    /* FDA-vs-SLT comparison — same two-column pattern as banned-split,
       so the pouches section doesn't fall back into three dense paragraphs. */
    .pouch-compare {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin: 1.5rem 0;
    }
    .pouch-col { border-radius: 8px; padding: 1.1rem 1.25rem 1.25rem; border: 1px solid var(--border); }
    .pouch-col p { font-size: 0.9rem; line-height: 1.6; margin: 0; color: var(--ink); }
    .pouch-col .split-label { margin-bottom: 0.6rem; }
    .pouch-fda { background: #eef6f1; border-color: #cfe4d7; }
    .pouch-fda .split-label { color: var(--accent-dark); }
    .pouch-slt { background: #fbf1ec; border-color: #ecd3c4; }
    .pouch-slt .split-label { color: var(--rust-dark); }
    .pouch-slt strong { font-family: var(--font-serif); font-size: 1.3rem; color: var(--rust-dark); }
    @media (max-width: 640px) {
      .pouch-compare { grid-template-columns: 1fr; }
    }

    /* Rebuttal timeline — each claim gets its own card instead of one
       run-on paragraph, so the chain of evidence is easy to skim. */
    .rebuttal-timeline {
      list-style: none;
      counter-reset: rebuttal;
      margin: 0 0 1.5rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .rebuttal-timeline li {
      counter-increment: rebuttal;
      position: relative;
      background: var(--paper-alt);
      border-radius: 8px;
      padding: 0.9rem 1.1rem 0.9rem 3rem;
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .rebuttal-timeline li::before {
      content: counter(rebuttal);
      position: absolute;
      left: 0.9rem;
      top: 0.9rem;
      width: 1.4rem;
      height: 1.4rem;
      border-radius: 50%;
      background: var(--accent);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .rebuttal-timeline strong { display: block; margin-bottom: 0.2rem; }

    /* Know your rights — deliberately loud: full-bleed, photo band with a
       dark overlay, so it reads as a distinct reference, not more prose. */
    .rights-section {
