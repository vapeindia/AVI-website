---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('litigation');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const statusLabel = (s: string) => (s === 'pending' ? 'Ongoing' : s === 'superseded-by-peca' ? 'Superseded by PECA' : s === 'withdrawn' ? 'Withdrawn' : 'Disposed');
const description = item.data.summary.length > 155
  ? item.data.summary.slice(0, 155).replace(/\s+\S*$/, '') + '…'
  : item.data.summary;
---
<Base title={item.data.title} description={description}>
  <p><a href="/litigation">← Back to litigation</a></p>
  <span class={`status-pill status-${item.data.status}`}>{statusLabel(item.data.status)}</span>
  <h1>{item.data.title}</h1>
  <p class="meta"><small>{item.data.court}, {item.data.state}</small></p>
  <p class="lead">{item.data.summary}</p>
  {item.data.outcome && <p class="outcome"><strong>Outcome:</strong> {item.data.outcome}</p>}
  <Content />
  {item.data.documents.length > 0 && (
    <>
      <h2>Documents</h2>
      <ul>
        {item.data.documents.map((d) => <li><a href={d.path}>{d.label}</a></li>)}
      </ul>
    </>
  )}

  <div class="case-related">
    <a href="/litigation" class="related-card">
      <h3>All litigation →</h3>
      <p>Every court case AVI has organised and directed against India's ENDS bans since 2017.</p>
    </a>
    <a href="/press" class="related-card">
      <h3>Press coverage →</h3>
      <p>How this and AVI's other litigation has been reported.</p>
    </a>
  </div>

  <style>
    .status-pill {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.6rem;
      border-radius: 99px;
      color: #fff;
      background: var(--accent);
      margin-bottom: 0.75rem;
    }
    .status-pending { background: var(--gold-dark); }
    .status-superseded-by-peca, .status-withdrawn { background: var(--muted); }
    h1 { margin-top: 0.25rem; }
    .meta { color: var(--muted); margin-top: -0.5rem; }
    .lead { font-size: 1.05rem; }
    .outcome {
      background: var(--paper-alt);
      border-left: 3px solid var(--gold);
      padding: 1rem 1.25rem;
    }

    .case-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-alt);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--accent-dark); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
