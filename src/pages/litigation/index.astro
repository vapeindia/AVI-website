---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

// Ongoing (pending) cases first, then everything else newest-filed first —
// so the case AVI is actively running today always leads the page.
const cases = (await getCollection('litigation')).sort((a, b) => {
  const aPending = a.data.status === 'pending' ? 1 : 0;
  const bPending = b.data.status === 'pending' ? 1 : 0;
  if (aPending !== bPending) return bPending - aPending;
  const aDate = a.data.filedDate?.valueOf() ?? 0;
  const bDate = b.data.filedDate?.valueOf() ?? 0;
  return bDate - aDate;
});
const statusLabel = (s: string) => (s === 'pending' ? 'Ongoing' : s === 'superseded-by-peca' ? 'Superseded by PECA' : s === 'withdrawn' ? 'Withdrawn' : 'Disposed');
---
<Base title="Litigation" description="A decade at the forefront of tobacco harm reduction litigation in India — the cases AVI has organised and fought, and the ones it has deliberately stayed out of." wide={true}>
  <section class="breakout lit-hero">
    <div class="breakout-inner">
      <p class="eyebrow">A decade in court</p>
      <h1>AVI in court</h1>
      <p class="lit-sub">
        Since 2017, AVI has organised, funded and directed legal challenges to
        bans on e-cigarettes and vaping products in courts across India —
        Karnataka, Delhi, Jammu &amp; Kashmir and Tamil Nadu — taking some of
        these fights through multiple rounds of appeal. That work continues
        today: AVI is currently running an active case in the Delhi High
        Court against the flight ban on carrying e-cigarettes, the one major
        restriction the national ban under PECA, 2019 never touched.
      </p>
      <p class="lit-sub">
        Separately, sellers and manufacturers have brought their own
        challenges to these bans — in Mumbai and Kolkata among other places.
        AVI is a consumer advocacy organisation, not an industry one, and has
        never funded, filed, or directed litigation on a vendor's or
        manufacturer's behalf, even in cases that drew on research and legal
        arguments AVI first developed and published. Each card below draws
        that line plainly wherever it applies.
      </p>
    </div>
  </section>

  <div class="lit-body">
    <div class="lit-grid">
      {cases.map((c) => (
        <a class={`lit-card status-${c.data.status}`} href={`/litigation/${c.id}`}>
          <div class="card-top">
            <Icon name="scale" />
            <span class="status-badge">{statusLabel(c.data.status)}</span>
          </div>
          <h2>{c.data.title}</h2>
          <p class="court">{c.data.state} · {c.data.court}</p>
          <p class="summary">{c.data.summary}</p>
          <span class="read-link">Full case record →</span>
        </a>
      ))}
    </div>

    <div class="lit-related">
      <a href="/campaigns" class="related-card">
        <h3>Beyond the courtroom →</h3>
        <p>Protests, seminars and delegations to government — AVI's public campaigns, alongside the litigation.</p>
      </a>
      <a href="/india/submissions" class="related-card">
        <h3>Submissions to policymakers →</h3>
        <p>Letters and formal responses AVI has sent directly to the health ministry, MPs and government advisories.</p>
      </a>
      <a href="/contribute" class="related-card">
        <h3>What funds this →</h3>
        <p>This litigation is funded entirely by individual contributions, not industry. See how to support it.</p>
      </a>
    </div>
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-light);
      margin: 0 0 0.75rem;
    }
    .lit-hero {
      background: linear-gradient(rgba(18,19,15,0.85), rgba(18,19,15,0.93)), url('/images/backgrounds/open-field.jpg');
      background-size: cover;
      background-position: center;
      color: #f4f1e6;
      padding: 3.5rem 0 3rem;
    }
    .lit-hero h1 { color: #fff; margin: 0 0 1.25rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .lit-sub { color: #cdd6cf; max-width: 44rem; font-size: 1rem; margin: 0 0 1rem; }
    .lit-sub:last-child { margin-bottom: 0; }

    .lit-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 3rem 1.5rem 4rem; }
    .lit-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
      gap: 1.5rem;
    }
    .lit-card {
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.5rem 1.5rem 1.6rem;
      box-shadow: 0 1px 3px rgba(20,25,20,0.05);
      text-decoration: none;
      color: inherit;
      border-top: 4px solid var(--accent);
    }
    .lit-card.status-pending { border-top-color: var(--gold); }
    .lit-card.status-superseded-by-peca { border-top-color: var(--muted); }
    .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .card-top :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--accent); }
    .status-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.55rem;
      border-radius: 99px;
      color: #fff;
      background: var(--accent);
    }
    .status-pending .status-badge { background: var(--gold-dark); }
    .status-superseded-by-peca .status-badge { background: var(--muted); }
    .status-withdrawn .status-badge { background: var(--muted); }

    .lit-card h2 { margin: 0 0 0.35rem; font-size: 1.1rem; line-height: 1.35; color: var(--ink); }
    .court { margin: 0 0 0.75rem; font-size: 0.82rem; color: var(--muted); font-weight: 600; }
    .summary { font-size: 0.88rem; color: var(--ink); line-height: 1.55; margin: 0 0 1rem; flex-grow: 1; }
    .read-link { font-size: 0.85rem; font-weight: 600; color: var(--accent-dark); margin-top: auto; }

    .lit-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1.25rem;
      margin-top: 2.5rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--border);
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-alt);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--accent-dark); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
