---
import Base from '../../layouts/Base.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { getCollection } from 'astro:content';

const videos = (await getCollection('videos'))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

// Ranked by live YouTube view count (see scripts/fetch-youtube.mjs); any
// video without a viewCount yet (API key not configured, or not refreshed
// since it was added) sorts to the back, tie-broken by recency so the
// section still reads sensibly before the first refresh populates counts.
const mostWatched = [...videos].sort((a, b) => {
  const av = a.data.viewCount ?? -1;
  const bv = b.data.viewCount ?? -1;
  if (bv !== av) return bv - av;
  return b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf();
});
const viewsFormatter = new Intl.NumberFormat('en-IN', { notation: 'compact', maximumFractionDigits: 1 });

const platforms = [
  {
    icon: 'x' as const,
    name: 'X',
    handle: '@vapeindia',
    href: 'https://x.com/vapeindia',
    blurb: 'Follow us on X for the latest news, updates, rebuttals and advocacy.',
  },
  {
    icon: 'linkedin' as const,
    name: 'LinkedIn',
    handle: 'Association of Vapers India',
    href: 'https://www.linkedin.com/showcase/vapeindia',
    blurb: 'Follow us on LinkedIn for policy analysis and regulatory insights.',
  },
  {
    icon: 'facebook' as const,
    name: 'Facebook',
    handle: 'AVI',
    href: 'https://facebook.com/avindia',
    blurb: 'Track our page for news and articles, share your views, and flag misleading content that needs our response.',
  },
  {
    icon: 'instagram' as const,
    name: 'Instagram',
    handle: '@avi_vapeindia',
    href: 'https://instagram.com/avi_vapeindia',
    blurb: 'Track our page for news and articles, share your views, and flag misleading content that needs our response.',
  },
];

// Plain data for the client-side rotator below — id/title/thumb/url only,
// nothing that needs the full collection entry.
const videoData = videos.map((v) => ({
  title: v.data.title,
  summary: v.data.summary,
  thumb: v.data.thumbnailUrl,
  url: `https://www.youtube.com/watch?v=${v.data.videoId}`,
}));
const latest = videoData[0];
---
<Base title="Our Media" description="Where to find AVI's advocacy across YouTube, X, LinkedIn, Facebook and Instagram, plus our video library." wide={true}>
  <section class="breakout media-hero">
    <div class="breakout-inner">
      <p class="eyebrow">Everywhere AVI shows up</p>
      <h1>Follow AVI across every platform</h1>
      <p class="media-sub">
        A decade of tobacco harm reduction advocacy doesn't live in one
        place — Board Q&amp;As, #VapingThursday talks with international
        researchers, and explainers on YouTube; news, rebuttals and the
        day-to-day conversation on X, LinkedIn, Facebook and Instagram.
      </p>
      <a class="btn btn-gold" href="https://youtube.com/channel/UCEgd8dgEScqYKKUBHwD1DDQ" target="_blank" rel="noopener">Subscribe on YouTube →</a>
    </div>
  </section>

  {latest && (
    <div class="media-body">
      <section class="spotlight" id="spotlight">
        <p class="spotlight-label">Featured</p>
        <div class="spotlight-inner">
          <a class="spotlight-thumb" id="spotlight-link" href={latest.url} target="_blank" rel="noopener">
            <img id="spotlight-img" src={latest.thumb} alt={latest.title} />
            <span class="play-badge" aria-hidden="true">▶</span>
          </a>
          <div class="spotlight-copy">
            <h2 id="spotlight-title">{latest.title}</h2>
            <p id="spotlight-summary">{latest.summary}</p>
            <button type="button" class="btn btn-outline" id="spotlight-shuffle">Shuffle 🔀</button>
          </div>
        </div>
      </section>
    </div>
  )}

  <div class="media-body">
    <section class="platforms">
      <div class="section-head">
        <h2>Find AVI everywhere</h2>
        <p>Every platform where India's tobacco harm reduction conversation happens — and in <a href="/press">third-party press coverage</a> too.</p>
      </div>
      <div class="platform-grid">
        {platforms.map((p) => (
          <a class="platform-card" href={p.href} target="_blank" rel="noopener" aria-label={`AVI on ${p.name}`}>
            <span class="platform-icon"><SocialIcon name={p.icon} /></span>
            <span class="platform-copy">
              <span class="platform-name">{p.name} <span class="platform-handle">{p.handle}</span></span>
              <span class="platform-blurb">{p.blurb}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <div class="media-body">
    <div class="section-head">
      <h2>Most watched videos</h2>
      <p>Ranked by views on YouTube.</p>
    </div>
    <div class="media-grid" id="most-watched-grid">
      {mostWatched.map((v, i) => (
        <a class="video-card" href={`https://www.youtube.com/watch?v=${v.data.videoId}`} target="_blank" rel="noopener" hidden={i >= 4}>
          <div class="thumb">
            <img src={v.data.thumbnailUrl} alt={v.data.title} loading="lazy" />
            <span class="play-badge" aria-hidden="true">▶</span>
          </div>
          <h2>{v.data.title}</h2>
          <p class="card-summary">{v.data.summary}</p>
          <div class="card-meta">
            <time datetime={v.data.publishedDate.toISOString()}>
              {v.data.publishedDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            {v.data.viewCount != null && <span class="view-count">{viewsFormatter.format(v.data.viewCount)} views</span>}
          </div>
        </a>
      ))}
    </div>
    {mostWatched.length > 4 && (
      <button type="button" class="btn btn-outline show-more-btn" id="show-more-videos">
        Show {mostWatched.length - 4} more videos
      </button>
    )}

    <div class="media-related">
      <a href="/news" class="related-card">
        <h3>Daily news →</h3>
        <p>Coverage of vaping and tobacco harm reduction from across the web, updated daily.</p>
      </a>
      <a href="/press" class="related-card">
        <h3>Press coverage →</h3>
        <p>How AVI's own work has been reported, and its statements on the record.</p>
      </a>
      <a href="/campaigns" class="related-card">
        <h3>Campaigns →</h3>
        <p>The protests, seminars and delegations behind some of these videos.</p>
      </a>
      <a href="/testimonials" class="related-card">
        <h3>Testimonials →</h3>
        <p>Real stories behind some of this advocacy, in people's own words.</p>
      </a>
    </div>
  </div>

  <script type="application/json" id="video-data" set:html={JSON.stringify(videoData).replace(/</g, '\\u003c')} />
  <script>
    const videos = JSON.parse(document.getElementById('video-data')?.textContent || '[]');
    const spotlight = document.getElementById('spotlight');
    const img = document.getElementById('spotlight-img');
    const titleEl = document.getElementById('spotlight-title');
    const summaryEl = document.getElementById('spotlight-summary');
    const link = document.getElementById('spotlight-link');
    const shuffleBtn = document.getElementById('spotlight-shuffle');

    if (spotlight && videos.length > 1) {
      const ROTATE_MS = 9000;
      const FADE_MS = 250;
      let currentIndex = 0; // index 0 (latest) matches what was server-rendered
      let paused = false;
      let timer;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function pickNext() {
        if (videos.length < 2) return currentIndex;
        let next;
        do { next = Math.floor(Math.random() * videos.length); } while (next === currentIndex);
        return next;
      }

      function render(index) {
        const v = videos[index];
        img.style.opacity = '0';
        link.style.opacity = '0';
        setTimeout(() => {
          img.src = v.thumb;
          img.alt = v.title;
          titleEl.textContent = v.title;
          summaryEl.textContent = v.summary;
          link.href = v.url;
          img.style.opacity = '1';
          link.style.opacity = '1';
        }, FADE_MS);
      }

      function rotate() {
        if (paused) return;
        currentIndex = pickNext();
        render(currentIndex);
      }

      function startTimer() {
        clearInterval(timer);
        timer = setInterval(rotate, ROTATE_MS);
      }

      if (!reduceMotion) {
        startTimer();
        spotlight.addEventListener('mouseenter', () => { paused = true; });
        spotlight.addEventListener('mouseleave', () => { paused = false; });
        spotlight.addEventListener('focusin', () => { paused = true; });
        spotlight.addEventListener('focusout', () => { paused = false; });
      }

      shuffleBtn?.addEventListener('click', () => {
        currentIndex = pickNext();
        render(currentIndex);
        if (!reduceMotion) startTimer(); // reset the clock so it doesn't rotate right after a manual pick
      });
    } else if (shuffleBtn) {
      shuffleBtn.style.display = 'none';
    }

    const showMoreBtn = document.getElementById('show-more-videos');
    showMoreBtn?.addEventListener('click', () => {
      document.querySelectorAll('#most-watched-grid [hidden]').forEach((el) => { el.hidden = false; });
      showMoreBtn.hidden = true;
    });
  </script>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-light);
      margin: 0 0 0.75rem;
    }
    .media-hero {
      background: linear-gradient(rgba(18,19,15,0.85), rgba(18,19,15,0.93)), url('/images/backgrounds/mountain-sunrise.jpg');
      background-size: cover;
      background-position: center;
      color: #f4f1e6;
      padding: 3.5rem 0 3rem;
    }
    .media-hero h1 { color: #fff; margin: 0 0 1.1rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .media-sub { color: #cdd6cf; max-width: 42rem; font-size: 1.03rem; margin: 0 0 1.75rem; }

    .media-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 0 1.5rem; }
    .media-body:first-of-type { padding-top: 3rem; }

    .spotlight { margin-bottom: 3rem; }
    .spotlight-label {
      font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--gold-dark); margin: 0 0 0.9rem;
    }
    .spotlight-inner {
      display: grid; grid-template-columns: 22rem 1fr; gap: 2rem; align-items: center;
      background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem;
    }
    .spotlight-thumb { position: relative; display: block; border-radius: 6px; overflow: hidden; line-height: 0; transition: opacity 0.25s ease; }
    .spotlight-thumb img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; transition: opacity 0.25s ease; }
    .spotlight-copy h2 { margin: 0 0 0.6rem; font-size: 1.4rem; line-height: 1.35; }
    .spotlight-copy #spotlight-summary { margin: 0 0 1.25rem; color: var(--muted); font-size: 0.95rem; line-height: 1.55; }
    .play-badge {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: 3rem; height: 3rem; border-radius: 50%;
      background: rgba(18,19,15,0.75); color: #fff;
      display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    @media (max-width: 640px) {
      .spotlight-inner { grid-template-columns: 1fr; }
    }

    .section-head { margin-bottom: 1.5rem; }
    .section-head h2 { margin: 0 0 0.3rem; font-size: 1.3rem; }
    .section-head p { margin: 0; color: var(--muted); font-size: 0.9rem; }

    .platforms { margin: 1rem 0 3rem; }
    .platform-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); gap: 1.25rem; }
    .platform-card {
      display: flex; align-items: flex-start; gap: 0.9rem;
      background: #fff; border: 1px solid var(--border); border-radius: 8px;
      padding: 1.15rem 1.25rem; text-decoration: none; color: inherit;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .platform-card:hover { border-color: var(--gold-dark); transform: translateY(-2px); }
    .platform-icon {
      flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: 50%;
      background: var(--accent-dark); color: #fff;
      display: flex; align-items: center; justify-content: center;
    }
    .platform-icon svg { width: 1.3rem; height: 1.3rem; }
    .platform-copy { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
    .platform-name { font-weight: 700; font-size: 0.98rem; color: var(--ink); }
    .platform-handle { font-weight: 400; color: var(--muted); font-size: 0.85rem; margin-left: 0.35rem; }
    .platform-blurb { font-size: 0.85rem; color: var(--muted); line-height: 1.5; }

    .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr)); gap: 1.75rem; }
    .video-card { display: block; text-decoration: none; color: inherit; }
    .video-card[hidden] { display: none; }
    .thumb { position: relative; border-radius: 8px; overflow: hidden; line-height: 0; margin-bottom: 0.75rem; box-shadow: 0 1px 3px rgba(20,25,20,0.08); }
    .thumb img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; transition: transform 0.2s ease; }
    .video-card:hover .thumb img { transform: scale(1.03); }
    .video-card h2 { margin: 0 0 0.35rem; font-size: 1rem; line-height: 1.4; color: var(--ink); }
    .card-summary { margin: 0 0 0.5rem; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
    .card-meta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .video-card time { font-size: 0.8rem; color: var(--muted); }
    .view-count {
      font-size: 0.75rem; font-weight: 600; color: var(--gold-dark);
      background: var(--paper-alt); border-radius: 999px; padding: 0.15rem 0.6rem;
    }
    .show-more-btn { display: block; margin: 2rem auto; }

    .media-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      margin-top: 2rem;
      padding: 2.5rem 0 4rem;
      border-top: 1px solid var(--border);
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-alt);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--accent-dark); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
