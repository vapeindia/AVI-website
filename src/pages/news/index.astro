---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('news', ({ data }) => data.reviewed))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const digests = await getCollection('newsDigests');
const dailyDigestByDate = new Map(
  digests.filter((d) => d.data.type !== 'weekly').map((d) => [d.data.date.toISOString().slice(0, 10), d.data.summary])
);
const weeklyDigestByWeekStart = new Map(
  digests.filter((d) => d.data.type === 'weekly').map((d) => [d.data.date.toISOString().slice(0, 10), d.data])
);

// Monday of the ISO week containing `date` — matches
// scripts/generate-weekly-digest.mjs's isoWeekStart() exactly, so a week
// grouped here lines up with whichever weekly digest that script wrote.
function isoWeekStartKey(date: Date): string {
  const d = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
  const day = d.getUTCDay() || 7;
  if (day !== 1) d.setUTCDate(d.getUTCDate() - (day - 1));
  return d.toISOString().slice(0, 10);
}

// Group same-day items together so a day with a written digest shows it
// once above its cluster of cards, rather than repeating context per card.
type Item = (typeof items)[number];
const dayGroups: { dateKey: string; date: Date; items: Item[] }[] = [];
for (const item of items) {
  const dateKey = item.data.date.toISOString().slice(0, 10);
  const group = dayGroups[dayGroups.length - 1];
  if (group && group.dateKey === dateKey) {
    group.items.push(item);
  } else {
    dayGroups.push({ dateKey, date: item.data.date, items: [item] });
  }
}

// The current, still-forming week is never collapsed to a weekly card even
// if (unusually) a weekly digest exists for it — only a fully-elapsed week
// gets the collapsed treatment. Everything else groups by ISO week; a week
// with no written weekly digest yet (most commonly the current one) just
// shows its day-groups directly, un-collapsed.
const currentWeekStart = isoWeekStartKey(new Date());
type WeekBlock = { weekStart: string; weekly: (typeof digests)[number]['data'] | null; days: typeof dayGroups };
const weekBlocks: WeekBlock[] = [];
for (const day of dayGroups) {
  const weekStart = isoWeekStartKey(day.date);
  const weekly = weekStart === currentWeekStart ? null : (weeklyDigestByWeekStart.get(weekStart) ?? null);
  const block = weekBlocks[weekBlocks.length - 1];
  if (block && block.weekStart === weekStart) {
    block.days.push(day);
  } else {
    weekBlocks.push({ weekStart, weekly, days: [day] });
  }
}

const topicLabel: Record<string, string> = {
  policy: 'Policy',
  litigation: 'Litigation',
  science: 'Science',
  industry: 'Industry',
  other: 'Commentary',
};

const dayFmt = (d: Date) => d.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
const shortFmt = (d: Date) => d.toLocaleDateString('en-IN', { month: 'short', day: 'numeric' });
---
<Base title="News" description="Current developments on tobacco harm reduction, vaping and nicotine pouch regulation relevant to India." wide={true}>
  <section class="breakout news-hero">
    <div class="breakout-inner">
      <p class="eyebrow">Updated as it happens</p>
      <h1>News</h1>
      <p class="news-sub">
        Curated coverage of tobacco harm reduction, vaping and nicotine
        policy relevant to India — auto-gathered from policy commentary and
        outlet feeds, human-reviewed before it appears here. Each day gets a
        short summary; open it up for the individual stories. Once a week
        has passed, its days fold into a single weekly roundup.
      </p>
    </div>
  </section>

  <div class="news-body">
    {weekBlocks.map((block) => {
      const dayCount = block.days.length;
      const itemCount = block.days.reduce((n, d) => n + d.items.length, 0);
      const weekly = block.weekly;
      const DayList = (
        <>
          {block.days.map((day) => (
            <div class="day-group">
              <div class="day-heading">
                <h3>{dayFmt(day.date)}</h3>
                <span class="day-count">{day.items.length} {day.items.length === 1 ? 'story' : 'stories'}</span>
              </div>
              {dailyDigestByDate.has(day.dateKey) && (
                <p class="digest-text">{dailyDigestByDate.get(day.dateKey)}</p>
              )}
              <details class="articles-toggle">
                <summary>Show {day.items.length} {day.items.length === 1 ? 'article' : 'articles'}</summary>
                <div class="news-grid">
                  {day.items.map((item) => (
                    <article class={`news-card topic-${item.data.topic}`}>
                      <div class="card-top">
                        <span class="topic-badge">{topicLabel[item.data.topic]}</span>
                      </div>
                      <h4><a href={item.data.sourceUrl} target="_blank" rel="noopener">{item.data.title}</a></h4>
                      <p class="source">{item.data.sourceName}</p>
                      <p class="gist">{item.data.summary}</p>
                      <a class="read-link" href={item.data.sourceUrl} target="_blank" rel="noopener">Read the original →</a>
                    </article>
                  ))}
                </div>
              </details>
            </div>
          ))}
        </>
      );

      if (weekly) {
        const weekStartDate = new Date(`${block.weekStart}T00:00:00Z`);
        return (
          <section class="week-block">
            <details class="week-toggle">
              <summary>
                <div class="week-summary-head">
                  <h2>Week of {shortFmt(weekStartDate)} – {shortFmt(weekly.weekEnd!)}</h2>
                  <span class="week-count">{itemCount} {itemCount === 1 ? 'story' : 'stories'} · {dayCount} {dayCount === 1 ? 'day' : 'days'}</span>
                </div>
                <p class="digest-text weekly">{weekly.summary}</p>
              </summary>
              <div class="week-days">{DayList}</div>
            </details>
          </section>
        );
      }

      return <section class="week-block week-block-open">{DayList}</section>;
    })}
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-dark);
      margin: 0 0 0.75rem;
    }
    .news-hero {
      background: linear-gradient(rgba(18,60,49,0.85), rgba(18,60,49,0.93)), url('/images/backgrounds/open-sky.jpg');
      background-size: cover;
      background-position: center 70%;
      color: #fff;
      padding: 3.5rem 0 3rem;
    }
    .news-hero .eyebrow { color: var(--gold-light); }
    .news-hero h1 { color: #fff; margin: 0 0 1rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .news-sub { color: #cfe0d8; max-width: 44rem; font-size: 1.05rem; margin: 0; }

    .news-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 3rem 1.5rem 0; }

    .week-block { margin-bottom: 2rem; }
    .week-block:last-child { margin-bottom: 0; }

    /* Weekly (collapsed) card */
    .week-toggle {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }
    .week-toggle summary {
      cursor: pointer;
      list-style: none;
      padding: 1.25rem 1.5rem;
      background: var(--paper-alt);
    }
    .week-toggle summary::-webkit-details-marker { display: none; }
    .week-toggle summary::after {
      content: "Show week's daily breakdown ▾";
      display: inline-block;
      margin-top: 0.6rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent-dark);
    }
    .week-toggle[open] summary::after { content: "Hide daily breakdown ▴"; }
    .week-summary-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .week-summary-head h2 { margin: 0; font-size: 1.2rem; color: var(--accent-dark); }
    .week-count { font-size: 0.78rem; color: var(--muted); font-weight: 600; white-space: nowrap; }
    .digest-text.weekly { margin: 0.6rem 0 0; font-weight: 500; }
    .week-days { padding: 0.25rem 1.5rem 1.5rem; border-top: 1px solid var(--border); }
    .week-days .day-group:first-child { margin-top: 1.25rem; }

    /* Un-collapsed (current-week) day groups sit directly on the page */
    .week-block-open { display: flex; flex-direction: column; gap: 2rem; }

    .day-group { margin-bottom: 0; }
    .day-heading {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      border-bottom: 2px solid var(--border);
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
    }
    .day-heading h3 { margin: 0; font-size: 1.1rem; color: var(--accent-dark); }
    .day-count { font-size: 0.8rem; color: var(--muted); font-weight: 600; }
    .digest-text {
      background: var(--paper-alt);
      border-left: 3px solid var(--accent);
      padding: 0.9rem 1.25rem;
      font-size: 0.92rem;
      line-height: 1.6;
      color: var(--ink);
      margin: 0 0 1rem;
      border-radius: 0 6px 6px 0;
    }
    .week-days .digest-text { background: #fff; }

    .articles-toggle summary {
      cursor: pointer;
      list-style: none;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent-dark);
      padding: 0.3rem 0;
    }
    .articles-toggle summary::-webkit-details-marker { display: none; }
    .articles-toggle summary::before { content: "▸ "; }
    .articles-toggle[open] summary::before { content: "▾ "; }
    .articles-toggle .news-grid { margin-top: 1rem; }

    .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
      gap: 1.5rem;
    }
    .news-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.4rem 1.5rem 1.5rem;
      display: flex;
      flex-direction: column;
      box-shadow: 0 1px 3px rgba(20,25,20,0.05);
    }
    .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .topic-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.55rem;
      border-radius: 99px;
      color: #fff;
    }
    .topic-policy .topic-badge { background: var(--accent); }
    .topic-litigation .topic-badge { background: var(--rust); }
    .topic-science .topic-badge { background: var(--accent-dark); }
    .topic-industry .topic-badge { background: var(--gold); }
    .topic-other .topic-badge { background: var(--muted); }

    .news-card h4 { margin: 0 0 0.3rem; font-size: 1.05rem; line-height: 1.35; }
    .news-card h4 a { color: var(--ink); text-decoration: none; }
    .news-card h4 a:hover { color: var(--accent); }
    .source { margin: 0 0 0.75rem; font-size: 0.82rem; color: var(--muted); font-weight: 600; }
    .gist { font-size: 0.88rem; color: var(--ink); line-height: 1.55; margin: 0 0 1rem; flex-grow: 1; }
    .read-link { font-size: 0.85rem; font-weight: 600; text-decoration: none; margin-top: auto; }
  </style>
</Base>
