---
import Base from '../../layouts/Base.astro';
import NewsMonthBlock from '../../components/NewsMonthBlock.astro';
import { buildMonthBlocks, chunkMonthsByItemCount } from '../../lib/news-digest';

const monthBlocks = await buildMonthBlocks();

// Only the most recent 3 months (this month + the 2 before it) render on
// this page — everything older is paginated into /news/archive/<page>/
// (30 stories/page, never splitting a month) instead of being dumped into
// one giant collapsed-but-still-fully-rendered archive block on this same
// page, which is what made this page several hundred items heavy before.
const RECENT_MONTH_COUNT = 3;
const recentMonths = monthBlocks.slice(0, RECENT_MONTH_COUNT);
const olderMonths = monthBlocks.slice(RECENT_MONTH_COUNT);
const olderItemCount = olderMonths.reduce((n, m) => n + m.itemCount, 0);
const archivePageCount = chunkMonthsByItemCount(olderMonths, 30).length;
---
<Base title="Daily News" description="Current developments on tobacco harm reduction, vaping and nicotine pouch regulation relevant to India." wide={true}>
  <section class="breakout news-hero">
    <div class="breakout-inner">
      <p class="eyebrow">Updated as it happens</p>
      <h1>Daily News</h1>
      <p class="news-sub">
        Curated coverage of tobacco harm reduction, vaping and nicotine
        policy relevant to India — auto-gathered from a wide pool of Indian
        and international sources. Each day gets a short summary; open it up
        for the individual stories. Check back Monday for the week's
        roundup — once a full month has passed, its weeks fold into one
        monthly roundup too.
      </p>
    </div>
  </section>

  <div class="news-body">
    <div class="disclaimer">
      <strong>About this feed:</strong> every item's summary is AI-written,
      in AVI's own paraphrased words rather than copied article text, and
      none of this reflects AVI's own views or positions — for AVI's own
      analysis and statements, see our <a href="/press/">press</a> and <a href="/policy/">policy</a> pages.
      Items from an established outlet (major Indian and international
      news organisations, or established science/medical journals) publish
      automatically once they pass a set of automated filters; anything
      naming a specific vape/tobacco brand, from a trade outlet that itself
      carries product advertising, or from any other source gets an AVI
      team member's look before it goes live. Automated or reviewed, no
      item here is independently fact-checked the way AVI's own statements
      are.
    </div>

    {recentMonths.map((mblock) => <NewsMonthBlock mblock={mblock} />)}

    {olderMonths.length > 0 && (
      <a class="archive-link" href="/news/archive/1/">
        See earlier coverage — {olderMonths.length} more months, {olderItemCount} stories, across {archivePageCount} {archivePageCount === 1 ? 'page' : 'pages'} →
      </a>
    )}
  </div>

  <div class="news-related-wrap">
    <a href="/science/" class="related-card">
      <h3>Evidence library →</h3>
      <p>The published research behind AVI's position, beyond the day's news.</p>
    </a>
    <a href="/press/" class="related-card">
      <h3>Press coverage →</h3>
      <p>AVI's own statements and the coverage of its work specifically.</p>
    </a>
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--green-deep);
      margin: 0 0 0.75rem;
    }
    .news-hero {
      background: var(--green-deep);
      color: #fff;
      padding: 3.5rem 0 3rem;
    }
    .news-hero .eyebrow { color: var(--paper); }
    .news-hero h1 { color: #fff; margin: 0 0 1rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .news-sub { color: #cfe0d8; max-width: 46rem; font-size: 1.05rem; margin: 0; }

    .news-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 2.25rem 1.5rem 0; }

    .disclaimer {
      background: var(--paper-2);
      border: 1px solid var(--line);
      border-left: 4px solid var(--green);
      border-radius: 6px;
      padding: 1rem 1.25rem;
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--muted);
      margin-bottom: 2.5rem;
    }
    .disclaimer strong { color: var(--ink); }
    .disclaimer a { font-weight: 600; }

    .archive-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--green-deep);
      background: var(--paper-2);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.7rem 1.4rem;
      text-decoration: none;
      margin: 0.5rem 0 2rem;
    }
    .archive-link:hover { border-color: var(--green); color: var(--green-deep); }

    .news-related-wrap {
      max-width: var(--max-w-wide);
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      padding: 2.5rem 1.5rem 4rem;
      border-top: 1px solid var(--line);
      margin-top: 2rem;
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-2);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--green-deep); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
