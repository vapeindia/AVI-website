---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PullQuote from '../../components/PullQuote.astro';
import { getGitDates, formatDate } from '../../lib/git-dates';

// Moved from /india/nicotine-pouches/ (legal rework, 2026-10-02) — this is
// now the "legal status" leaf under the new /nicotine-pouches/ section
// (see that section's index and /nicotine-pouches/safety/). 301 in
// public/_redirects covers the old URL.
const pageDates = getGitDates('src/pages/nicotine-pouches/legal-status.astro');

const SHORT_ANSWER = "No law bans nicotine pouches by name, but there is no legal way to sell them. FSSAI does not allow nicotine in food products, and in August 2026 the Drugs Technical Advisory Board advised against approving any new nicotine formulation. In September 2026 the Health Ministry told states to act against sellers.";

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Are Nicotine Pouches Legal in India? (2026)',
  datePublished: pageDates.published,
  dateModified: pageDates.modified,
  author: { '@type': 'Organization', name: 'Association of Vapers India' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: 'Are nicotine pouches legal in India?',
    acceptedAnswer: { '@type': 'Answer', text: SHORT_ANSWER },
  }],
};
---
<Base
  title="Are Nicotine Pouches Legal in India? (2026)"
  rawTitle={true}
  description="No law bans nicotine pouches in India, but FSSAI's food rules and a DTAB drug-approval freeze together leave no legal way to sell them — and since September 2026, states are enforcing that."
  image="/og/india-law.png"
  wide={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <section class="breakout pouch-hero">
    <div class="breakout-inner">
      <p class="eyebrow">Updated {formatDate(pageDates.modified)}</p>
      <h1>Are nicotine pouches legal in India?</h1>
      <p class="pouch-hero-sub">No law bans them by name — but since September 2026, there's no legal way to sell one.</p>
    </div>
  </section>

  <div class="pouch-body">
    <p class="page-authority">
      By Association of Vapers India · Last reviewed {formatDate(pageDates.modified)}
      <span class="authority-note">· This is AVI's understanding of the regulatory position, not formal legal advice.</span>
    </p>
    <p class="short-answer">{SHORT_ANSWER}</p>

    <h2><Icon name="document" /> Why there's no legal route</h2>
    <div class="pouch-timeline">
      <div class="pouch-step">
        <Icon name="document" />
        <h3>No route as a food</h3>
        <p>Nicotine pouches contain no tobacco leaf, so COTPA — the law covering products like khaini and gutka — doesn't apply. That pushes them to the Food Safety and Standards Authority of India (FSSAI), whose <a href="https://cdsco.gov.in/opencms/resources/UploadCDSCOWeb/2018/UploadCommitteeFiles/Minutes%20of%2094TH%20DTAB%20dated%2027.08.2026.pdf" target="_blank" rel="noopener">Regulation 2.3.4</a> bars nicotine as an ingredient in any consumable food product.</p>
      </div>
      <div class="pouch-step">
        <Icon name="scale" />
        <h3>No route as a drug — 27 August 2026</h3>
        <p>The other legal home for a purified-nicotine product is as a drug: the Indian Pharmacopoeia lists nicotine as an Active Pharmaceutical Ingredient, so CDSCO treats a new nicotine product as a "new drug" needing clinical trials and therapeutic approval. The Drugs Technical Advisory Board (DTAB) <a href="https://cdsco.gov.in/opencms/resources/UploadCDSCOWeb/2018/UploadCommitteeFiles/Minutes%20of%2094TH%20DTAB%20dated%2027.08.2026.pdf" target="_blank" rel="noopener">recommended against approving</a> any new nicotine formulations — closing that door too.</p>
      </div>
      <div class="pouch-step">
        <Icon name="shield" />
        <h3>Enforcement follows — 19 September 2026</h3>
        <p>The Union Health Ministry directed states to act against nicotine-pouch sales, <a href="https://retail.economictimes.indiatimes.com/amp/news/food-entertainment/personal-care-pet-supplies-liquor/india-orders-crackdown-on-nicotine-pouches-citing-health-risks-letter-shows/134496424" target="_blank" rel="noopener">reported by ET Retail</a> days later, citing a letter to states. No Act of Parliament changed — the freeze above is what the enforcement rests on.</p>
      </div>
    </div>

    <p class="split-note">
      This is a regulatory freeze built from two agencies' rules, not a law
      Parliament debated and passed — the same kind of overreach courts
      rejected for e-cigarettes in 2019, when a consumer product was forced
      into "drug" classification despite no manufacturer making a
      therapeutic claim for it. No nicotine pouch is sold in India as a
      cessation aid; they're marketed as consumer products, the same as
      abroad.
    </p>

    <h2><Icon name="chart" /> The evidence, set against what stays legal</h2>
    <PullQuote
      quote="Using [nicotine pouches] instead of cigarettes puts you at a lower risk of mouth cancer, heart disease, lung cancer, stroke, emphysema, and chronic bronchitis."
      attribution="US FDA, modified-risk marketing order, June 2026"
    />
    <div class="pouch-compare">
      <div class="pouch-col pouch-fda">
        <p class="split-label">FDA-reviewed, June 2026</p>
        <p>The claim above is the first reduced-risk marketing claim the FDA has ever authorised for a nicotine pouch, after its own scientific review.</p>
      </div>
      <div class="pouch-col pouch-slt">
        <p class="split-label">Meanwhile in India</p>
        <p>Loose smokeless tobacco — gutka, khaini — stays legal and openly sold at every paan shop, and is linked to <strong>350,000+</strong> deaths a year, per a peer-reviewed mortality study. A lower-risk pouch stays off the market entirely, while the far more dangerous product doesn't. <a href="/india/smokeless-tobacco/">The full harm reduction case →</a></p>
      </div>
    </div>

    <div class="pouch-related">
      <a href="/nicotine-pouches/" class="related-card">
        <h3>Nicotine pouches in India →</h3>
        <p>The section hub: legal status, safety, and what AVI wants to see change.</p>
      </a>
      <a href="/nicotine-pouches/safety/" class="related-card">
        <h3>Are they safer than smoking or gutka? →</h3>
        <p>What the FDA's own review found, and what isn't known yet.</p>
      </a>
    </div>
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--paper);
      margin: 0 0 0.75rem;
    }
    .pouch-hero {
      background: var(--green-deep);
      padding: 3.25rem 0 2.75rem;
    }
    .pouch-hero h1 { color: #fff; margin: 0 0 0.85rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .pouch-hero-sub { color: var(--paper-2); font-size: 1.05rem; max-width: 38rem; margin: 0; }

    .pouch-body { max-width: var(--max-w); margin: 0 auto; padding: 2.75rem 1.5rem 4rem; }
    .page-authority { font-size: 0.82rem; color: var(--muted); margin: 0 0 1.1rem; }
    .authority-note { display: block; margin-top: 0.2rem; font-style: italic; }
    @media (min-width: 640px) { .authority-note { display: inline; margin-top: 0; } }

    h2 {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.25rem;
      margin: 2.25rem 0 1rem;
    }
    h2:first-of-type { margin-top: 1.75rem; }
    h2 :global(svg) { width: 1.3rem; height: 1.3rem; color: var(--green); flex-shrink: 0; }

    .pouch-timeline { display: grid; gap: 1.1rem; margin: 0 0 1.5rem; }
    .pouch-step {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
    }
    .pouch-step :global(svg) { width: 1.4rem; height: 1.4rem; color: var(--green-deep); margin-bottom: 0.6rem; }
    .pouch-step h3 { margin: 0 0 0.5rem; font-size: 1.02rem; }
    .pouch-step p { margin: 0; font-size: 0.92rem; line-height: 1.6; color: var(--ink); }

    .split-note {
      background: var(--paper-2);
      border-radius: 8px;
      padding: 0.9rem 1.1rem;
      font-size: 0.9rem;
      color: var(--muted);
      margin: 0 0 2rem;
    }

    .pouch-compare {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin: 1.5rem 0;
    }
    .pouch-col { border-radius: 12px; padding: 1.1rem 1.25rem 1.25rem; border: 1px solid var(--line); background: #fff; }
    .pouch-col p { font-size: 0.9rem; line-height: 1.6; margin: 0; color: var(--ink); }
    .pouch-col .split-label { margin-bottom: 0.6rem; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; }
    .pouch-fda .split-label { color: var(--green-deep); }
    .pouch-slt .split-label { color: var(--rust); }
    .pouch-slt strong { font-family: var(--font-serif); font-size: 1.3rem; color: var(--rust); }
    @media (max-width: 640px) {
      .pouch-compare { grid-template-columns: 1fr; }
    }

    .pouch-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      margin-top: 2.5rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--line);
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-2);
      border-radius: 12px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--green-deep); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
