---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const all = (await getCollection('press'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Media coverage: independent outlets writing about AVI, interviewing it, or
// running its byline — as distinct from AVI's own issued statements below.
const coverage = all.filter((item) => ['coverage', 'interview', 'op-ed'].includes(item.data.type));
// AVI's own public statements and quotes, mostly distributed via PR agencies.
const statements = all.filter((item) => ['press-release', 'quote'].includes(item.data.type));

async function withBody(items: typeof all) {
  return Promise.all(items.map(async (item) => ({ item, Content: (await render(item)).Content })));
}
const coverageWithBody = await withBody(coverage);
const statementsWithBody = await withBody(statements);
const featuredCoverage = coverageWithBody.slice(0, 4);
const restCoverage = coverageWithBody.slice(4);
const featuredStatements = statementsWithBody.slice(0, 4);
const restStatements = statementsWithBody.slice(4);

const typeLabel: Record<string, string> = {
  coverage: 'Coverage',
  interview: 'Interview',
  'op-ed': 'Op-ed',
  'press-release': 'Press release',
  quote: 'Quote',
};
---
<Base title="Press" description="Independent media coverage of AVI, and AVI's own public statements, letters and rebuttals — headline and gist, not just a list of links." wide={true}>
  <section class="breakout press-hero">
    <div class="breakout-inner">
      <p class="eyebrow">A decade in the press</p>
      <h1>Press &amp; media coverage</h1>
      <p class="press-sub">
        The scientific evidence now overwhelmingly favours tobacco harm
        reduction as public health policy — see our <a href="/science">evidence library</a>. For over a decade, AVI has
        been instrumental in furthering that debate in India: quoted,
        interviewed and bylined in outlets from Deccan Chronicle and Outlook
        India to trade press like 2Firsts and Filter. Below is that
        independent coverage, alongside AVI's own public statements, letters
        and rebuttals — headline and gist first, so you don't have to open
        every link to know what it says. We're always available to provide
        further insight for a story, including where it means balancing
        views on the other side of this debate.
      </p>
      <div class="press-contact">
        <div>
          <span class="contact-label">Press queries</span>
          <a href="mailto:contact@vapeindia.org">contact@vapeindia.org</a>
        </div>
        <div>
          <span class="contact-label">For faster response — WhatsApp AVI's Director</span>
          <a href="https://wa.me/919920076599" target="_blank" rel="noopener">Message on WhatsApp →</a>
        </div>
      </div>
    </div>
  </section>

  <div class="press-body">
    <section class="press-section">
      <div class="section-head">
        <h2>Media coverage</h2>
        <p>Independent reporting, interviews and bylined op-eds — not written or issued by AVI.</p>
      </div>
      <div class="press-grid">
        {featuredCoverage.map(({ item, Content }) => (
          <article class={`press-card type-${item.data.type}`}>
            <div class="card-top">
              <span class="type-badge">{typeLabel[item.data.type]}</span>
              <time datetime={item.data.date.toISOString()}>
                {item.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <h3>{item.data.title}</h3>
            <p class="outlet">{item.data.outlet}</p>
            <div class="gist"><Content /></div>
            {(item.data.url || item.data.archivePdf)
              ? <a class="read-link" href={item.data.url || item.data.archivePdf} target="_blank" rel="noopener">Read the original →</a>
              : <span class="pending-link">Source: AVI press archive (not yet linked online)</span>}
          </article>
        ))}
      </div>
      {restCoverage.length > 0 && (
        <details class="press-archive">
          <summary>Show {restCoverage.length} more</summary>
          <div class="press-grid archive-grid">
          {restCoverage.map(({ item, Content }) => (
            <article class={`press-card type-${item.data.type}`}>
              <div class="card-top">
                <span class="type-badge">{typeLabel[item.data.type]}</span>
                <time datetime={item.data.date.toISOString()}>
                  {item.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3>{item.data.title}</h3>
              <p class="outlet">{item.data.outlet}</p>
              <div class="gist"><Content /></div>
              {(item.data.url || item.data.archivePdf)
                ? <a class="read-link" href={item.data.url || item.data.archivePdf} target="_blank" rel="noopener">Read the original →</a>
                : <span class="pending-link">Source: AVI press archive (not yet linked online)</span>}
            </article>
          ))}
          </div>
        </details>
      )}
    </section>

    <section class="press-section">
      <div class="section-head">
        <h2>Press releases &amp; statements</h2>
        <p>AVI's own public statements, quotes and rebuttals, mostly distributed via PR agencies.</p>
      </div>
      <div class="press-grid">
        {featuredStatements.map(({ item, Content }) => (
          <article class={`press-card type-${item.data.type}`}>
            <div class="card-top">
              <span class="type-badge">{typeLabel[item.data.type]}</span>
              <time datetime={item.data.date.toISOString()}>
                {item.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <h3>{item.data.title}</h3>
            <p class="outlet">{item.data.outlet}</p>
            <div class="gist"><Content /></div>
            {(item.data.url || item.data.archivePdf)
              ? <a class="read-link" href={item.data.url || item.data.archivePdf} target="_blank" rel="noopener">Read the original →</a>
              : <span class="pending-link">Source: AVI press archive (not yet linked online)</span>}
          </article>
        ))}
      </div>
      {restStatements.length > 0 && (
        <details class="press-archive">
          <summary>Show {restStatements.length} more</summary>
          <div class="press-grid archive-grid">
          {restStatements.map(({ item, Content }) => (
            <article class={`press-card type-${item.data.type}`}>
              <div class="card-top">
                <span class="type-badge">{typeLabel[item.data.type]}</span>
                <time datetime={item.data.date.toISOString()}>
                  {item.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3>{item.data.title}</h3>
              <p class="outlet">{item.data.outlet}</p>
              <div class="gist"><Content /></div>
              {(item.data.url || item.data.archivePdf)
                ? <a class="read-link" href={item.data.url || item.data.archivePdf} target="_blank" rel="noopener">Read the original →</a>
                : <span class="pending-link">Source: AVI press archive (not yet linked online)</span>}
            </article>
          ))}
          </div>
        </details>
      )}
    </section>

    <div class="press-related">
      <a href="/litigation" class="related-card">
        <h3>Litigation →</h3>
        <p>The court cases behind much of this coverage.</p>
      </a>
      <a href="/campaigns" class="related-card">
        <h3>Campaigns →</h3>
        <p>Protests, seminars and delegations — the public-facing half of this advocacy.</p>
      </a>
      <a href="/submissions" class="related-card">
        <h3>Submissions to policymakers →</h3>
        <p>Letters and formal responses AVI has sent directly to government.</p>
      </a>
      <a href="/science" class="related-card">
        <h3>Evidence library →</h3>
        <p>The research behind everything AVI has said on the record.</p>
      </a>
    </div>
  </div>

  <style>
    .eyebrow {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-dark);
      margin: 0 0 0.75rem;
    }
    .press-hero {
      background: linear-gradient(rgba(18,19,15,0.85), rgba(18,19,15,0.93)), url('/images/backgrounds/green-hills-india.jpg');
      background-size: cover;
      background-position: center;
      color: #f4f1e6;
      padding: 3.5rem 0 3rem;
    }
    .press-hero h1 { color: #fff; margin: 0 0 1rem; font-size: clamp(1.9rem, 3.6vw, 2.6rem); }
    .press-sub { color: #cdd6cf; max-width: 42rem; font-size: 1.05rem; margin: 0 0 1.75rem; }
    .press-sub a { color: var(--gold-light); }
    .press-contact {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid #333c34;
      max-width: 42rem;
    }
    .contact-label { display: block; font-size: 0.78rem; color: #9fada2; margin-bottom: 0.3rem; }
    .press-contact a { color: var(--gold-light); font-weight: 600; text-decoration: none; }

    .press-body { max-width: var(--max-w-wide); margin: 0 auto; padding: 3rem 1.5rem 0; }
    .press-section + .press-section { margin-top: 3.5rem; }
    .section-head { margin-bottom: 1.75rem; }
    .section-head h2 { margin: 0 0 0.35rem; font-size: 1.5rem; }
    .section-head p { margin: 0; color: var(--muted); font-size: 0.92rem; }

    .press-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
      gap: 1.5rem;
    }
    .press-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.4rem 1.5rem 1.5rem;
      display: flex;
      flex-direction: column;
      box-shadow: 0 1px 3px rgba(20,25,20,0.05);
    }
    .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .card-top time { font-size: 0.78rem; color: var(--muted); }
    .type-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.55rem;
      border-radius: 99px;
      color: #fff;
    }
    .type-coverage .type-badge { background: var(--accent); }
    .type-interview .type-badge { background: var(--gold); }
    .type-op-ed .type-badge { background: var(--rust); }
    .type-press-release .type-badge { background: var(--accent-dark); }
    .type-quote .type-badge { background: var(--muted); }

    .press-card h3 { margin: 0 0 0.3rem; font-size: 1.08rem; line-height: 1.35; }
    .outlet { margin: 0 0 0.75rem; font-size: 0.82rem; color: var(--muted); font-weight: 600; }
    .gist {
      font-size: 0.88rem;
      color: var(--ink);
      line-height: 1.55;
      margin-bottom: 1rem;
      flex-grow: 1;
      display: -webkit-box;
      -webkit-line-clamp: 5;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .gist :global(p) { margin: 0 0 0.6rem; }
    .gist :global(p:last-child) { margin-bottom: 0; }
    .gist :global(a) { color: inherit; text-decoration: underline; text-decoration-color: var(--border); }
    .read-link { font-size: 0.85rem; font-weight: 600; text-decoration: none; margin-top: auto; }
    .pending-link { font-size: 0.78rem; color: var(--muted); font-style: italic; margin-top: auto; }

    .press-archive { margin-top: 1.75rem; }
    .press-archive summary {
      cursor: pointer;
      list-style: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
      font-size: 0.92rem;
      color: var(--accent-dark);
      background: var(--paper-alt);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.6rem 1.25rem;
    }
    .press-archive summary::-webkit-details-marker { display: none; }
    .press-archive summary::after { content: '▾'; font-size: 0.75em; display: inline-block; transition: transform 0.15s ease; }
    .press-archive[open] summary::after { transform: rotate(180deg); }
    .press-archive summary:hover { border-color: var(--accent); }
    .archive-grid { margin-top: 1.5rem; }

    .press-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      margin-top: 1rem;
      padding: 2.5rem 0 4rem;
      border-top: 1px solid var(--border);
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-alt);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--accent-dark); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
