---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('research');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const description = item.data.brief.length > 155
  ? item.data.brief.slice(0, 155).replace(/\s+\S*$/, '') + '…'
  : item.data.brief;
---
<Base title={item.data.title} description={description}>
  <p><a href="/science">← Back to research library</a></p>
  <span class="study-pill">{item.data.studyType}</span>
  <h1>{item.data.title}</h1>
  <p class="byline"><strong>{item.data.authors}</strong> · {item.data.journal}, {item.data.year}</p>
  <div class="tags">
    {item.data.substance.map((s) => <span class="tag">{s}</span>)}
  </div>
  <p class="lead">{item.data.brief}</p>
  {item.data.relevanceToIndia && (
    <p class="india-note"><strong>Relevance to India:</strong> {item.data.relevanceToIndia}</p>
  )}
  <Content />
  <p class="links">
    {item.data.doi && <a href={`https://doi.org/${item.data.doi}`} target="_blank" rel="noopener">View via DOI</a>}
    {item.data.pubmedId && <a href={`https://pubmed.ncbi.nlm.nih.gov/${item.data.pubmedId}`} target="_blank" rel="noopener"> · PubMed</a>}
  </p>

  <div class="study-related">
    <a href="/science" class="related-card">
      <h3>Evidence library →</h3>
      <p>The full published research behind AVI's position, browsable by topic.</p>
    </a>
    <a href="/quit" class="related-card">
      <h3>If you smoke →</h3>
      <p>What this evidence means in practice — the case for switching.</p>
    </a>
    <a href="/india/law" class="related-card">
      <h3>The law in India →</h3>
      <p>Where e-cigarettes, nicotine pouches and NRT actually stand today.</p>
    </a>
    <a href="/policy" class="related-card">
      <h3>For policymakers →</h3>
      <p>How this kind of evidence feeds the regulatory case for India.</p>
    </a>
  </div>

  <style>
    .study-pill {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.6rem;
      border-radius: 99px;
      color: #fff;
      background: var(--accent);
      margin-bottom: 0.75rem;
    }
    h1 { margin-top: 0.25rem; }
    .byline { color: var(--muted); margin-top: -0.5rem; }
    .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.75rem 0 1.25rem; }
    .tag {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--gold-dark);
      background: var(--paper-alt);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
    }
    .lead { font-size: 1.05rem; }
    .india-note {
      background: var(--paper-alt);
      border-left: 3px solid var(--gold);
      padding: 1rem 1.25rem;
    }
    .links { margin-top: 2rem; font-weight: 600; }

    .study-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-alt);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--accent-dark); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
