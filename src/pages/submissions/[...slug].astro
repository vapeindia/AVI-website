---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { getGitDates } from '../../lib/git-dates';

export async function getStaticPaths() {
  const items = await getCollection('submissions');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);

const typeLabel: Record<string, string> = {
  letter: 'Letter',
  rebuttal: 'Rebuttal',
  'call-to-action': 'Call to action',
};

const gitDates = getGitDates(`src/content/submissions/${item.id}.md`);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.data.title,
  datePublished: item.data.date.toISOString().slice(0, 10),
  dateModified: gitDates.modified,
  author: { '@type': 'Organization', name: 'Association of Vapers India' },
};
---
<Base title={item.data.title} description={item.data.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <p><a href="/submissions/">← All submissions</a></p>
  <span class={`type-pill type-${item.data.type}`}>{typeLabel[item.data.type]}</span>
  <h1>{item.data.title}</h1>
  <p class="meta">
    <time datetime={item.data.date.toISOString()}>
      {item.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
     · To: {item.data.recipient}
  </p>
  <p class="lead">{item.data.summary}</p>
  <div class="full-text">
    <Content />
  </div>
  {item.data.archivePdf && (
    <a class="pdf-link" href={item.data.archivePdf} target="_blank" rel="noopener">View the original filing (PDF) →</a>
  )}

  <div class="sub-related">
    <a href="/submissions/" class="related-card">
      <h3>All submissions →</h3>
      <p>Every formal letter, rebuttal and call to action AVI has sent to India's policymakers.</p>
    </a>
    <a href="/litigation/" class="related-card">
      <h3>Litigation →</h3>
      <p>Where the letters didn't work — court cases AVI has organised and directed.</p>
    </a>
  </div>

  <style>
    .type-pill {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.6rem;
      border-radius: 99px;
      color: #fff;
      background: var(--green);
      margin-bottom: 0.75rem;
    }
    .type-rebuttal { background: var(--rust); }
    .type-call-to-action { background: var(--green-deep); }
    h1 { margin-top: 0.25rem; }
    .meta { color: var(--muted); margin-top: -0.5rem; font-size: 0.9rem; }
    .lead { font-size: 1.05rem; }
    .full-text {
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
      font-size: 1rem;
      line-height: 1.7;
    }
    .full-text :global(p) { margin: 0 0 1rem; }
    .pdf-link { display: block; margin-top: 1.5rem; font-size: 0.9rem; font-weight: 600; color: var(--green-deep); }

    .sub-related {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 1.25rem;
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
    }
    .related-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-2);
      border-radius: 8px;
      padding: 1.25rem 1.4rem;
      transition: transform 0.15s ease;
    }
    .related-card:hover { transform: translateY(-2px); }
    .related-card h3 { margin: 0 0 0.4rem; font-size: 1rem; color: var(--green-deep); }
    .related-card p { margin: 0; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  </style>
</Base>
